        // Helper function for status badge in repayment history
        function getStatusBadgeText(status) {
            const statusMap = {
                'Draft': '<span class="badge bg-secondary">Draft</span>',
                'Submitted': '<span class="badge bg-info">Submitted</span>',
                'Under Appraisal': '<span class="badge bg-warning">Under Appraisal</span>',
                'Approved': '<span class="badge bg-primary">Approved</span>',
                'Endorsed': '<span class="badge bg-success">Endorsed</span>',
                'Disbursed': '<span class="badge bg-success">Disbursed</span>',
                'Closed': '<span class="badge bg-secondary">Closed</span>',
                'Defaulted': '<span class="badge bg-danger">Defaulted</span>',
                'Written Off': '<span class="badge bg-danger">Written Off</span>',
                'Rejected': '<span class="badge bg-danger">Rejected</span>'
            };
            return statusMap[status] || `<span class="badge bg-secondary">${status}</span>`;
        }

