        function clearSelectedMember() {
            selectedMemberData = null;
            isMemberSelected = false;

            $('#selectedMemberNo').val('');
            $('#selectedMemberCard').hide();
            $('#loanResults').hide();
            $('#loanResults').html('');
        }

        function clearSearch() {
            $('#searchInput').val('');
            $('#searchResults').hide();
            $('#searchResultsBody').empty();
            clearSelectedMember();
        }

        function formatCurrency(amount) {
            if (!amount || isNaN(amount)) return 'Ksh 0.00';
            return new Intl.NumberFormat('en-KE', { style: 'currency', currency: 'KES' }).format(amount);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }


        function showRepaymentHistory(loanNo) {
            const memberNo = $('#selectedMemberNo').val();
            if (!memberNo) {
                Swal.fire('Error', 'Please select a member first', 'error');
                return;
            }

            // Show loading
            Swal.fire({
                title: 'Loading Repayment History...',
                html: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>',
                showConfirmButton: false,
                allowOutsideClick: false
            });

            // Fetch repayment history
            fetch(`/api/Inquiry/loan/${encodeURIComponent(memberNo)}/${encodeURIComponent(loanNo)}/repayments`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    Swal.close();

                    if (data.success && data.data) {
                        // Show repayment history in a modal
                        showRepaymentHistoryModal(data.data);
                    } else {
                        Swal.fire('Info', data.message || 'No repayment history found for this loan', 'info');
                    }
                })
                .catch(error => {
                    Swal.close();
                    console.error('Error fetching repayment history:', error);
                    Swal.fire('Error', 'Failed to load repayment history: ' + error.message, 'error');
                });
        }

        function showRepaymentHistoryModal(data) {
            // Check if modal already exists, if so remove it
            const existingModal = document.getElementById('repaymentHistoryModal');
            if (existingModal) {
                existingModal.remove();
