@model SACCOBlockChainSystem.Models.DTOs.LoanRepaymentHistoryDTO

<div id="repaymentHistoryContainer">
    @if (Model != null)
    {
        <!-- Header with Company and Member Info -->
        <div class="repayment-header">
            <div class="text-center mb-4">
                <h2 class="company-name">@Model.CompanyName</h2>
                <p class="company-address">@Model.CompanyAddress</p>
                <p class="company-contact">@Model.CompanyPhone | @Model.CompanyEmail</p>
                <hr />
                <h4 class="report-title">LOAN REPAYMENT HISTORY</h4>
                <p class="text-muted">Generated on: @DateTime.Now.ToString("dd MMMM yyyy HH:mm:ss")</p>
            </div>

            <!-- Member Information -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-person"></i> Member Information</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless">
                                <tr><td width="40%"><strong>Member Number:</strong></td><td>@Model.MemberNo</td></tr>
                                <tr><td><strong>Full Name:</strong></td><td>@Model.MemberName</td></tr>
                                <tr><td><strong>ID Number:</strong></td><td>@Model.MemberIdNo</td></tr>
                                <tr><td><strong>Phone Number:</strong></td><td>@Model.MemberPhone</td></tr>
                                <tr><td><strong>Email:</strong></td><td>@Model.MemberEmail</td></tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-cash"></i> Loan Information</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless">
                                <tr><td width="40%"><strong>Loan Number:</strong></td><td>@Model.LoanNo</td></tr>
                                <tr><td><strong>Loan Type:</strong></td><td>@Model.LoanType</td></tr>
                                <tr><td><strong>Principal Amount:</strong></td><td class="text-end">@Model.PrincipalAmount.ToString("C")</td></tr>
                                <tr><td><strong>Interest Rate:</strong></td><td class="text-end">@Model.InterestRate%</td></tr>
                                <tr><td><strong>Repayment Period:</strong></td><td class="text-end">@Model.RepaymentPeriod months</td></tr>
                                <tr><td><strong>Application Date:</strong></td><td>@Model.ApplicationDate.ToString("dd MMM yyyy")</td></tr>
                                <tr><td><strong>Disbursement Date:</strong></td><td>@(Model.DisbursementDate?.ToString("dd MMM yyyy") ?? "Not Disbursed")</td></tr>
                                <tr><td><strong>Loan Status:</strong></td><td><span class="badge @(Model.LoanStatus == "Disbursed" ? "bg-success" : Model.LoanStatus == "Closed" ? "bg-secondary" : Model.LoanStatus == "Defaulted" ? "bg-danger" : "bg-warning")">@Model.LoanStatus</span></td></tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Statistics -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="small-box bg-info">
                        <div class="inner">
                            <h3>@Model.TotalAmountPaid.ToString("C")</h3>
                            <p>Total Amount Paid</p>
                        </div>
                        <div class="icon"><i class="bi bi-cash-stack"></i></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="small-box bg-success">
                        <div class="inner">
                            <h3>@Model.TotalPrincipalPaid.ToString("C")</h3>
                            <p>Principal Paid</p>
                        </div>
                        <div class="icon"><i class="bi bi-piggy-bank"></i></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="small-box bg-warning">
                        <div class="inner">
                            <h3>@Model.TotalInterestPaid.ToString("C")</h3>
                            <p>Interest Paid</p>
                        </div>
                        <div class="icon"><i class="bi bi-percent"></i></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="small-box @(Model.IsFullyPaid ? "bg-success" : "bg-danger")">
                        <div class="inner">
                            <h3>@Model.TotalOutstanding.ToString("C")</h3>
                            <p>Outstanding Balance</p>
                        </div>
                        <div class="icon"><i class="bi bi-credit-card"></i></div>
                    </div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <h6>Repayment Progress</h6>
                            <div class="progress" style="height: 30px;">
                                <div class="progress-bar @(Model.PercentagePaid >= 100 ? "bg-success" : Model.PercentagePaid >= 75 ? "bg-info" : Model.PercentagePaid >= 50 ? "bg-warning" : "bg-danger")"
                                     role="progressbar"
                                     style="width: @(Math.Min(Model.PercentagePaid, 100))%;"
                                     aria-valuenow="@Model.PercentagePaid"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    @Model.PercentagePaid.ToString("F1")% Paid
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span>0%</span>
                                <span>@Model.OriginalTotalAmount.ToString("C") Total</span>
                                <span>100%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Repayment History Table -->
            <div class="card">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Repayment History (@Model.Repayments.Count payments)</h5>
                    <div>
                        <button type="button" class="btn btn-sm btn-info me-1" onclick="exportRepaymentHistoryPdf('@Model.LoanNo', '@Model.MemberNo')">
                            <i class="bi bi-file-pdf"></i> PDF
                        </button>
                        <button type="button" class="btn btn-sm btn-success me-1" onclick="exportRepaymentHistoryExcel('@Model.LoanNo', '@Model.MemberNo')">
                            <i class="bi bi-file-excel"></i> Excel
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="window.print()">
                            <i class="bi bi-printer"></i> Print
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover mb-0" id="repaymentHistoryTable">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Payment Date</th>
                                    <th>Receipt No</th>
                                    <th>Payment Method</th>
                                    <th class="text-end">Amount Paid</th>
                                    <th class="text-end">Principal</th>
                                    <th class="text-end">Interest</th>
                                    <th class="text-end">Penalty</th>
                                    <th class="text-end">Balance Before</th>
                                    <th class="text-end">Balance After</th>
                                    <th>Status</th>
                                    <th>Processed By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Repayments.Any())
                                {
                                    int counter = 1;
                                    foreach (var repayment in Model.Repayments.OrderByDescending(r => r.PaymentDate))
                                    {
                                        <tr>
                                            <td>@counter</td>
                                            <td>@repayment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                                            <td><strong>@repayment.ReceiptNo</strong></td>
                                            <td>
                                                <span class="badge @(repayment.PaymentMethod == "MPESA" ? "bg-success" : repayment.PaymentMethod == "CHEQUE" ? "bg-info" : repayment.PaymentMethod == "BANK_TRANSFER" ? "bg-primary" : "bg-secondary")">
                                                    @repayment.PaymentMethod
                                                </span>
                                            </td>
                                            <td class="text-end text-primary fw-bold">@repayment.AmountPaid.ToString("N2")</td>
                                            <td class="text-end">@repayment.PrincipalPaid.ToString("N2")</td>
                                            <td class="text-end">@repayment.InterestPaid.ToString("N2")</td>
                                            <td class="text-end text-danger">@repayment.PenaltyPaid.ToString("N2")</td>
                                            <td class="text-end">@repayment.BalanceBefore.ToString("N2")</td>
                                            <td class="text-end fw-bold">@repayment.BalanceAfter.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(repayment.Status == "Full Settlement" ? "bg-success" : repayment.Status == "Overdue" ? "bg-danger" : "bg-info")">
                                                    @repayment.Status
                                                    @if (repayment.DaysOverdue.HasValue && repayment.DaysOverdue > 0)
                                                    {
                                                        <span class="ms-1">(@repayment.DaysOverdue days)</span>
                                                    }
                                                </span>
                                            </td>
                                            <td>@(repayment.ProcessedBy ?? "N/A")</td>
                                        </tr>
                                        counter++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="12" class="text-center text-muted py-3">
                                            <i class="bi bi-info-circle"></i> No repayment history found for this loan
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-dark fw-bold">
                                <tr>
                                    <td colspan="4" class="text-end">TOTALS:</td>
                                    <td class="text-end">@Model.TotalAmountPaid.ToString("N2")</td>
                                    <td class="text-end">@Model.TotalPrincipalPaid.ToString("N2")</td>
                                    <td class="text-end">@Model.TotalInterestPaid.ToString("N2")</td>
                                    <td class="text-end">@Model.TotalPenaltyPaid.ToString("N2")</td>
                                    <td colspan="4"></td>
                                </tr>
                                <tr>
                                    <td colspan="8" class="text-end">OUTSTANDING BALANCE:</td>
                                    <td colspan="4" class="text-end text-danger">@Model.TotalOutstanding.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center text-muted mt-3">
                <hr />
                <small>
                    Inquiry generated by: @Model.InquiredBy | @Model.InquiryTimestamp.ToString("dd MMM yyyy HH:mm:ss")
                </small>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No repayment history found for this loan.
        </div>
    }
</div>

<style>
    .small-box {
        border-radius: 0.25rem;
        box-shadow: 0 0 1px rgba(0,0,0,.125), 0 1px 3px rgba(0,0,0,.2);
        display: block;
        margin-bottom: 20px;
        position: relative;
    }

        .small-box .inner {
            padding: 10px;
        }

        .small-box h3 {
            font-size: 2rem;
            font-weight: bold;
            margin: 0 0 10px 0;
            white-space: nowrap;
            padding: 0;
        }

        .small-box .icon {
            color: rgba(0,0,0,0.15);
            position: absolute;
            right: 10px;
            top: 5px;
            z-index: 0;
            font-size: 4rem;
        }

            .small-box .icon i {
                font-size: 4rem;
            }

    .bg-info {
        background-color: #17a2b8 !important;
        color: white;
    }

    .bg-success {
        background-color: #28a745 !important;
        color: white;
    }

    .bg-warning {
        background-color: #ffc107 !important;
        color: #1f2d3d;
    }

    .bg-danger {
        background-color: #dc3545 !important;
        color: white;
    }

    .bg-dark {
        background-color: #343a40 !important;
        color: white;
    }

    .bg-secondary {
        background-color: #6c757d !important;
        color: white;
    }

    .bg-primary {
        background-color: #007bff !important;
        color: white;
    }

    .progress {
        height: 30px;
        border-radius: 15px;
    }

    .progress-bar {
        font-size: 14px;
        font-weight: bold;
        line-height: 30px;
    }

    .table-borderless td {
        padding: 0.3rem 0;
    }

    .table-borderless tr {
        border-bottom: 1px solid #f0f0f0;
    }

        .table-borderless tr:last-child {
            border-bottom: none;
        }

    @@media print {
        .btn, .card-tools, .no-print {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .small-box {
            box-shadow: none !important;
            border: 1px solid #ddd;
        }

        .table {
            font-size: 10px !important;
        }

            .table td, .table th {
                padding: 4px !important;
            }

        .badge {
            font-size: 8px !important;
        }

        .progress {
            height: 20px !important;
        }

        .progress-bar {
            font-size: 11px !important;
            line-height: 20px !important;
        }
    }
</style>

<script>
    function exportRepaymentHistoryPdf(loanNo, memberNo) {
        window.open(`/Inquiry/ExportRepaymentHistoryPdf?loanNo=${loanNo}&memberNo=${memberNo}`, '_blank');
    }

    function exportRepaymentHistoryExcel(loanNo, memberNo) {
        window.open(`/Inquiry/ExportRepaymentHistoryExcel?loanNo=${loanNo}&memberNo=${memberNo}`, '_blank');
    }
</script>