@model List<SACCOBlockChainSystem.ViewModels.TransactionVerificationViewModel>

@{
    ViewData["Title"] = "Search Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">
            <i class="fas fa-search text-primary"></i> Search Transactions
        </h1>
        <a href="@Url.Action("Index", "Verification")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Verify
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
            <p>No transactions found matching your search criteria.</p>
            <a href="@Url.Action("Index", "Verification")" class="btn btn-primary mt-2">
                <i class="fas fa-shield-alt"></i> Verify Another Transaction
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="fas fa-list"></i> Search Results
                    <span class="badge bg-secondary ms-2">@Model.Count transactions found</span>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Receipt No</th>
                                <th>Date</th>
                                <th>Member No</th>
                                <th>Member Name</th>
                                <th>Amount</th>
                                <th>Share Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ReceiptNo</strong>
                                        @if (!string.IsNullOrEmpty(item.BlockchainTxId))
                                        {
                                            <i class="fas fa-link text-success ms-1" title="On Blockchain"></i>
                                        }
                                    </td>
                                    <td>@item.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><strong>@item.MemberNo</strong></td>
                                    <td>@item.MemberName</td>
                                    <td class="text-success fw-bold">KES @item.Amount.ToString("N2")</td>
                                    <td>@item.ShareType</td>
                                    <td>
                                        @if (item.IsSignatureVerified)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Verified
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock"></i> Pending
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Transaction", "Verification", new { id = item.TransactionId })"
                                           class="btn btn-sm btn-primary">
                                            <i class="fas fa-shield-alt"></i> Verify
                                        </a>
                                        <a href="@Url.Action("MemberChain", "Verification", new { memberNo = item.MemberNo })"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-link"></i> Chain
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>