@model SACCOBlockChainSystem.ViewModels.TransactionVerificationViewModel

@{
    ViewData["Title"] = "Verify Transaction - " + Model.ReceiptNo;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-0">
                <i class="fas fa-shield-alt text-primary"></i> Transaction Verification
            </h1>
            <p class="text-muted">Cryptographically verify the authenticity and integrity of this transaction</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Verification")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to Search
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Transaction Details Card -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-receipt text-primary"></i> Transaction Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Transaction ID</label>
                            <p class="fw-bold mb-0">#@Model.TransactionId</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Receipt Number</label>
                            <p class="fw-bold mb-0">@Model.ReceiptNo</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Transaction Date</label>
                            <p class="mb-0">@Model.TransactionDate.ToString("dd MMM yyyy HH:mm:ss")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Amount</label>
                            <p class="fw-bold text-success mb-0">KES @Model.Amount.ToString("N2")</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Member Number</label>
                            <p class="mb-0">@Model.MemberNo</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Share Type</label>
                            <p class="mb-0">@Model.ShareType</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="text-muted small">Transaction Hash</label>
                            <div class="bg-light p-2 rounded font-monospace small">
                                @Model.TransactionHash
                                <button class="btn btn-sm btn-link p-0 ms-2" onclick="copyToClipboard('@Model.TransactionHash')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="text-muted small">Previous Transaction Hash</label>
                            <div class="bg-light p-2 rounded font-monospace small">
                                @if (!string.IsNullOrEmpty(Model.PreviousTransactionHash))
                                {
                                    <span>@Model.PreviousTransactionHash</span>
                                    <button class="btn btn-sm btn-link p-0 ms-2" onclick="copyToClipboard('@Model.PreviousTransactionHash')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">(Genesis Transaction - First transaction for this member)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="text-muted small">Transaction Sequence</label>
                            <p class="mb-0">#@(Model.TransactionSequence?.ToString() ?? "N/A")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Member & Wallet Info Card -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user-circle text-primary"></i> Member & Wallet Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="text-muted small">Member Name</label>
                            <p class="fw-bold mb-0">@Model.MemberName</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">ID Number</label>
                            <p class="mb-0">@(string.IsNullOrEmpty(Model.MemberIdNo) ? "N/A" : Model.MemberIdNo)</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Phone Number</label>
                            <p class="mb-0">@(string.IsNullOrEmpty(Model.MemberPhone) ? "N/A" : Model.MemberPhone)</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="text-muted small">Wallet Address</label>
                            <div class="bg-light p-2 rounded font-monospace small">
                                @Model.WalletAddress
                                <button class="btn btn-sm btn-link p-0 ms-2" onclick="copyToClipboard('@Model.WalletAddress')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="text-muted small">Public Key (Preview)</label>
                            <div class="bg-light p-2 rounded font-monospace small">
                                @Model.PublicKey
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Verification Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="fas fa-fingerprint text-primary"></i> Cryptographic Verification
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12 text-center mb-4">
                    <div id="verificationStatus" class="d-inline-block">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status" style="width: 60px; height: 60px;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 text-muted">Click "Run Verification" to check this transaction</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted mb-2">Digital Signature</h6>
                            <div id="signatureStatusIcon" class="mb-2">
                                <i class="fas fa-question-circle fa-3x text-secondary"></i>
                            </div>
                            <div id="signatureStatusText" class="fw-bold">Not Verified</div>
                            <div id="signatureMessage" class="small text-muted"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted mb-2">Chain Integrity</h6>
                            <div id="chainStatusIcon" class="mb-2">
                                <i class="fas fa-question-circle fa-3x text-secondary"></i>
                            </div>
                            <div id="chainStatusText" class="fw-bold">Not Verified</div>
                            <div id="chainMessage" class="small text-muted"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <button id="verifyBtn" class="btn btn-primary btn-lg px-5">
                    <i class="fas fa-shield-alt"></i> Run Cryptographic Verification
                </button>
                <button id="verifyFullChainBtn" class="btn btn-outline-info btn-lg px-4 ms-2">
                    <i class="fas fa-link"></i> Verify Full Member Chain
                </button>
            </div>
        </div>
    </div>

    <!-- Signature Details Card (Expandable) -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="fas fa-code text-primary"></i> Cryptographic Details
                <button class="btn btn-sm btn-link float-end" type="button" data-bs-toggle="collapse" data-bs-target="#cryptoDetails">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </h5>
        </div>
        <div id="cryptoDetails" class="collapse">
            <div class="card-body">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="text-muted small">Transaction Signature</label>
                        <div class="bg-dark text-white p-3 rounded font-monospace small" style="word-break: break-all;">
                            @Model.TransactionSignature
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small">Canonical Data (What was signed)</label>
                        <div id="canonicalData" class="bg-dark text-white p-3 rounded font-monospace small">
                            Loading...
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <hr />
                        <h6>How Verification Works</h6>
                        <ol class="small text-muted">
                            <li>The system reconstructs the original transaction data (canonical format)</li>
                            <li>The SHA-256 hash of this data is calculated</li>
                            <li>Using the member's public key, the signature is verified against this hash</li>
                            <li>If the signature matches, the transaction is authentic and unmodified</li>
                            <li>Chain integrity is verified by checking that this transaction links to the previous one</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
                let transactionId = @Model.TransactionId;
                let memberNo = '@Model.MemberNo';

                $(document).ready(function() {
                    $('#verifyBtn').click(verifyTransaction);
                    $('#verifyFullChainBtn').click(verifyFullChain);
                });

                async function verifyTransaction() {
                    // Show loading state
                    $('#verifyBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Verifying...');

                    try {
                        const response = await fetch('/Verification/VerifyTransaction', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            body: JSON.stringify({ transactionId: transactionId })
                        });

                        const data = await response.json();

                        if (data.success) {
                            updateVerificationDisplay(data);

                            if (data.isValid) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Transaction Verified! ✅',
                                    html: `<strong>Signature:</strong> Valid<br>
                                           <strong>Chain:</strong> ${data.chainValid ? 'Valid' : 'Broken'}<br>
                                           <strong>Message:</strong> ${data.message}`,
                                    timer: 3000,
                                    showConfirmButton: false
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Verification Failed! ❌',
                                    html: `<strong>Signature:</strong> ${data.signatureValid ? 'Valid' : 'Invalid'}<br>
                                           <strong>Chain:</strong> ${data.chainValid ? 'Valid' : 'Broken'}<br>
                                           <strong>Message:</strong> ${data.message}`,
                                    confirmButtonColor: '#dc3545'
                                });
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message
                            });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to verify transaction. Please try again.'
                        });
                    } finally {
                        $('#verifyBtn').prop('disabled', false).html('<i class="fas fa-shield-alt"></i> Run Cryptographic Verification');
                    }
                }

                function updateVerificationDisplay(data) {
                    // Update Signature Status
                    if (data.signatureValid) {
                        $('#signatureStatusIcon').html('<i class="fas fa-check-circle fa-3x text-success"></i>');
                        $('#signatureStatusText').html('<span class="text-success">✓ Signature Valid</span>');
                        $('#signatureMessage').html('The digital signature matches the transaction data');
                    } else {
                        $('#signatureStatusIcon').html('<i class="fas fa-times-circle fa-3x text-danger"></i>');
                        $('#signatureStatusText').html('<span class="text-danger">✗ Signature Invalid</span>');
                        $('#signatureMessage').html('The signature does not match the transaction data - possible tampering');
                    }

                    // Update Chain Status
                    if (data.chainValid) {
                        $('#chainStatusIcon').html('<i class="fas fa-link fa-3x text-success"></i>');
                        $('#chainStatusText').html('<span class="text-success">✓ Chain Valid</span>');
                        $('#chainMessage').html('This transaction correctly links to the previous transaction');
                    } else {
                        $('#chainStatusIcon').html('<i class="fas fa-unlink fa-3x text-danger"></i>');
                        $('#chainStatusText').html('<span class="text-danger">✗ Chain Broken</span>');
                        $('#chainMessage').html('The chain of custody is broken - possible tampering');
                    }

                    // Update overall verification status
                    if (data.isValid) {
                        $('#verificationStatus').html(`
                            <div class="text-center">
                                <i class="fas fa-check-circle text-success" style="font-size: 60px;"></i>
                                <h4 class="text-success mt-2">VERIFIED ✓</h4>
                                <p class="text-muted">This transaction is cryptographically verified</p>
                            </div>
                        `);
                    } else {
                        $('#verificationStatus').html(`
                            <div class="text-center">
                                <i class="fas fa-exclamation-triangle text-danger" style="font-size: 60px;"></i>
                                <h4 class="text-danger mt-2">VERIFICATION FAILED</h4>
                                <p class="text-muted">${data.message}</p>
                            </div>
                        `);
                    }
                }

                async function verifyFullChain() {
                    Swal.fire({
                        title: 'Verify Full Member Chain',
                        text: `This will verify all ${memberNo}'s transactions. This may take a moment.`,
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, verify all',
                        cancelButtonText: 'Cancel'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            $('#verifyFullChainBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Verifying chain...');

                            try {
                                const response = await fetch('/Verification/VerifyMemberChain', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                                    },
                                    body: JSON.stringify({ memberNo: memberNo })
                                });

                                const data = await response.json();

                                if (data.success) {
                                    let transactionList = '<div class="mt-3" style="max-height: 400px; overflow-y: auto;">';
                                    transactionList += '<table class="table table-sm">';
                                    transactionList += '<thead><tr><th>ID</th><th>Receipt</th><th>Amount</th><th>Status</th></tr></thead>';
                                    transactionList += '<tbody>';

                                    data.transactions.forEach(tx => {
                                        let statusClass = tx.statusColor === 'success' ? 'success' : (tx.statusColor === 'warning' ? 'warning' : 'danger');
                                        transactionList += `<tr>
                                            <td>#${tx.id}</td>
                                            <td>${tx.receiptNo}</td>
                                            <td>${formatCurrency(tx.amount)}</td>
                                            <td><span class="badge bg-${statusClass}">${tx.status}</span></td>
                                        </tr>`;
                                    });

                                    transactionList += '</tbody></table></div>';

                                    Swal.fire({
                                        icon: data.isValid ? 'success' : 'error',
                                        title: data.isValid ? 'Chain Verification Complete ✅' : 'Chain Verification Failed ❌',
                                        html: `
                                            <div class="text-start">
                                                <p><strong>Total Transactions:</strong> ${data.totalTransactions}</p>
                                                <p><strong>Valid Signatures:</strong> ${data.validSignatures}/${data.totalTransactions}</p>
                                                <p><strong>Message:</strong> ${data.message}</p>
                                                ${data.failedTransactionIds.length > 0 ? `<p class="text-danger"><strong>Failed Transactions:</strong> ${data.failedTransactionIds.join(', ')}</p>` : ''}
                                                ${transactionList}
                                            </div>
                                        `,
                                        width: '800px'
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: data.message
                                    });
                                }
                            } catch (error) {
                                console.error('Error:', error);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Failed to verify chain. Please try again.'
                                });
                            } finally {
                                $('#verifyFullChainBtn').prop('disabled', false).html('<i class="fas fa-link"></i> Verify Full Member Chain');
                            }
                        }
                    });
                }

                function formatCurrency(amount) {
                    return new Intl.NumberFormat('en-KE', { style: 'currency', currency: 'KES' }).format(amount);
                }

                function copyToClipboard(text) {
                    navigator.clipboard.writeText(text).then(() => {
                        Swal.fire({
                            icon: 'success',
                            title: 'Copied!',
                            text: 'Text copied to clipboard',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    });
                }

                // Load canonical data on page load
                $(document).ready(function() {
                    // Simulate loading canonical data (you can fetch from API if needed)
                    $('#canonicalData').html(`{
          "MemberNo": "@Model.MemberNo",
          "Amount": @Model.Amount,
          "TransactionDate": "@Model.TransactionDate.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")",
          "SharesCode": "@Model.ShareType",
          "ReceiptNo": "@Model.ReceiptNo",
          "TransactionNo": "TX-${@Model.TransactionId}",
          "CompanyCode": "@ViewBag.CompanyCode"
        }`);
                });
    </script>
}