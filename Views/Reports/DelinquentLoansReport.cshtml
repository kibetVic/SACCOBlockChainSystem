@model SACCOBlockChainSystem.Models.ViewModels.DelinquentLoansIndexViewModel
@{
    ViewData["Title"] = "Delinquent Loans Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Deliquent Loans Report</h4>
        </div>
        <div class="card-body">
            <!-- Filter Form -->
            <form method="post" class="mb-4">
                <div class="row align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-search me-1"></i>Generate Report
                            </button>
                            <button type="button" id="exportPdfBtn" class="btn btn-danger">
                                <i class="bi bi-file-pdf me-1"></i>Export to PDF
                            </button>
                            <button type="button" id="exportExcelBtn" class="btn btn-success">
                                <i class="bi bi-file-excel me-1"></i>Export to Excel
                            </button>
                        </div>
                    </div>
                </div>
            </form>

            @if (Model.HasData)
            {
                <!-- Report Header -->
                <div class="text-center mb-4">
                    <h4>@Model.CompanyName.ToUpper()</h4>
                    <h5>DELIQUENT LOANS REPORT</h5>
                    <p>Period: @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</p>
                    <p>Printed By: @Model.PrintedBy On: @Model.GeneratedOn.ToString("dd-MMM-yyyy HH:mm")</p>
                </div>

                <!-- Statistics Summary Cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-danger text-white">
                            <div class="card-body text-center">
                                <h5><i class="bi bi-people"></i> Total Defaulters</h5>
                                <h3>@Model.TotalDefaulters.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body text-center">
                                <h5><i class="bi bi-currency-dollar"></i> Expected Amount</h5>
                                <h3>@Model.TotalExpectedAmount.ToString("N2")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body text-center">
                                <h5><i class="bi bi-check-circle"></i> Collected Amount</h5>
                                <h3>@Model.TotalCollectedAmount.ToString("N2")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body text-center">
                                <h5><i class="bi bi-exclamation-octagon"></i> Defaulted Amount</h5>
                                <h3>@Model.TotalDefaultedAmount.ToString("N2")</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delinquent Loans Table -->
                <div class="table-responsive">
                    <table id="delinquentTable" class="table table-bordered table-striped table-hover">
                        <thead class="table-danger">
                            <tr>
                                <th>Sacco</th>
                                <th class="text-center">No of Defaulters</th>
                                <th class="text-end">Expected Amount</th>
                                <th class="text-end">Collected Amount</th>
                                <th class="text-end">Defaulted Amount</th>
                                <th class="text-end">Rate %</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DelinquentLoans)
                            {
                                <tr>
                                    <td><strong>@item.SaccoName</strong></td>
                                    <td class="text-center">@item.NoOfDefaulters</td>
                                    <td class="text-end">@item.ExpectedAmount.ToString("N2")</td>
                                    <td class="text-end">@item.CollectedAmount.ToString("N2")</td>
                                    <td class="text-end text-danger fw-bold">@item.DefaultedAmount.ToString("N2")</td>
                                    <td class="text-end">
                                        <span class="@(item.RatePercentage > 50 ? "text-danger fw-bold" : "")">
                                            @item.RatePercentage.ToString("N2")%
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info view-defaulters-btn" 
                                                data-sacco="@item.SaccoName"
                                                data-defaulters='@Json.Serialize(item.Defaulters)'>
                                            <i class="bi bi-eye"></i> View Defaulters
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <td class="text-end">TOTALS:</td>
                                <td class="text-center">@Model.TotalDefaulters</td>
                                <td class="text-end">@Model.TotalExpectedAmount.ToString("N2")</td>
                                <td class="text-end">@Model.TotalCollectedAmount.ToString("N2")</td>
                                <td class="text-end">@Model.TotalDefaultedAmount.ToString("N2")</td>
                                <td class="text-end">@Model.OverallRatePercentage.ToString("N2")%</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Note -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Note:</strong> A loan is considered deliquent when payments are overdue by more than 30 days.
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle me-2"></i>
                    @(ViewBag.Message ?? "No deliquent loans found for the selected date range. Please select a date range and click 'Generate Report'.")
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal for Viewing Defaulters -->
<div class="modal fade" id="defaultersModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="defaultersModalTitle">Defaulting Members</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="defaultersTable">
                        <thead class="table-dark">
                            <tr>
                                <th>MemberNo</th>
                                <th>Names</th>
                                <th>LoanNo</th>
                                <th>Loan Type</th>
                                <th class="text-center">Date Issued</th>
                                <th class="text-end">Loan Amount</th>
                                <th class="text-end">Outstanding Balance</th>
                                <th class="text-end">Expected</th>
                                <th class="text-end">Collected</th>
                                <th class="text-end">Defaulted</th>
                                <th class="text-center">Days Overdue</th>
                            </tr>
                        </thead>
                        <tbody id="defaultersTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        $(document).ready(function() {
            if ($('#delinquentTable').length && $('#delinquentTable tbody tr').length > 0) {
                $('#delinquentTable').DataTable({
                    pageLength: 25,
                    order: [[4, 'desc']],
                    language: {
                        search: "Search:",
                        lengthMenu: "Show _MENU_ entries per page",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries"
                    },
                    columnDefs: [
                        { targets: [1], className: 'text-center' },
                        { targets: [2, 3, 4, 5], className: 'text-end' },
                        { orderable: false, targets: 6 }
                    ]
                });
            }

            // View Defaulters Modal
            $('.view-defaulters-btn').click(function() {
                var saccoName = $(this).data('sacco');
                var defaulters = $(this).data('defaulters');
                
                $('#defaultersModalTitle').text('Defaulting Members - ' + saccoName);
                
                var tbody = $('#defaultersTableBody');
                tbody.empty();
                
                if (defaulters && defaulters.length > 0) {
                    for (var i = 0; i < defaulters.length; i++) {
                        var d = defaulters[i];
                        var row = '<tr>' +
                            '<td>' + (d.memberNo || '') + '</td>' +
                            '<td>' + (d.names || '') + '</td>' +
                            '<td>' + (d.loanNo || '') + '</td>' +
                            '<td>' + (d.loanType || '') + '</td>' +
                            '<td class="text-center">' + (d.dateIssued ? new Date(d.dateIssued).toLocaleDateString() : '') + '</td>' +
                            '<td class="text-end">' + formatNumber(d.loanAmount) + '</td>' +
                            '<td class="text-end">' + formatNumber(d.outstandingBalance) + '</td>' +
                            '<td class="text-end">' + formatNumber(d.expectedRepayment) + '</td>' +
                            '<td class="text-end">' + formatNumber(d.amountCollected) + '</td>' +
                            '<td class="text-end text-danger fw-bold">' + formatNumber(d.defaultedAmount) + '</td>' +
                            '<td class="text-center">' + (d.daysOverdue || 0) + ' days</td>' +
                            '</tr>';
                        tbody.append(row);
                    }
                } else {
                    tbody.append('<tr><td colspan="11" class="text-center">No defaulters found</td></tr>');
                }
                
                $('#defaultersModal').modal('show');
            });

            function formatNumber(num) {
                if (num === null || num === undefined) return '0.00';
                return parseFloat(num).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // Export to Excel
            $('#exportExcelBtn').click(function() {
                var startDate = $('input[name="startDate"]').val();
                var endDate = $('input[name="endDate"]').val();
                if (!startDate || !endDate) {
                    alert('Please select both start and end dates first');
                    return;
                }
                var form = $('<form>', {
                    'method': 'post',
                    'action': '@Url.Action("ExportDelinquentLoansToExcel", "LoanReport")'
                });
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': 'startDate',
                    'value': startDate
                }));
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': 'endDate',
                    'value': endDate
                }));
                form.appendTo('body').submit();
            });

            // Export to PDF
            $('#exportPdfBtn').click(function() {
                var startDate = $('input[name="startDate"]').val();
                var endDate = $('input[name="endDate"]').val();
                if (!startDate || !endDate) {
                    alert('Please select both start and end dates first');
                    return;
                }
                var form = $('<form>', {
                    'method': 'post',
                    'action': '@Url.Action("ExportDelinquentLoansToPdf", "LoanReport")'
                });
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': 'startDate',
                    'value': startDate
                }));
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': 'endDate',
                    'value': endDate
                }));
                form.appendTo('body').submit();
            });
        });
    </script>
}