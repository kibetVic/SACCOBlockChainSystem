        // Calculate age from date of birth
        function calculateAge() {
            const dob = $('#DateOfBirth').val();
            if (dob) {
                const birthDate = new Date(dob);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                $('#Age').val(age);
                validateAge();
            } else {
                $('#Age').val('');
            }
        }

        // Validate age based on Membership Type
        function validateAge() {
            const isCorporate = $('#MembershipType_Corporate').is(':checked');
            if (isCorporate) {
                $('#ageError').text('');
                return true;
            }

            const age = parseInt($('#Age').val());
            const ageErrorSpan = $('#ageError');

            if (isNaN(age) || age <= 0) {
                ageErrorSpan.text('');
                return true;
            }

            if (age < 18) {
                ageErrorSpan.text('Individual members must be 18 years or older.');
                return false;
            }

            ageErrorSpan.text('');
            return true;
        }

        // Validate registration date (cannot be future)
        function validateRegistrationDate() {
            const regDate = $('#RegistrationDate').val();
            const regDateError = $('#regDateError');

            if (regDate) {
                const selectedDate = new Date(regDate);
                const today = new Date();
                selectedDate.setHours(0, 0, 0, 0);
                today.setHours(0, 0, 0, 0);

                if (selectedDate > today) {
                    regDateError.text('Registration date cannot be in the future.');
                    return false;
                } else {
                    regDateError.text('');
                    return true;
                }
            }
            return true;
        }

        // Validate entire form
        function validateForm() {
            let isValid = true;

            // Clear previous errors
            $('.text-danger').text('');
            $('.input-validation-error').removeClass('input-validation-error');

            // Validate surname
            if (!$('#Surname').val().trim()) {
                $('#surnameError').text('Surname is required');
                $('#Surname').addClass('input-validation-error');
                isValid = false;
            }

            // Validate other names
            if (!$('#OtherNames').val().trim()) {
                $('#othernamesError').text('Other Names are required');
                $('#OtherNames').addClass('input-validation-error');
                isValid = false;
            }

            // Validate ID number
            if (!$('#IdNo').val().trim()) {
                $('#idNoError').text('ID Number is required');
                $('#IdNo').addClass('input-validation-error');
                isValid = false;
            }

            // Validate phone number
            const phone = $('#PhoneNo').val().trim();
            if (!phone) {
                $('#phoneError').text('Phone Number is required');
                $('#PhoneNo').addClass('input-validation-error');
                isValid = false;
            } else if (!/^[0-9]{10,12}$/.test(phone.replace(/\D/g, ''))) {
                $('#phoneError').text('Please enter a valid phone number (10-12 digits)');
                $('#PhoneNo').addClass('input-validation-error');
                isValid = false;
            }

            // Validate email format if provided
            const email = $('#Email').val().trim();
            if (email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                $('#emailError').text('Please enter a valid email address');
                $('#Email').addClass('input-validation-error');
                isValid = false;
            }

            // Validate registration date
            if (!validateRegistrationDate()) {
                isValid = false;
            }

            // Validate age based on membership type (only for Individual)
            if (!$('#MembershipType_Corporate').is(':checked')) {
                if (!validateAge()) {
                    isValid = false;
                }
            }

            return isValid;
        }

        // Save new member (CREATE)
        function saveMember() {
            if (!validateForm()) return;

            showLoading(true);

            // ============================================================
            // CRITICAL: Get the member number from DisplayMemberNo
            // ============================================================
            const memberNo = $('#DisplayMemberNo').val().trim();
            $('#MemberNo').val(memberNo); // Set the hidden field

            const formData = {
                MemberNo: memberNo || null,  // Use the value from the view
                IdNo: $('#IdNo').val(),
                Surname: $('#Surname').val(),
                OtherNames: $('#OtherNames').val(),
                PhoneNo: $('#PhoneNo').val(),
                LandLine: $('#LandLine').val(),
                Email: $('#Email').val(),
                Gender: $('#Gender').val(),
                DateOfBirth: $('#DateOfBirth').val() || null,
                Age: parseInt($('#Age').val()) || 0,
                MaritalStatus: $('#MaritalStatus').val(),
                Department: $('#Department').val(),
                Station: $('#Station').val(),
                PresentAddress: $('#PresentAddress').val(),
                Cigcode: $('#Cigcode').val(),
                MembershipType: $('input[name="MembershipType"]:checked').val(),
                RegistrationType: $('input[name="RegistrationType"]:checked').val(),
                Status: $('#Status').val(),
                RegistrationDate: $('#RegistrationDate').val(),
                InitialShares: parseFloat($('#InitialShares').val()) || 0,
                CompanyCode: $('#CompanyCode').val(),
                Photo: photoData || null,
                IdFrontImage: idFrontData || null,
                IdBackImage: idBackData || null
            };

            console.log('Saving member with MemberNo:', formData.MemberNo);

            $.ajax({
                url: '/MemberMvc/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    showLoading(false);
                    if (response.success) {
                        showNotification(response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showNotification(response.message, 'error');
                    }
                },
                error: function(xhr) {
                    showLoading(false);
                    let errorMsg = 'Error creating member';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showNotification(errorMsg, 'error');
                }
            });
        }

        // Using FormData for multipart/form-data
        function updateMember() {
            if (!validateForm()) return;

            let memberNumber = $('#MemberNo').val();
            if (!memberNumber || memberNumber.trim() === '') {
                showNotification('Member number is missing. Please re-select the member.', 'error');
                return;
            }

            showLoading(true);

            // Create FormData object for multipart/form-data submission
            var formData = new FormData();

            // Add all fields to FormData
            formData.append('MemberNo', memberNumber);
            formData.append('IdNo', $('#IdNo').val() || '');
            formData.append('RegistrationDate', $('#RegistrationDate').val() || new Date().toISOString().split('T')[0]);
            formData.append('Surname', $('#Surname').val() || '');
            formData.append('OtherNames', $('#OtherNames').val() || '');
            formData.append('PhoneNo', $('#PhoneNo').val() || '');
            formData.append('LandLine', $('#LandLine').val() || '');
            formData.append('Email', $('#Email').val() || '');
            formData.append('Gender', $('#Gender').val() || '');
            formData.append('DateOfBirth', $('#DateOfBirth').val() || '');
            formData.append('Age', parseInt($('#Age').val()) || 0);
            formData.append('MaritalStatus', $('#MaritalStatus').val() || '');
            formData.append('Department', $('#Department').val() || '');
            formData.append('Station', $('#Station').val() || '');
            formData.append('PresentAddress', $('#PresentAddress').val() || '');
            formData.append('Cigcode', $('#Cigcode').val() || '');
            formData.append('MembershipType', $('input[name="MembershipType"]:checked').val() || 'Individual');
            formData.append('RegistrationType', $('input[name="RegistrationType"]:checked').val() || 'Ordinary Member');
            formData.append('Status', $('#Status').val() || 'Active');
            formData.append('CompanyCode', $('#CompanyCode').val() || '');

            // Add images if they exist
            if (photoData) {
                formData.append('Photo', photoData);
            }
            if (idFrontData) {
                formData.append('IdFrontImage', idFrontData);
            }
            if (idBackData) {
                formData.append('IdBackImage', idBackData);
            }

            $.ajax({
                url: '/MemberMvc/Update',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    showLoading(false);
                    if (response.success) {
                        showNotification(response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showNotification(response.message, 'error');
                    }
                },
                error: function(xhr) {
                    showLoading(false);
                    let errorMsg = 'Error updating member';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showNotification(errorMsg, 'error');
                }
            });
        }

        function deleteMember(memberNo, memberName) {
            deleteMemberNo = memberNo;
            deleteMemberName = memberName;
            $('#deleteMemberName').text(memberName);
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        // Confirm delete
        function confirmDelete() {
            showLoading(true);

            $.ajax({
                url: `/MemberMvc/Delete/${deleteMemberNo}`,
                type: 'DELETE',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    showLoading(false);
                    $('#deleteModal').modal('hide');
                    if (response.success) {
                        showNotification(response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showNotification(response.message, 'error');
                    }
                },
                error: function(xhr) {
                    showLoading(false);
                    $('#deleteModal').modal('hide');
                    let errorMsg = 'Error deleting member';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showNotification(errorMsg, 'error');
                }
            });
        }

        // Clear all filters
        function clearAllFilters() {
            $('#memberSearchInput').val('');
            $('#statusFilter').val('all');
            resetTableToDefault();
            $('#memberSearchInput').focus();
        }

        // Show notification
        function showNotification(message, type) {
            const alertDiv = $(`
                <div class="alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed top-0 end-0 m-3"
                     style="z-index: 9999; min-width: 300px;" role="alert">
                    <i class="fas fa-${type === 'error' ? 'exclamation-triangle' : type === 'success' ? 'check-circle' : 'info'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `);
            $('body').append(alertDiv);
            setTimeout(() => alertDiv.fadeOut('slow', function() { $(this).remove(); }), 5000);
        }

        // Show/hide loading overlay
        function showLoading(show) {
            if (show) {
                $('#loadingOverlay').fadeIn(200);
            } else {
                $('#loadingOverlay').fadeOut(200);
            }
        }
    </script>
}