            }
        });
    }

    // Search functionality
    function performSearch() {
        const searchTerm = $('#memberSearchInput').val().toLowerCase().trim();
        const statusFilter = $('#statusFilter').val();
        let visibleCount = 0;
        let totalMembers = 0;

        $('#membersTableBody tr').each(function() {
            const row = $(this);
            if (row.attr('id') === 'noMembersRow') return;

            totalMembers++;

            const memberNo = row.find('td:eq(1)').text().toLowerCase();
            const name = row.find('td.member-name').text().toLowerCase();
            const idNo = row.find('td.member-idno').text().toLowerCase();
            const phone = row.find('td.member-phone').text().toLowerCase();
            const email = row.find('td.member-email').text().toLowerCase();
            const statusValue = row.data('status') || '';
            const statusText = row.find('td.member-status .status-badge').text().toLowerCase();

            let matchesSearch = true;
            if (searchTerm) {
                matchesSearch = memberNo.includes(searchTerm) ||
                               name.includes(searchTerm) ||
                               idNo.includes(searchTerm) ||
                               phone.includes(searchTerm) ||
                               email.includes(searchTerm);
            }

            let matchesStatus = true;
            if (statusFilter === 'active') {
                matchesStatus = statusValue === '1' || statusText === 'active';
            } else if (statusFilter === 'inactive') {
                matchesStatus = statusValue !== '1' && statusText !== 'active';
            }

            if (matchesSearch && matchesStatus) {
                row.show();
                visibleCount++;
            } else {
                row.hide();
            }
        });
    }

    // Sort members
    function sortMembers() {
        const sortBy = $('#sortBy').val();
        const tbody = $('#membersTableBody');
        const rows = tbody.find('tr:visible:not(#noMembersRow)').get();

        rows.sort(function(a, b) {
            let aVal, bVal;
            switch(sortBy) {
                case 'name':
                    aVal = $(a).find('td.member-name').text();
                    bVal = $(b).find('td.member-name').text();
                    break;
                case 'memberNo':
                    aVal = $(a).find('td:eq(1)').text();
                    bVal = $(b).find('td:eq(1)').text();
                    break;
                case 'date':
                    aVal = $(a).data('regdate') || '9999-12-31';
                    bVal = $(b).data('regdate') || '9999-12-31';
                    break;
                default:
                    aVal = $(a).find('td.member-name').text();
                    bVal = $(b).find('td.member-name').text();
            }
            return aVal.localeCompare(bVal);
        });

        $.each(rows, function(index, row) {
            tbody.append(row);
            $(row).find('.row-number').text(index + 1);
        });
    }

    // Clear all filters
    function clearAllFilters() {
        $('#memberSearchInput').val('');
        $('#statusFilter').val('all');
        $('#sortBy').val('name');
        performSearch();
        $('#memberSearchInput').focus();
    }

    // Show notification
    function showNotification(message, type) {
        const alertDiv = $(`
            <div class="alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed top-0 end-0 m-3"
                 style="z-index: 9999; min-width: 300px;" role="alert">
                <i class="fas fa-${type === 'error' ? 'exclamation-triangle' : type === 'success' ? 'check-circle' : 'info'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `);
        $('body').append(alertDiv);
        setTimeout(() => alertDiv.fadeOut('slow', function() { $(this).remove(); }), 5000);
    }

    // Show/hide loading overlay
    function showLoading(show) {
        if (show) {
            $('#loadingOverlay').fadeIn(200);
        } else {
            $('#loadingOverlay').fadeOut(200);
        }
    }
</script>
