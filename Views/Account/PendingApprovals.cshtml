@model List<SACCOBlockChainSystem.Models.ViewModels.PendingUserDTO>
@{
    ViewData["Title"] = "Pending User Approvals";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-warning text-white">
            <h4><i class="fas fa-user-clock"></i> Pending User Approvals</h4>
            <p class="mb-0">Users waiting for approval: @ViewBag.PendingCount</p>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email, phone..." />
                        <button class="btn btn-primary" onclick="searchUsers()">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <button class="btn btn-secondary" onclick="clearSearch()">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-success" onclick="bulkApprove()" id="bulkApproveBtn" style="display:none;">
                        <i class="fas fa-check-double"></i> Bulk Approve
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="approvalsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAll" onclick="toggleSelectAll()" />
                            </th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Department</th>
                            <th>Role</th>
                            <th>Company</th>
                            <th>Location</th>
                            <th>Requested On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr data-id="@user.UserId">
                                <td class="text-center">
                                    <input type="checkbox" class="userCheckbox" value="@user.UserId" />
                                </td>
                                <td>
                                    <strong>@user.UserName</strong><br />
                                    <small class="text-muted">@user.UserLoginId</small>
                                </td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.Phone</td>
                                <td>@(user.Department ?? "-")</td>
                                <td>
                                    <span class="badge bg-info">@user.UserGroup</span>
                                </td>
                                <td>
                                    <strong>@user.CompanyName</strong><br />
                                    <small class="text-muted">@user.CompanyCode</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.SubCounty))
                                    {
                                        <span>@user.SubCounty</span>
                                        if (!string.IsNullOrEmpty(user.Ward))
                                        {
                                            <br />
                                
                                            <small class="text-muted">@user.Ward</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@user.DateCreated.ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-success btn-sm" onclick="approveUser(@user.UserId, '@user.UserName')" title="Approve">
                                            <i class="fas fa-check"></i> Approve
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="rejectUser(@user.UserId, '@user.UserName')" title="Reject">
                                            <i class="fas fa-times"></i> Reject
                                        </button>
                                        <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-info btn-sm" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <h5>No pending approvals</h5>
                    <p class="text-muted">All user accounts have been processed.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Reject User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to reject <strong id="rejectUserName"></strong>?</p>
                <div class="mb-3">
                    <label class="form-label">Reason for rejection (optional)</label>
                    <textarea id="rejectReason" class="form-control" rows="3" placeholder="Enter reason..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmReject()">Reject User</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentUserId = null;
        let currentUserName = null;

        function toggleSelectAll() {
            const selectAll = $('#selectAll').is(':checked');
            $('.userCheckbox').prop('checked', selectAll);
            $('#bulkApproveBtn').toggle(selectAll && $('.userCheckbox:checked').length > 0);
        }

        $(document).on('change', '.userCheckbox', function() {
            const anyChecked = $('.userCheckbox:checked').length > 0;
            $('#bulkApproveBtn').toggle(anyChecked);
            $('#selectAll').prop('checked', $('.userCheckbox:checked').length === $('.userCheckbox').length);
        });

        function searchUsers() {
            const searchTerm = $('#searchInput').val().toLowerCase();
            $('#approvalsTable tbody tr').each(function() {
                const row = $(this);
                const text = row.text().toLowerCase();
                row.toggle(text.includes(searchTerm));
            });
        }

        function clearSearch() {
            $('#searchInput').val('');
            $('#approvalsTable tbody tr').show();
        }

        function approveUser(userId, userName) {
            Swal.fire({
                title: 'Approve User',
                text: `Are you sure you want to approve ${userName}?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, approve',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoading(true);
                    $.ajax({
                        url: '@Url.Action("ApproveUser", "Account")',
                        type: 'POST',
                        data: { userId: userId },
                        success: function(response) {
                            showLoading(false);
                            if (response.success) {
                                Swal.fire('Approved!', response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            showLoading(false);
                            Swal.fire('Error', 'An error occurred while approving the user.', 'error');
                        }
                    });
                }
            });
        }

        function rejectUser(userId, userName) {
            currentUserId = userId;
            currentUserName = userName;
            $('#rejectUserName').text(userName);
            $('#rejectReason').val('');
            $('#rejectModal').modal('show');
        }

        function confirmReject() {
            const reason = $('#rejectReason').val();
            showLoading(true);
            $.ajax({
                url: '@Url.Action("RejectUser", "Account")',
                type: 'POST',
                data: { userId: currentUserId, reason: reason },
                success: function(response) {
                    showLoading(false);
                    $('#rejectModal').modal('hide');
                    if (response.success) {
                        Swal.fire('Rejected!', response.message, 'info');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function() {
                    showLoading(false);
                    $('#rejectModal').modal('hide');
                    Swal.fire('Error', 'An error occurred while rejecting the user.', 'error');
                }
            });
        }

        function bulkApprove() {
            const selectedIds = [];
            $('.userCheckbox:checked').each(function() {
                selectedIds.push($(this).val());
            });

            if (selectedIds.length === 0) {
                Swal.fire('Warning', 'Please select at least one user to approve.', 'warning');
                return;
            }

            Swal.fire({
                title: 'Bulk Approve',
                text: `Are you sure you want to approve ${selectedIds.length} user(s)?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Yes, approve all',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoading(true);
                    $.ajax({
                        url: '@Url.Action("BulkApproveUsers", "Account")',
                        type: 'POST',
                        data: { userIds: selectedIds },
                        traditional: true,
                        success: function(response) {
                            showLoading(false);
                            if (response.success) {
                                Swal.fire('Approved!', response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            showLoading(false);
                            Swal.fire('Error', 'An error occurred during bulk approval.', 'error');
                        }
                    });
                }
            });
        }

        function showLoading(show) {
            if (show) {
                $('#loadingOverlay').fadeIn(200);
            } else {
                $('#loadingOverlay').fadeOut(200);
            }
        }
    </script>
}