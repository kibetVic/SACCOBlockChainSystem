@using System.Security.Claims
@model List<SACCOBlockChainSystem.Models.ViewModels.CountyLoansReportViewModel>
@{
    ViewData["Title"] = "All Counties - Loans Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasData = Model != null && Model.Any();
    var totalSaccos = Model?.Sum(m => m.TotalCompanies) ?? 0;
    var totalLoans = Model?.Sum(m => m.TotalLoans) ?? 0;
    var totalBalance = Model?.Sum(m => m.TotalLoanBalance) ?? 0;
    var avgPAR30 = Model != null && Model.Any() ? Model.Average(m => m.OverallPAR30) : 0;
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title">
            <i class="fas fa-hand-holding-usd me-2"></i>All Counties - Loans Report
        </h3>
    </div>

    <div class="card-body">
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body py-3 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Total Counties</h6>
                                <h3 class="mb-0">@(Model?.Count ?? 0)</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                                <i class="fas fa-map-marked-alt text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body py-3 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Total SACCOs</h6>
                                <h3 class="mb-0">@totalSaccos.ToString("N0")</h3>
                            </div>
                            <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                                <i class="fas fa-building text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body py-3 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Total Loans</h6>
                                <h3 class="mb-0">@totalLoans.ToString("N0")</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                                <i class="fas fa-file-invoice text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body py-3 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Total Balance</h6>
                                <h3 class="mb-0 text-primary">@totalBalance.ToString("N0")</h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                                <i class="fas fa-wallet text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (hasData)
        {
            <!-- Counties Table -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="fas fa-map-marked-alt me-2"></i>County Loan Portfolio Summary
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover mb-0" id="countiesTable">
                            <thead class="bg-light">
                                <tr>
                                    <th>#</th>
                                    <th>County</th>
                                    <th class="text-center">SACCOs</th>
                                    <th class="text-center">Loans</th>
                                    <th class="text-end">Balance</th>
                                    <th class="text-center">PAR > 30</th>
                                    <th class="text-center">PAR > 60</th>
                                    <th class="text-center">Avg Past Due</th>
                                    <th class="text-center">Health</th>
                                    <th class="text-center no-print">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 1;
                                }
                                @foreach (var county in Model.OrderByDescending(c => c.TotalLoanBalance))
                                {
                                    var healthClass = county.OverallPAR30 < 5 ? "bg-success" :
                                    county.OverallPAR30 < 10 ? "bg-warning" : "bg-danger";
                                    <tr>
                                        <td class="text-center">@counter</td>
                                        <td>
                                            <strong>@county.CountyName</strong>
                                        </td>
                                        <td class="text-center">@county.TotalCompanies.ToString("N0")</td>
                                        <td class="text-center">@county.TotalLoans.ToString("N0")</td>
                                        <td class="text-end">@county.TotalLoanBalance.ToString("N0")</td>
                                        <td class="text-center">
                                            <span class="badge @healthClass">
                                                @county.OverallPAR30.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(county.OverallPAR60 < 5 ? "bg-success" : county.OverallPAR60 < 10 ? "bg-warning" : "bg-danger")">
                                                @county.OverallPAR60.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @healthClass">
                                                @county.OverallAmountPastDueRate.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @healthClass">
                                                @(county.OverallPAR30 < 5 ? "Excellent" : county.OverallPAR30 < 10 ? "Good" : county.OverallPAR30 < 20 ? "Fair" : "At Risk")
                                            </span>
                                        </td>
                                        <td class="text-center no-print">
                                            <a asp-action="CountyLoansReport" asp-route-county="@county.CountyName" asp-route-asAtDate="@county.AsAtDate" class="btn btn-sm btn-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                    counter++;
                                }
                            </tbody>
                            <tfoot class="bg-light fw-bold">
                                <tr>
                                    <td colspan="2" class="text-end">TOTALS</td>
                                    <td class="text-center">@totalSaccos.ToString("N0")</td>
                                    <td class="text-center">@totalLoans.ToString("N0")</td>
                                    <td class="text-end">@totalBalance.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @(avgPAR30 < 5 ? "bg-success" : avgPAR30 < 10 ? "bg-warning" : "bg-danger")">
                                            @avgPAR30.ToString("F1")%
                                        </span>
                                    </td>
                                    <td class="text-center">-</td>
                                    <td class="text-center">-</td>
                                    <td class="text-center">-</td>
                                    <td class="text-center no-print">-</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center py-5">
                <i class="fas fa-hand-holding-usd fa-3x mb-3"></i>
                <h5>No Data Available</h5>
                <p>No loan data found for any county.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (hasData)
            {
                    <text>
                    const countiesTable = document.getElementById('countiesTable');
                    if (countiesTable && typeof $.fn !== 'undefined' && $.fn.DataTable) {
                        try {
                            $(countiesTable).DataTable({
                                pageLength: 25,
                                ordering: true,
                                responsive: true,
                                language: {
                                    search: "Search:",
                                    lengthMenu: "Show _MENU_ entries",
                                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                                }
                            });
                        } catch (error) {
                            console.error('DataTable initialization error:', error);
                        }
                    }
                    </text>
            }
        });
    </script>
}