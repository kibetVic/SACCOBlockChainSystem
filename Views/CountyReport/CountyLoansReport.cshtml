@using System.Security.Claims
@model SACCOBlockChainSystem.Models.ViewModels.CountyLoansReportViewModel
@{
    ViewData["Title"] = $"County Loans Report - {Model?.CountyName ?? "County Report"}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasData = Model != null && Model.SaccoSummaries != null && Model.SaccoSummaries.Any();
    var asAtDate = Model?.AsAtDate ?? DateTime.Now;
    var countyName = Model?.CountyName ?? ViewBag.CountyName ?? "";
}

<style media="print">
    .app-sidebar, .app-header, .main-footer, .sidebar-wrapper, .navbar,
    .breadcrumb, .footer, [data-lte-toggle="sidebar"], .brand-link,
    .sidebar-footer, .no-print {
        display: none !important;
    }

    .app-main, .app-content, .content-wrapper, .main-content {
        margin-left: 0 !important;
        padding: 20px !important;
        width: 100% !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    .card-header {
        background-color: #1a73e8 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .table {
        width: 100% !important;
        border-collapse: collapse !important;
    }

        .table th {
            background-color: #f2f2f2 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

    .btn, .export-buttons, #exportExcelBtn, #exportPdfBtn {
        display: none !important;
    }

    body {
        background: white !important;
        font-size: 11pt;
    }

    .bg-primary {
        background-color: #1a73e8 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .bg-success {
        background-color: #28a745 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .bg-danger {
        background-color: #dc3545 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .bg-warning {
        background-color: #ffc107 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
</style>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title">
            <i class="fas fa-hand-holding-usd me-2"></i>County Loans Report
        </h3>
        <div class="card-tools no-print">
            <span class="badge badge-light">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
        </div>
    </div>

    <div class="card-body">
        <!-- Filter Section - REMOVED COUNTY DROPDOWN -->
        <div class="row mb-4 no-print">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>
                            Report Date
                            @if (!string.IsNullOrEmpty(countyName))
                            {
                                <span class="ms-3 text-muted">
                                    <i class="fas fa-map-marker-alt me-1"></i>
                                    County: <strong>@countyName</strong>
                                </span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="CountyLoansReport" method="post" id="reportForm">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-bold">As At Date</label>
                                        <input type="date" name="asAtDate" id="asAtDate"
                                               class="form-control"
                                               value="@asAtDate.ToString("yyyy-MM-dd")"
                                               required />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-bold">&nbsp;</label>
                                        <div>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fas fa-search me-1"></i>Generate Report
                                            </button>
                                            @if (hasData)
                                            {
                                                <button type="button" class="btn btn-success" id="exportExcelBtn">
                                                    <i class="fas fa-file-excel me-1"></i>Excel
                                                </button>
                                                <button type="button" class="btn btn-danger" id="exportPdfBtn">
                                                    <i class="fas fa-file-pdf me-1"></i>PDF
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <!-- Export Forms -->
                        <form asp-action="ExportCountyLoansToExcel" method="post" id="excelForm" style="display:none;">
                            <input type="hidden" name="asAtDate" id="excelAsAtDate" />
                        </form>
                        <form asp-action="ExportCountyLoansToPdf" method="post" id="pdfForm" style="display:none;">
                            <input type="hidden" name="asAtDate" id="pdfAsAtDate" />
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (hasData)
        {
            <!-- Report Header -->
            <div class="text-center mb-4">
                <h2 class="display-6 fw-bold">@Model.CountyName.ToUpper() COUNTY</h2>
                <h4 class="text-muted">LOANS PORTFOLIO REPORT</h4>
                <h5 class="text-muted">As At @asAtDate.ToString("dd/MM/yyyy")</h5>
                <hr class="my-3" />
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">Total SACCOs</h6>
                            <h3 class="mb-0">@Model.TotalCompanies</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">Total Loans</h6>
                            <h3 class="mb-0">@Model.TotalLoans.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">Total Balance</h6>
                            <h3 class="mb-0 text-primary">@Model.TotalLoanBalance.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">PAR > 30</h6>
                            <h3 class="mb-0 @(Model.OverallPAR30 < 5 ? "text-success" : Model.OverallPAR30 < 10 ? "text-warning" : "text-danger")">
                                @Model.OverallPAR30.ToString("F1")%
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Second Row of Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">PAR > 60</h6>
                            <h3 class="mb-0 @(Model.OverallPAR60 < 5 ? "text-success" : Model.OverallPAR60 < 10 ? "text-warning" : "text-danger")">
                                @Model.OverallPAR60.ToString("F1")%
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">PAR > 90</h6>
                            <h3 class="mb-0 @(Model.OverallPAR90 < 5 ? "text-success" : Model.OverallPAR90 < 10 ? "text-warning" : "text-danger")">
                                @Model.OverallPAR90.ToString("F1")%
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">Total Loans Paid</h6>
                            <h3 class="mb-0 text-success">@Model.TotalLoansPaid.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body py-3 px-4">
                            <h6 class="text-muted mb-1">Amount Past Due</h6>
                            <h3 class="mb-0 text-danger">@Model.OverallAmountPastDueRate.ToString("F1")%</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SACCO Loans Table -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="fas fa-building me-2"></i>SACCO Loan Portfolio Summary
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover mb-0" id="loansTable">
                            <thead class="bg-light">
                                <tr>
                                    <th>#</th>
                                    <th>SACCO Name</th>
                                    <th class="text-center">Loans</th>
                                    <th class="text-end">Loan Amount</th>
                                    <th class="text-end">Balance</th>
                                    <th class="text-end">Arrears >30</th>
                                    <th class="text-center">PAR > 30</th>
                                    <th class="text-center">PAR > 60</th>
                                    <th class="text-center">PAR > 90</th>
                                    <th class="text-center">Health</th>
                                    <th class="text-end">Loans Paid</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 1;
                                }
                                @foreach (var sacco in Model.SaccoSummaries)
                                {
                                    var rowClass = sacco.PAR30 < 5 ? "table-success" :
                                    sacco.PAR30 < 10 ? "table-warning" : "table-danger";
                                    <tr class="@rowClass">
                                        <td class="text-center">@counter</td>
                                        <td>
                                            <strong>@sacco.CompanyName</strong>
                                            <br />
                                            <small class="text-muted">@sacco.CompanyCode</small>
                                        </td>
                                        <td class="text-center">@sacco.NumberOfLoans.ToString("N0")</td>
                                        <td class="text-end">@sacco.TotalLoanAmount.ToString("N0")</td>
                                        <td class="text-end">@sacco.TotalLoanBalance.ToString("N0")</td>
                                        <td class="text-end text-danger">@sacco.TotalArrears30.ToString("N0")</td>
                                        <td class="text-center">
                                            <span class="badge @(sacco.PAR30 < 5 ? "bg-success" : sacco.PAR30 < 10 ? "bg-warning" : "bg-danger")">
                                                @sacco.PAR30.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(sacco.PAR60 < 5 ? "bg-success" : sacco.PAR60 < 10 ? "bg-warning" : "bg-danger")">
                                                @sacco.PAR60.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(sacco.PAR90 < 5 ? "bg-success" : sacco.PAR90 < 10 ? "bg-warning" : "bg-danger")">
                                                @sacco.PAR90.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(sacco.PortfolioHealth == "Excellent" ? "bg-success" :
                                                                                                                 sacco.PortfolioHealth == "Good" ? "bg-info" :
                                                                                                                 sacco.PortfolioHealth == "Fair" ? "bg-warning" : "bg-danger")">
                                        @sacco.PortfolioHealth
                                    </span>
                                </td>
                                <td class="text-end">@sacco.TotalLoansPaid.ToString("N0")</td>
                            </tr>
                                                        counter++;
                                }
                            </tbody>
                            <tfoot class="bg-light fw-bold">
                                <tr>
                                    <td colspan="2" class="text-end">TOTALS</td>
                                    <td class="text-center">@Model.TotalLoans.ToString("N0")</td>
                                    <td class="text-end">@Model.TotalLoanAmount.ToString("N0")</td>
                                    <td class="text-end">@Model.TotalLoanBalance.ToString("N0")</td>
                                    <td class="text-end text-danger">@Model.SaccoSummaries.Sum(s => s.TotalArrears30).ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @(Model.OverallPAR30 < 5 ? "bg-success" : Model.OverallPAR30 < 10 ? "bg-warning" : "bg-danger")">
                                            @Model.OverallPAR30.ToString("F1")%
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(Model.OverallPAR60 < 5 ? "bg-success" : Model.OverallPAR60 < 10 ? "bg-warning" : "bg-danger")">
                                            @Model.OverallPAR60.ToString("F1")%
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(Model.OverallPAR90 < 5 ? "bg-success" : Model.OverallPAR90 < 10 ? "bg-warning" : "bg-danger")">
                                            @Model.OverallPAR90.ToString("F1")%
                                        </span>
                                    </td>
                                    <td class="text-center">-</td>
                                    <td class="text-end">@Model.TotalLoansPaid.ToString("N0")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Portfolio Health Summary -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white py-3 border-0">
                            <h6 class="mb-0 fw-bold text-primary">
                                <i class="fas fa-chart-pie me-2"></i>Portfolio Health Summary
                            </h6>
                        </div>
                        <div class="card-body">
                            @{
                                var excellent = Model.SaccoSummaries.Count(s => s.PortfolioHealth == "Excellent");
                                var good = Model.SaccoSummaries.Count(s => s.PortfolioHealth == "Good");
                                var fair = Model.SaccoSummaries.Count(s => s.PortfolioHealth == "Fair");
                                var atRisk = Model.SaccoSummaries.Count(s => s.PortfolioHealth == "At Risk");
                                var total = Model.SaccoSummaries.Count;
                            }
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="text-center p-2 bg-light rounded">
                                        <h5 class="text-success">@excellent</h5>
                                        <small>Excellent</small>
                                        <div class="progress mt-1" style="height:5px;">
                                            <div class="progress-bar bg-success" style="width: @(total > 0 ? (excellent * 100m / total) : 0)%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center p-2 bg-light rounded">
                                        <h5 class="text-info">@good</h5>
                                        <small>Good</small>
                                        <div class="progress mt-1" style="height:5px;">
                                            <div class="progress-bar bg-info" style="width: @(total > 0 ? (good * 100m / total) : 0)%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center p-2 bg-light rounded">
                                        <h5 class="text-warning">@fair</h5>
                                        <small>Fair</small>
                                        <div class="progress mt-1" style="height:5px;">
                                            <div class="progress-bar bg-warning" style="width: @(total > 0 ? (fair * 100m / total) : 0)%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center p-2 bg-light rounded">
                                        <h5 class="text-danger">@atRisk</h5>
                                        <small>At Risk</small>
                                        <div class="progress mt-1" style="height:5px;">
                                            <div class="progress-bar bg-danger" style="width: @(total > 0 ? (atRisk * 100m / total) : 0)%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white py-3 border-0">
                            <h6 class="mb-0 fw-bold text-primary">
                                <i class="fas fa-info-circle me-2"></i>Report Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td width="40%"><strong>Report Generated:</strong></td>
                                    <td>@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                                <tr>
                                    <td><strong>As At Date:</strong></td>
                                    <td>@asAtDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <td><strong>County:</strong></td>
                                    <td>@Model.CountyName</td>
                                </tr>
                                <tr>
                                    <td><strong>Total SACCOs:</strong></td>
                                    <td>@Model.TotalCompanies</td>
                                </tr>
                                <tr>
                                    <td><strong>Generated By:</strong></td>
                                    <td>@User.Identity.Name</td>
                                </tr>
                                <tr>
                                    <td><strong>PAR > 30:</strong></td>
                                    <td class="@(Model.OverallPAR30 < 5 ? "text-success" : Model.OverallPAR30 < 10 ? "text-warning" : "text-danger") fw-bold">
                                        @Model.OverallPAR30.ToString("F1")%
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>PAR > 60:</strong></td>
                                    <td class="@(Model.OverallPAR60 < 5 ? "text-success" : Model.OverallPAR60 < 10 ? "text-warning" : "text-danger") fw-bold">
                                        @Model.OverallPAR60.ToString("F1")%
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>PAR > 90:</strong></td>
                                    <td class="@(Model.OverallPAR90 < 5 ? "text-success" : Model.OverallPAR90 < 10 ? "text-warning" : "text-danger") fw-bold">
                                        @Model.OverallPAR90.ToString("F1")%
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center py-5">
                <i class="fas fa-hand-holding-usd fa-3x mb-3"></i>
                <h5>No Loan Data Available</h5>
                <p>No loan data found for your county.</p>
                <p class="small text-muted">
                    County: <strong>@countyName</strong>
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            'use strict';

            const exportExcelBtn = document.getElementById('exportExcelBtn');
            const exportPdfBtn = document.getElementById('exportPdfBtn');
            const asAtDate = document.getElementById('asAtDate');

            // Export to Excel
            if (exportExcelBtn) {
                exportExcelBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const date = asAtDate.value;

                    if (!date) { alert('Please select a date'); return; }

                    document.getElementById('excelAsAtDate').value = date;
                    document.getElementById('excelForm').submit();
                });
            }

            // Export to PDF
            if (exportPdfBtn) {
                exportPdfBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const date = asAtDate.value;

                    if (!date) { alert('Please select a date'); return; }

                    document.getElementById('pdfAsAtDate').value = date;
                    document.getElementById('pdfForm').submit();
                });
            }

            // Initialize DataTable
            @if (hasData)
            {
                    <text>
                    const loansTable = document.getElementById('loansTable');
                    if (loansTable && typeof $.fn !== 'undefined' && $.fn.DataTable) {
                        try {
                            $(loansTable).DataTable({
                                pageLength: 25,
                                ordering: true,
                                responsive: true,
                                language: {
                                    search: "Search:",
                                    lengthMenu: "Show _MENU_ entries",
                                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                                }
                            });
                        } catch (error) {
                            console.error('DataTable initialization error:', error);
                        }
                    }
                    </text>
            }
        });
    </script>
}