@model SACCOBlockChainSystem.Models.DTOs.AssetsRegisterResponseDTO
@{
    ViewData["Title"] = $"Asset Details - {Model.AssetName}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
                <h2 class="page-title mb-0">
                    <i class="bi bi-box-seam me-2"></i>Asset Details
                </h2>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Asset Information -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Asset Information
                    </h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td width="35%"><strong>ID:</strong></td>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <td><strong>Asset Name:</strong></td>
                            <td><strong>@Model.AssetName</strong></td>
                        </tr>
                        <tr>
                            <td><strong>Asset Type:</strong></td>
                            <td>@Model.AssetType</td>
                        </tr>
                        <tr>
                            <td><strong>Class:</strong></td>
                            <td>@(Model.Class ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Tag Number:</strong></td>
                            <td>@(Model.TagNo ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Serial Number:</strong></td>
                            <td>@(Model.SerialNo ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Location:</strong></td>
                            <td>@(Model.Location ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Status:</strong></td>
                            <td>
                                @if (Model.Posted == true)
                                {
                                    <span class="badge bg-success">Posted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unposted</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Financial Information -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-cash-stack me-2"></i>Financial Information
                    </h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td width="35%"><strong>Quantity:</strong></td>
                            <td>@Model.Quantity</td>
                        </tr>
                        <tr>
                            <td><strong>Actual Value:</strong></td>
                            <td>KES @(Model.ActualValue?.ToString("N2") ?? "0.00")</td>
                        </tr>
                        <tr>
                            <td><strong>Market Value:</strong></td>
                            <td>KES @(Model.MarketValue?.ToString("N2") ?? "0.00")</td>
                        </tr>
                        <tr>
                            <td><strong>Total Value:</strong></td>
                            <td><strong class="text-success">KES @(Model.TotalValue?.ToString("N2") ?? "0.00")</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Date Information -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-calendar me-2"></i>Date Information
                    </h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td width="35%"><strong>Date Purchased:</strong></td>
                            <td>@(Model.DatePurchased?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Date of Manufacture:</strong></td>
                            <td>@(Model.DateOfManufacture?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Transaction Information -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-receipt me-2"></i>Transaction Information
                    </h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td width="35%"><strong>Transaction No:</strong></td>
                            <td>@(Model.TransactionNo ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Created By:</strong></td>
                            <td>@(Model.CreatedBy ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Created Date:</strong></td>
                            <td>@(Model.CreatedDate ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td><strong>Blockchain Verified:</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-link me-1"></i> Verified
                                    </span>
                                    <br />
                                    <small class="text-muted">@Model.BlockchainTxId</small>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not Verified</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Information -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-building me-2"></i>Company Information
                    </h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td width="15%"><strong>Company Code:</strong></td>
                            <td>@(Model.CompanyCode ?? "N/A")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i> Delete
        </a>
        @if (Model.Posted != true)
        {
            <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Post Asset
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Post button confirmation
        $('form:contains("Post Asset")').on('submit', function(e) {
            e.preventDefault();
            var form = this;

            Swal.fire({
                title: 'Confirm Post',
                text: 'Are you sure you want to post this asset? This action can be reversed by editing.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Post it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}