@model SACCOBlockChainSystem.Models.ViewModels.FinancialReportViewModel

<div class="card shadow-sm mt-4" style="border: none; border-radius: 10px;">
    <div class="card-header bg-white py-3" style="border-bottom: 2px solid #3f2b96;">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0" style="color: #3f2b96; font-weight: 600;">
                <i class="fas fa-balance-scale me-2"></i> TRIAL BALANCE
            </h5>
            <div>
                <span class="badge bg-info p-2 me-2">
                    <i class="fas fa-calendar me-1"></i> @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")
                </span>
                <span class="badge @(Model.IsBalanced ? "bg-success" : "bg-danger") p-2">
                    <i class="fas @(Model.IsBalanced ? "fa-check-circle" : "fa-exclamation-circle") me-1"></i>
                    @(Model.IsBalanced ? "Balanced" : "Unbalanced")
                </span>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="trialBalanceTable">
                <thead style="background-color: white; color: #3f2b96;">
                    <tr>
                        <th style="padding: 15px;">Account No</th>
                        <th style="padding: 15px;">Account Name</th>
                        <th style="padding: 15px;">Start Date</th>
                        <th style="padding: 15px; text-align: center;">End Date</th>
                        <th style="padding: 15px; text-align: right;">Debit</th>
                        <th style="padding: 15px; text-align: right;">Credit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TrialBalance.Any())
                    {
                        <tr>
                            <td colspan="6" style="padding: 30px; text-align: center; color: #6c757d;">
                                <i class="fas fa-info-circle me-2"></i>
                                No trial balance data available for the selected period.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.TrialBalance.OrderBy(x => x.AccountNo))
                        {
                            <tr class="@(item.IsSuspense ? "table-warning" : "")">
                                <td style="padding: 12px; font-weight: 500;">@item.AccountNo</td>
                                <td style="padding: 12px;">
                                    @item.AccountName
                                    @if (item.IsSuspense)
                                    {
                                        <span class="badge bg-warning ms-2">SUSPENSE</span>
                                    }
                                </td>
                                <td style="padding: 12px;">
                                    <i class="fas fa-calendar me-1"></i> @Model.StartDate.ToString("dd/MM/yyyy")
                                </td>
                                <td style="padding: 12px; text-align: center;">
                                    <i class="fas fa-calendar me-1"></i> @Model.EndDate.ToString("dd/MM/yyyy")
                                </td>
                                <td style="padding: 12px; text-align: right; color: #28a745; font-weight: 500;">
                                    @item.Debit.ToString("N2")
                                </td>
                                <td style="padding: 12px; text-align: right; color: #dc3545; font-weight: 500;">
                                    @item.Credit.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.TrialBalance.Any())
                {
                    <tfoot style="background-color: #f8f9fa; font-weight: 600; border-top: 2px solid #3f2b96;">
                        <tr>
                            <td colspan="4" style="padding: 15px; text-align: right; font-size: 15px;">Totals:</td>
                            <td style="padding: 15px; text-align: right; color: #28a745; font-size: 15px;">
                                @Model.TotalDebits.ToString("N2")
                            </td>
                            <td style="padding: 15px; text-align: right; color: #dc3545; font-size: 15px;">
                                @Model.TotalCredits.ToString("N2")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" style="padding: 10px; text-align: right; font-size: 13px;">Difference:</td>
                            <td colspan="2" style="padding: 10px; text-align: center; font-size: 13px; color: @(Model.IsBalanced ? "#28a745" : "#dc3545");">
                                @(Model.IsBalanced ? "✓ Balanced" : "✗ Unbalanced by " + (Model.TotalDebits - Model.TotalCredits).ToString("N2"))
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <div class="card-footer bg-white py-3">
        <div class="row align-items-center">
            <div class="col-md-6">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Total Accounts: @Model.TrialBalance.Count | Generated: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </small>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-success btn-sm me-2" onclick="exportToExcel('trialBalanceTable', 'Trial_Balance')">
                    <i class="fas fa-file-excel me-2"></i> Excel
                </button>
                <button class="btn btn-danger btn-sm" onclick="exportToPDF('trialBalanceTable', 'Trial Balance')">
                    <i class="fas fa-file-pdf me-2"></i> PDF
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

<script>
    function exportToExcel(tableId, fileName) {
        var table = document.getElementById(tableId);
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });
        XLSX.writeFile(wb, fileName + '_@Model.EndDate.ToString("yyyyMMdd")' + '.xlsx');
    }

    function exportToPDF(tableId, title) {
        const { jsPDF } = window.jspdf;
        var doc = new jsPDF('landscape', 'mm', 'a4');

        doc.setFontSize(16);
        doc.text(title, 14, 15);
        doc.setFontSize(10);
        doc.text('Period: @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")', 14, 22);
        doc.text('Generated: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")', 14, 28);

        doc.autoTable({
            html: '#' + tableId,
            startY: 35,
            theme: 'grid',
            styles: { fontSize: 8 },
            headStyles: { fillColor: [52, 58, 64], textColor: [255, 255, 255] },
            alternateRowStyles: { fillColor: [245, 245, 245] }
        });

        doc.save(title + '_@Model.EndDate.ToString("yyyyMMdd")' + '.pdf');
    }
</script>