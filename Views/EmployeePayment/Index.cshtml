﻿@* Views/EmployeePayment/Index.cshtml *@
@using SACCOBlockChainSystem.Models.DTOs
@model List<EmployeePaymentListDTO>

@{
    ViewData["Title"] = "Employee Payments";
    var summary = ViewBag.Summary as PaymentSummaryDTO;
    var companyName = ViewBag.CompanyName as string ?? "AMTECH SACCO";
}

<div class="container-fluid">

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Dynamic Summary Cards -->
    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>@(summary?.TotalPayments.ToString("N2") ?? "KES 0")</h3>
                    <p>Total Payments</p>
                </div>
                <div class="icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@(summary?.PaymentCount ?? 0)</h3>
                    <p>Number of Payments</p>
                </div>
                <div class="icon">
                    <i class="fas fa-receipt"></i>
                </div>
            </div>
        </div>

        @if (summary?.PaymentsByType != null)
        {
            var displayTypes = summary.PaymentsByType.Take(2);
            var colors = new[] { "warning", "danger", "primary", "secondary", "dark" };
            var colorIndex = 0;

            foreach (var paymentType in displayTypes)
            {
                <div class="col-lg-3 col-6">
                    <div class="small-box bg-@colors[colorIndex % colors.Length]">
                        <div class="inner">
                            <h3>@paymentType.Value.ToString("N2")</h3>
                            <p>@paymentType.Key Total</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                </div>
                colorIndex++;
            }
        }

        @if (summary?.PaymentsByType != null && summary.PaymentsByType.Count == 1)
        {
            <div class="col-lg-3 col-6">
                <div class="small-box bg-secondary">
                    <div class="inner">
                        <h3>KES 0</h3>
                        <p>Other Payments</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-ellipsis-h"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5><i class="fas fa-filter"></i> Filter Payments</h5>
        </div>
        <div class="card-body">
            <form method="get" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filter
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-sync-alt"></i> Reset
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- FORM -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h4><i class="fas fa-money-bill-wave"></i> Employee Payment</h4>
        </div>

        <div class="card-body">
            <form id="paymentForm">
                @Html.AntiForgeryToken()

                <div class="row">
                    <!-- LEFT SIDE - Form Fields -->
                    <div class="col-md-8">
                        <!-- EMPLOYEE SEARCH -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-12">
                                                <h6 class="card-title mb-3">Step 1: Search & Select Employee</h6>
                                            </div>
                                        </div>

                                        <!-- Search Input -->
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label class="fw-bold">Search Employee *</label>
                                                    <div class="input-group">
                                                        <input type="text" id="employeeSearchInput" class="form-control"
                                                               placeholder="Search by Name, ID Number, or Phone Number..." />
                                                        <button type="button" class="btn btn-primary" onclick="searchEmployees()">
                                                            <i class="fas fa-search"></i> Search
                                                        </button>
                                                        <button type="button" class="btn btn-secondary" onclick="clearEmployeeSearch()">
                                                            <i class="bi bi-x-lg"></i> Clear
                                                        </button>
                                                    </div>
                                                    <small class="text-muted">Enter at least 3 characters to search (auto-search enabled)</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Search Results -->
                                        <div id="employeeSearchResults" style="display: none;" class="mt-3">
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-hover search-results-table">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Select</th>
                                                            <th>Employee No</th>
                                                            <th>Full Name</th>
                                                            <th>ID Number</th>
                                                            <th>Phone Number</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="employeeSearchResultsBody"></tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- Loading Indicator -->
                                        <div id="employeeSearchLoading" style="display: none;" class="text-center p-3">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p>Searching for employees...</p>
                                        </div>

                                        <!-- Selected Employee Display -->
                                        <div id="selectedEmployeeCard" style="display: none;" class="mt-3">
                                            <div class="alert alert-success selected-employee-card">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        <strong>Selected Employee:</strong>
                                                        <span id="selectedEmployeeName"></span>
                                                        <br />
                                                        <small>
                                                            ID: <span id="selectedEmployeeIdNo"></span> |
                                                            Phone: <span id="selectedEmployeePhone"></span>
                                                        </small>
                                                    </div>
                                                    <div>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearSelectedEmployee()">
                                                            <i class="bi bi-arrow-left"></i> Change
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Hidden fields for employee data -->
                                        <input type="hidden" id="EmployeeId" name="EmployeeId" />
                                        <input type="hidden" id="EmployeeName" name="EmployeeName" />
                                        <input type="hidden" id="EmployeeIdNo" name="EmployeeIdNo" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PAYMENT TYPE, AMOUNT, ACCOUNTS -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Payment Type *</label>
                                <select id="PaymentTypeId" name="PaymentTypeId" class="form-control select2" required style="width: 100%;">
                                    <option value="">-- Select Payment Type --</option>
                                </select>
                                <small class="text-muted">Select type of payment</small>
                            </div>
                            <div class="col-md-6">
                                <label>Amount (KES) *</label>
                                <input type="number" step="0.01" id="Amount" name="Amount" class="form-control" required />
                                <small class="text-muted">Enter payment amount</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Expense Account *</label>
                                <div class="input-group">
                                    <select id="ExpenseAccountNo" name="ExpenseAccountNo" class="form-control" required>
                                        <option value="">-- Select Expense Account --</option>
                                    </select>
                                </div>
                                <small class="text-muted">GL Account for expense (Debit)</small>
                            </div>
                            <div class="col-md-6">
                                <label>Cash/Bank Account *</label>
                                <div class="input-group">
                                    <select id="CashAccountNo" name="CashAccountNo" class="form-control" required>
                                        <option value="">-- Select Cash/Bank Account --</option>
                                    </select>
                                </div>
                                <small class="text-muted">GL Account for payment (Credit)</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Payment Date</label>
                                <input type="date" id="PaymentDate" name="PaymentDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label>Payment Method</label>
                                <select id="PaymentMethod" name="PaymentMethod" class="form-control">
                                    <option value="">-- Select Method --</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Cheque">Cheque</option>
                                    <option value="M-Pesa">M-Pesa</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT SIDE - Employee Info Card -->
                    <div class="col-md-4">
                        <div class="card bg-light" id="employeeInfoCard" style="display:none;">
                            <div class="card-header bg-secondary text-white">
                                <h6 class="mb-0"><i class="fas fa-user"></i> Employee Information</h6>
                            </div>
                            <div class="card-body">
                                <div id="employeeInfoContent">
                                    <p class="mb-1"><strong>Name:</strong> <span id="infoName"></span></p>
                                    <p class="mb-1"><strong>ID No:</strong> <span id="infoIdNo"></span></p>
                                    <p class="mb-1"><strong>Phone:</strong> <span id="infoPhone"></span></p>
                                    <hr />
                                    <p class="mb-0"><strong>Total Paid to Date:</strong></p>
                                    <h5 class="text-success" id="infoTotalPaid">KES 0</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BUTTONS -->
                <div class="mt-4 d-flex gap-2">
                    <button type="button" class="btn btn-primary" id="btnProcessPayment">
                        <i class="fas fa-check-circle"></i> Process Payment
                    </button>
                    <button type="button" class="btn btn-secondary" id="btnClear">
                        <i class="fas fa-eraser"></i> Clear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- EXISTING PAYMENTS TABLE -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5><i class="fas fa-list"></i> Payment History</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="paymentsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Voucher No</th>
                            <th>Employee Name</th>
                            <th>ID Number</th>
                            <th>Amount</th>
                            <th>Payment Type</th>
                            <th>Code</th>
                            <th>Payment Date</th>
                            <th>Status</th>
                            <th>Blockchain</th>
                            <th style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td><strong>@payment.VoucherNo</strong></td>
                                <td>@payment.EmployeeName</td>
                                <td>@payment.EmployeeIdNo</td>
                                <td class="text-end">@payment.Amount.ToString("N2")</td>
                                <td>@payment.PaymentType</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(payment.PaymentTypeCode))
                                    {
                                        <span class="badge bg-primary">@payment.PaymentTypeCode</span>
                                    }
                                </td>
                                <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (payment.Status == "POSTED")
                                    {
                                        <span class="badge bg-success">Posted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(payment.BlockchainTxId))
                                    {
                                        <span class="badge bg-info" title="@payment.BlockchainTxId">
                                            <i class="fas fa-link"></i> Recorded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pending</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-success view-receipt" data-id="@payment.Id" title="View Receipt">
                                            <i class="fas fa-receipt">Receipt</i>
                                        </button>
                                        <button type="button" class="btn btn-danger reverse-payment" data-id="@payment.Id" title="Reverse Payment">
                                            <i class="fas fa-undo">Reverse Payment</i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle"></i> No payments found. Process your first payment above.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Payment Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsModalContent">
            </div>
        </div>
    </div>
</div>

<!-- Reverse Modal -->
<div class="modal fade" id="reverseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Reverse Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="reverseForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="reversePaymentId" name="id" />
                    <div class="form-group">
                        <label for="reason">Reason for Reversal <span class="text-danger">*</span></label>
                        <textarea id="reason" name="reason" class="form-control" rows="3" required placeholder="Please provide reason for reversing this payment..."></textarea>
                    </div>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> Warning: This action will create reversal entries in the General Ledger and cannot be undone.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Reversal</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.js"></script>

    <script>
        let paymentTypesData = [];
        let expenseAccountsData = [];
        let cashAccountsData = [];
        let selectedEmployeeData = null;
        let searchTimeout = null;

        // Load data on page load
        $(document).ready(function() {
            loadPaymentTypes();
            loadExpenseAccounts();
            loadCashAccounts();

            $('#paymentsTable').DataTable({
                responsive: true,
                order: [[6, 'desc']],
                pageLength: 25,
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });

            // Auto-search with debounce (like Apply and OffsetLoan views)
            $('#employeeSearchInput').on('input', function() {
                clearTimeout(searchTimeout);
                const searchTerm = $(this).val().trim();
                if (searchTerm.length >= 3) {
                    searchTimeout = setTimeout(function() {
                        searchEmployees();
                    }, 500);
                } else if (searchTerm.length === 0) {
                    clearEmployeeSearch();
                }
            });

            // Enter key support
            $('#employeeSearchInput').on('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchEmployees();
                }
            });

            // Focus on search input on load
            $('#employeeSearchInput').focus();
        });

        // ============================================================
        // SEARCH EMPLOYEES (Auto + Manual)
        // ============================================================
        async function searchEmployees() {
            const searchTerm = document.getElementById('employeeSearchInput').value.trim();

            if (searchTerm.length < 3) {
                Swal.fire('Warning', 'Please enter at least 3 characters to search', 'warning');
                return;
            }

            // Show loading
            document.getElementById('employeeSearchLoading').style.display = 'block';
            document.getElementById('employeeSearchResults').style.display = 'none';
            document.getElementById('employeeSearchResultsBody').innerHTML = '';

            try {
                const response = await fetch(`/api/Employee/search?searchTerm=${encodeURIComponent(searchTerm)}`);

                if (!response.ok) {
                    throw new Error('Search failed');
                }

                const data = await response.json();

                if (data.success && data.data && data.data.length > 0) {
                    displayEmployeeSearchResults(data.data);
                } else {
                    document.getElementById('employeeSearchResultsBody').innerHTML =
                        '<tr><td colspan="6" class="text-center text-warning">No employees found matching your search</td></tr>';
                    document.getElementById('employeeSearchResults').style.display = 'block';
                    // Only show alert if manual search (not auto)
                    // We'll let the user know via the table message
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('employeeSearchResultsBody').innerHTML =
                    '<tr><td colspan="6" class="text-center text-danger">Error searching employees. Please try again.</td></tr>';
                document.getElementById('employeeSearchResults').style.display = 'block';
                Swal.fire('Error', 'Error searching employees. Please try again.', 'error');
            } finally {
                document.getElementById('employeeSearchLoading').style.display = 'none';
            }
        }

        // ============================================================
        // DISPLAY EMPLOYEE SEARCH RESULTS
        // ============================================================
        function displayEmployeeSearchResults(employees) {
            const tbody = document.getElementById('employeeSearchResultsBody');
            tbody.innerHTML = '';

            employees.forEach(employee => {
                const statusBadge = employee.status == 1 || employee.isActive != false ?
                    '<span class="badge bg-success">Active</span>' :
                    '<span class="badge bg-danger">Inactive</span>';

                const fullName = (employee.surname || employee.names || employee.fullName || '');
                const phone = employee.mobileNo || employee.phoneNo || employee.phone || 'N/A';

                const row = tbody.insertRow();
                row.innerHTML = `
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-success btn-select-employee" onclick="selectEmployee('${employee.id}', '${employee.idNo || ''}', '${escapeHtml(fullName)}', '${escapeHtml(phone)}')">
                            <i class="bi bi-check-lg"></i> Select
                        </button>
                    </td>
                    <td><strong>${escapeHtml(employee.idNo || employee.employeeNo || 'N/A')}</strong></td>
                    <td>${escapeHtml(fullName || 'N/A')}</td>
                    <td>${escapeHtml(employee.idNo || 'N/A')}</td>
                    <td>${escapeHtml(phone)}</td>
                    <td>${statusBadge}</td>
                `;
            });

            document.getElementById('employeeSearchResults').style.display = 'block';
        }

        // ============================================================
        // SELECT EMPLOYEE
        // ============================================================
        function selectEmployee(id, idNo, name, phone) {
            // Store selected employee data
            selectedEmployeeData = {
                id: id,
                idNo: idNo,
                name: name,
                phone: phone
            };

            // Update hidden fields
            document.getElementById('EmployeeId').value = id;
            document.getElementById('EmployeeName').value = name;
            document.getElementById('EmployeeIdNo').value = idNo;

            // Update selected employee card
            document.getElementById('selectedEmployeeName').innerHTML = `<strong>${escapeHtml(name)}</strong>`;
            document.getElementById('selectedEmployeeIdNo').innerHTML = escapeHtml(idNo);
            document.getElementById('selectedEmployeePhone').innerHTML = escapeHtml(phone);
            document.getElementById('selectedEmployeeCard').style.display = 'block';

            // Hide search results
            document.getElementById('employeeSearchResults').style.display = 'none';
            document.getElementById('employeeSearchInput').value = '';

            // Show employee info card
            document.getElementById('infoName').textContent = name;
            document.getElementById('infoIdNo').textContent = idNo;
            document.getElementById('infoPhone').textContent = phone || 'N/A';
            document.getElementById('employeeInfoCard').style.display = 'block';

            // Load employee payment history
            loadEmployeePaymentHistory(idNo);
        }

        // ============================================================
        // LOAD EMPLOYEE PAYMENT HISTORY
        // ============================================================
        function loadEmployeePaymentHistory(employeeIdNo) {
            if (!employeeIdNo || employeeIdNo === 'N/A' || employeeIdNo === '') {
                console.log('No valid ID No provided');
                $('#infoTotalPaid').text('KES 0.00');
                return;
            }

            console.log('Loading employee history for ID No:', employeeIdNo);

            $.ajax({
                url: '@Url.Action("GetEmployeeDetailsByIdNo", "EmployeePayment")',
                type: 'GET',
                data: { idNo: employeeIdNo },
                dataType: 'json',
                success: function(data) {
                    console.log('Employee details response:', data);
                    if (data.success && data.employee) {
                        var totalPaid = parseFloat(data.employee.totalPaid || 0);
                        $('#infoTotalPaid').text('KES ' + totalPaid.toLocaleString(undefined, {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }));
                    } else {
                        $('#infoTotalPaid').text('KES 0.00');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading employee payment history:', { status: status, error: error, response: xhr.responseText });
                    $('#infoTotalPaid').text('KES 0.00');
                    // Silent fail - don't show error notification
                }
            });
        }

        // ============================================================
        // CLEAR EMPLOYEE SEARCH
        // ============================================================
        function clearEmployeeSearch() {
            document.getElementById('employeeSearchInput').value = '';
            document.getElementById('employeeSearchResults').style.display = 'none';
            document.getElementById('employeeSearchResultsBody').innerHTML = '';
            clearSelectedEmployee();
        }

        // ============================================================
        // CLEAR SELECTED EMPLOYEE
        // ============================================================
        function clearSelectedEmployee() {
            selectedEmployeeData = null;
            document.getElementById('EmployeeId').value = '';
            document.getElementById('EmployeeName').value = '';
            document.getElementById('EmployeeIdNo').value = '';
            document.getElementById('selectedEmployeeCard').style.display = 'none';
            document.getElementById('employeeInfoCard').style.display = 'none';
            document.getElementById('employeeSearchInput').focus();
        }

        // ============================================================
        // LOAD PAYMENT TYPES
        // ============================================================
        function loadPaymentTypes() {
            $.get('@Url.Action("GetPaymentTypesList", "PaymentType")', function(data) {
                paymentTypesData = data;
                const select = $('#PaymentTypeId');
                select.empty().append('<option value="">-- Select Payment Type --</option>');
                $.each(data, function(i, item) {
                    select.append($('<option></option>').attr('value', item.id).text(item.code + ' - ' + item.name));
                });
            }).fail(function() {
                showNotification('Failed to load payment types', 'error');
            });
        }

        // ============================================================
        // LOAD EXPENSE ACCOUNTS
        // ============================================================
        function loadExpenseAccounts() {
            $.get('@Url.Action("GetExpenseAccounts", "EmployeePayment")', function(data) {
                expenseAccountsData = data;
                const select = $('#ExpenseAccountNo');
                select.empty().append('<option value="">-- Select Expense Account --</option>');
                $.each(data, function(key, value) {
                    select.append($('<option></option>').attr('value', key).text(value));
                });
            }).fail(function() {
                showNotification('Failed to load expense accounts', 'error');
            });
        }

        // ============================================================
        // LOAD CASH ACCOUNTS
        // ============================================================
        function loadCashAccounts() {
            $.get('@Url.Action("GetCashAccounts", "EmployeePayment")', function(data) {
                cashAccountsData = data;
                const select = $('#CashAccountNo');
                select.empty().append('<option value="">-- Select Cash/Bank Account --</option>');
                $.each(data, function(key, value) {
                    select.append($('<option></option>').attr('value', key).text(value));
                });
            }).fail(function() {
                showNotification('Failed to load cash accounts', 'error');
            });
        }

        // Payment type selection - auto-set expense account if default exists
        $('#PaymentTypeId').change(function() {
            const id = $(this).val();
            if (id) {
                $.get('@Url.Action("GetPaymentTypeDefaultAccount", "EmployeePayment")', { id: id }, function(data) {
                    if (data.success && data.defaultExpenseAccountNo) {
                        $('#ExpenseAccountNo').val(data.defaultExpenseAccountNo);
                        showNotification('Default expense account set', 'info');
                    }
                }).fail(function() {
                    // Silent fail - not critical
                });
            }
        });

        // ============================================================
        // PROCESS PAYMENT
        // ============================================================
        $('#btnProcessPayment').click(function() {
            // Get form values
            const employeeId = $('#EmployeeId').val();
            const employeeName = $('#EmployeeName').val();
            const employeeIdNo = $('#EmployeeIdNo').val();
            const paymentTypeId = $('#PaymentTypeId').val();
            const amount = $('#Amount').val();
            const expenseAccount = $('#ExpenseAccountNo').val();
            const cashAccount = $('#CashAccountNo').val();
            const paymentDate = $('#PaymentDate').val();
            const paymentMethod = $('#PaymentMethod').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            // Validation
            if (!employeeId) { showNotification('Please select an employee', 'error'); return; }
            if (!paymentTypeId) { showNotification('Please select a payment type', 'error'); return; }
            if (!amount || parseFloat(amount) <= 0) { showNotification('Please enter a valid amount', 'error'); return; }
            if (!expenseAccount) { showNotification('Please select an expense account', 'error'); return; }
            if (!cashAccount) { showNotification('Please select a cash/bank account', 'error'); return; }

            // Confirm with user
            const confirmMessage = `Confirm payment details:\n\n` +
                `Employee: ${employeeName} (${employeeIdNo})\n` +
                `Amount: KES ${parseFloat(amount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}\n` +
                `Payment Type: ${$('#PaymentTypeId option:selected').text()}\n` +
                `Payment Method: ${paymentMethod || 'Not specified'}\n` +
                `Expense Account: ${$('#ExpenseAccountNo option:selected').text()}\n` +
                `Cash Account: ${$('#CashAccountNo option:selected').text()}\n\n` +
                `This action will create a journal entry and cannot be undone.`;

            if (!confirm(confirmMessage)) {
                return;
            }

            // Disable button to prevent double submission
            const $btn = $('#btnProcessPayment');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');

            // Prepare form data
            const formData = new URLSearchParams();
            formData.append('EmployeeId', employeeId);
            formData.append('PaymentTypeId', paymentTypeId);
            formData.append('Amount', parseFloat(amount));
            formData.append('PaymentDate', paymentDate);
            formData.append('PaymentMethod', paymentMethod || '');
            formData.append('ExpenseAccountNo', expenseAccount);
            formData.append('CashAccountNo', cashAccount);
            formData.append('EmployeeIdNo', employeeIdNo || '');
            formData.append('EmployeeName', employeeName || '');
            formData.append('__RequestVerificationToken', token);

            $.ajax({
                url: '@Url.Action("Create", "EmployeePayment")',
                type: 'POST',
                data: formData.toString(),
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        showNotification(response.message, 'success');

                        // Redirect to receipt automatically
                        if (response.receiptUrl) {
                            setTimeout(function() {
                                window.location.href = response.receiptUrl;
                            }, 1500);
                        } else if (response.paymentId) {
                            setTimeout(function() {
                                window.location.href = '@Url.Action("PrintEmployeePaymentReceipt", "EmployeePayment")' + '?id=' + response.paymentId;
                            }, 1500);
                        } else {
                            setTimeout(function() {
                                location.reload();
                            }, 2000);
                        }
                    } else {
                        showNotification(response.message || 'Error processing payment', 'error');
                        $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> Process Payment');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', { status: status, error: error, response: xhr.responseText });

                    let errorMsg = 'Error processing payment';
                    try {
                        const response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMsg = response.message;
                        }
                    } catch(e) {
                        if (xhr.responseText && xhr.responseText.length < 500) {
                            errorMsg = xhr.responseText;
                        }
                    }

                    showNotification(errorMsg, 'error');
                    $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> Process Payment');
                }
            });
        });

        // ============================================================
        // CLEAR FORM
        // ============================================================
        $('#btnClear').click(function() {
            clearSelectedEmployee();
            $('#PaymentTypeId').val('');
            $('#Amount').val('');
            $('#PaymentMethod').val('');
            $('#ExpenseAccountNo').val('');
            $('#CashAccountNo').val('');
            $('#employeeInfoCard').hide();
            $('#employeeSearchInput').val('');
            $('#employeeSearchResults').hide();
            showNotification('Form cleared', 'info');
        });

        // ============================================================
        // VIEW RECEIPT
        // ============================================================
        $(document).on('click', '.view-receipt', function() {
            const id = $(this).data('id');
            if (id) {
                const url = '@Url.Action("PrintEmployeePaymentReceipt", "EmployeePayment")' + '?id=' + id;
                window.location.href = url;
            }
        });

        // ============================================================
        // REVERSE PAYMENT
        // ============================================================
        $(document).on('click', '.reverse-payment', function() {
            const id = $(this).data('id');
            $('#reversePaymentId').val(id);
            $('#reason').val('');
            $('#reverseModal').modal('show');
        });

        $('#reverseForm').on('submit', function(e) {
            e.preventDefault();
            const id = $('#reversePaymentId').val();
            const reason = $('#reason').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!reason.trim()) {
                showNotification('Please provide a reason for reversal', 'error');
                return;
            }

            const formData = new URLSearchParams();
            formData.append('id', id);
            formData.append('reason', reason);
            formData.append('__RequestVerificationToken', token);

            $.ajax({
                url: '@Url.Action("Reverse", "EmployeePayment")/' + id,
                type: 'POST',
                data: formData.toString(),
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function(response) {
                    $('#reverseModal').modal('hide');
                    showNotification('Payment reversed successfully', 'success');
                    setTimeout(function() {
                        location.reload();
                    }, 1500);
                },
                error: function(xhr) {
                    let errorMsg = xhr.responseText || 'Error reversing payment';
                    showNotification(errorMsg, 'error');
                }
            });
        });

        // ============================================================
        // EXPORT DATA
        // ============================================================
        function exportData() {
            const fromDate = $('input[name="fromDate"]').val();
            const toDate = $('input[name="toDate"]').val();
            window.location.href = '@Url.Action("Export", "EmployeePayment")' + '?fromDate=' + fromDate + '&toDate=' + toDate;
        }

        // ============================================================
        // SHOW NOTIFICATION
        // ============================================================
        function showNotification(message, type) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: type === 'success' ? 'success' : (type === 'error' ? 'error' : 'info'),
                    title: type === 'success' ? 'Success' : (type === 'error' ? 'Error' : 'Info'),
                    text: message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            } else {
                alert((type === 'error' ? '❌ ' : (type === 'success' ? '✅ ' : 'ℹ️ ')) + message);
            }
        }

        // ============================================================
        // ESCAPE HTML
        // ============================================================
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Auto-dismiss alerts
        setTimeout(function() {
            $('.alert').fadeOut(500);
        }, 5000);
    </script>
}

