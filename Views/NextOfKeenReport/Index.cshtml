@model SACCOBlockChainSystem.Models.ViewModels.NextOfKinReportViewModel

@{
    ViewData["Title"] = "Next of Kin Report - Members with Next of Kin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style media="print">
    .app-sidebar, .app-header, .main-footer, .sidebar-wrapper, .navbar,
    .breadcrumb, .footer, [data-lte-toggle="sidebar"], .brand-link,
    .sidebar-footer, .no-print {
        display: none !important;
    }

    .app-main, .app-content, .content-wrapper, .main-content {
        margin-left: 0 !important;
        padding: 20px !important;
        width: 100% !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    .btn, .export-buttons {
        display: none !important;
    }

    body {
        background: white !important;
        font-size: 10pt;
    }

    .table-responsive {
        overflow: visible !important;
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4 no-print">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-file-text me-2"></i>Next of Kin Report
                    </h2>
                    <p class="text-muted mb-0">Showing members with at least one next of kin</p>
                </div>
                <div>
                    <div class="btn-group">
                        <a href="@Url.Action("ExportExcel")" class="btn btn-success">
                            <i class="bi bi-file-excel me-2"></i>Excel
                        </a>
                        <a href="@Url.Action("ExportPdf")" class="btn btn-danger">
                            <i class="bi bi-file-pdf me-2"></i>PDF
                        </a>
                        <button class="btn btn-info" onclick="window.print()">
                            <i class="bi bi-printer me-2"></i>Print
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Company Header -->
            <div class="text-center mb-4">
                <h2 style="color: #3f2b96;">@Model.CompanyName</h2>
                <p>@Model.CompanyAddress</p>
                <p>Tel: @Model.CompanyPhone | Email: @Model.CompanyEmail</p>
                <hr />
                <p><strong>Report Generated:</strong> @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss") | <strong>Generated By:</strong> @Model.GeneratedBy</p>
                <h4 class="mt-3">@Model.ReportTitle</h4>
                <p class="text-muted">Total Members with Next of Kin: <strong>@Model.Summary.TotalMembers</strong></p>
            </div>

            <!-- Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h6 class="card-title">Members with NOK</h6>
                            <h3 class="mb-0">@Model.Summary.TotalMembers</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Next of Kin</h6>
                            <h3 class="mb-0">@Model.Summary.TotalNextOfKeens</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h6 class="card-title">Complete Benefit (≤100%)</h6>
                            <h3 class="mb-0">@Model.Summary.MembersWithCompleteBenefit</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <h6 class="card-title">Invalid Benefit (>100%)</h6>
                            <h3 class="mb-0">@Model.Summary.MembersWithInvalidBenefit</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Members Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="reportTable">
                    <thead class="table-primary">
                        <tr>
                            <th>Member No</th>
                            <th>Member Name</th>
                            <th>ID Number</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th class="text-center">Total NOK</th>
                            <th class="text-center">Benefit %</th>
                            <th>NOK Name</th>
                            <th>Relationship</th>
                            <th>NOK Phone</th>
                            <th class="text-center">Benefit %</th>
                            <th class="text-center">Primary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.MembersWithNextOfKin)
                        {
                            if (member.NextOfKeens.Any())
                            {
                                var rowClass = !member.HasValidBenefit ? "table-danger" : "";
                                var firstRow = true;

                                foreach (var nok in member.NextOfKeens)
                                {
                                    <tr class="@rowClass">
                                        @if (firstRow)
                                        {
                                            <td rowspan="@member.TotalNextOfKeens">@member.MemberNo</td>
                                            <td rowspan="@member.TotalNextOfKeens">@member.FullName</td>
                                            <td rowspan="@member.TotalNextOfKeens">@member.IdNumber</td>
                                            <td rowspan="@member.TotalNextOfKeens">@member.PhoneNo</td>
                                            <td rowspan="@member.TotalNextOfKeens">@member.Status</td>
                                            <td rowspan="@member.TotalNextOfKeens" class="text-center">@member.TotalNextOfKeens</td>
                                            <td rowspan="@member.TotalNextOfKeens" class="text-center @(!member.HasValidBenefit ? "text-danger fw-bold" : "")">
                                                @member.TotalBenefitPercentage.ToString("F2")%
                                            </td>
                                            firstRow = false;
                                        }
                                        <td>@nok.FullName</td>
                                        <td>@nok.Relationship</td>
                                        <td>@nok.PhoneNo</td>
                                        <td class="text-center">@(nok.BenefitPercentage?.ToString("F2") ?? "0")%</td>
                                        <td class="text-center">@(nok.IsPrimary ? "Yes" : "No")</td>
                                    </tr>
                                }
                            }
                        }

                        @if (!Model.MembersWithNextOfKin.Any())
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-2"></i>
                                    No members with next of kin records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="6" class="text-end">TOTALS:</td>
                            <td class="text-center">@Model.Summary.TotalMembers Members</td>
                            <td colspan="4" class="text-center">@Model.Summary.TotalNextOfKeens Next of Kin</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-center mt-4 pt-3 border-top">
                <small class="text-muted">
                    This is a computer-generated document. No signature is required.<br />
                    Page 1 of 1 | Generated: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#reportTable').DataTable({
                pageLength: 25,
                ordering: true,
                responsive: true,
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });
        });
    </script>
}