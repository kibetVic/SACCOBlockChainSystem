@model List<SACCOBlockChainSystem.Models.DTOs.CollateralResponseDTO>

@{
    ViewData["Title"] = "Collaterals";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var newColCode = ViewBag.NewColCode as string;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                <h2><i class="bi bi-bank2 me-2"></i>Collateral Management</h2>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Form Card -->
    <div class="card shadow-sm mb-4" id="formCard">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0" id="formTitle"><i class="bi bi-plus-circle me-2"></i>Add New Collateral</h5>
        </div>
        <div class="card-body">
            <form id="collateralForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="Id" />

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Collateral Code *</label>
                        <input type="text" class="form-control bg-light" id="ColCode" readonly />
                        <small class="text-muted">Auto-generated unique code</small>
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-bold">Collateral Description *</label>
                        <input type="text" class="form-control" id="Coldescription" required maxlength="100" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Percentage (%) *</label>
                        <input type="number" step="0.01" class="form-control" id="Percentage" required min="0" max="100" />
                        <small class="text-muted">Value between 0 and 100</small>
                    </div>
                </div>
                <!-- Photo Upload Section - Alternative Layout -->
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-bold">Collateral Photo</label>
                        <div class="input-group">
                            <input type="file" class="form-control" id="PhotoFile" accept="image/*" />
                            <button class="btn btn-outline-secondary" type="button" onclick="clearPhoto()">
                                <i class="bi bi-x-circle"></i> Clear
                            </button>
                        </div>
                        <small class="text-muted">Upload a photo of the collateral (optional). Supported formats: JPG, PNG, GIF</small>
                        <div class="mt-2">
                            <div id="uploadInfo" style="display: none;" class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                <span id="uploadStatus">No file selected</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7 mb-3">
                        <!-- Photo Preview -->
                        <div id="photoPreviewContainer" style="display: none;">
                            <div class="card h-100">
                                <div class="card-header bg-light py-2">
                                    <small><i class="bi bi-image me-1"></i> Photo Preview</small>
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-4">
                                            <img id="photoPreviewImg" src="" alt="Collateral Photo"
                                                 style="width: 100%; max-height: 180px; border: 1px solid #ddd; border-radius: 4px; padding: 4px; object-fit: cover;" />
                                        </div>
                                        <div class="col-md-8">
                                            <div class="d-flex justify-content-between align-items-start flex-column h-100">
                                                <div class="w-100">
                                                    <strong id="photoPreviewTitle">Photo Preview</strong>
                                                    <br />
                                                    <small id="photoFileName" class="text-muted">No file selected</small>
                                                    <br />
                                                    <small id="photoFileSize" class="text-muted"></small>
                                                </div>
                                                <div class="mt-2">
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearPhoto()">
                                                        <i class="bi bi-trash"></i> Remove Photo
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                

                <!-- Member Search Section -->
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Member Owner *</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="memberSearchInput"
                                   placeholder="Type at least 2 characters to search member..."
                                   autocomplete="off" />
                            <button class="btn btn-outline-danger" type="button" onclick="clearMemberSelection()">
                                <i class="bi bi-x-circle"></i> Clear
                            </button>
                        </div>
                        <small class="text-muted">Search by Member No, Name, ID Number, or Phone</small>
                    </div>
                </div>

                <!-- Member Search Results -->
                <div id="memberSearchResults" style="display: none;" class="mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <small><i class="bi bi-search me-1"></i> Search Results</small>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="closeSearchResults()">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-hover table-sm mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 60px;">Select</th>
                                            <th>Member No</th>
                                            <th>Full Name</th>
                                            <th>ID Number</th>
                                            <th>Phone</th>
                                            <th>Email</th>
                                        </tr>
                                    </thead>
                                    <tbody id="memberResultsBody">
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">
                                                <i class="bi bi-search me-2"></i> Type to search...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Selected Member Display -->
                <div id="selectedMemberDisplay" style="display: none;" class="mb-3">
                    <div class="alert alert-success d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-person-check-fill me-2"></i>
                            <strong>Selected Member:</strong>
                            <span id="selectedMemberName"></span>
                            <br />
                            <small>
                                Member No: <span id="selectedMemberNo"></span> |
                                ID: <span id="selectedMemberIdNo"></span> |
                                Phone: <span id="selectedMemberPhone"></span>
                            </small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearMemberSelection()">
                            <i class="bi bi-x-circle"></i> Change
                        </button>
                    </div>
                </div>

                <input type="hidden" id="MemberNo" />               

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" onclick="resetForm()">Reset</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn" disabled>Save Collateral</button>
                </div>
            </form>
        </div>
    </div>

    <!-- List Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Collaterals List</h5>
                    <small class="text-muted">Manage collateral assets</small>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" class="form-control" id="searchInput" placeholder="Search by code, description, or member..." />
                        <button class="btn btn-outline-secondary" onclick="filterTable()"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-info-circle fs-1"></i>
                    <h5 class="mt-3">No collaterals found</h5>
                    <p class="mb-0">Use the form above to create your first collateral.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="dataTable">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                                <th class="text-end">Percentage (%)</th>
                                <th>Member No</th>
                                <th>Member Name</th>
                                <th>Blockchain Tx</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="row-@item.Id">
                                    <td><strong>@item.ColCode</strong></td>
                                    <td>@item.Coldescription</td>
                                    <td class="text-end">@item.Percentage.ToString("N2")%</td>
                                    <td>@item.MemberNo</td>
                                    <td>@(item.MemberName ?? "N/A")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.BlockchainTxId))
                                        {
                                            <code class="small">@(item.BlockchainTxId.Length > 12 ? item.BlockchainTxId.Substring(0, 12) + "..." : item.BlockchainTxId)</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not recorded</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-info" onclick="viewDetails(@item.Id)"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm btn-outline-primary" onclick="editCollateral(@item.Id)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteCollateral(@item.Id, '@item.ColCode')"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-muted">
                    <small>Total: @Model.Count() collateral(s)</small>
                </div>
            }
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-eye me-2"></i>Collateral Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold text-muted">Collateral Code:</label>
                        <p id="v_ColCode">-</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold text-muted">Percentage:</label>
                        <p id="v_Percentage">-</p>
                    </div>
                    <div class="col-12 mb-2">
                        <label class="fw-bold text-muted">Description:</label>
                        <p id="v_Coldescription">-</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold text-muted">Member No:</label>
                        <p id="v_MemberNo">-</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold text-muted">Member Name:</label>
                        <p id="v_MemberName">-</p>
                    </div>
                    <div class="col-12 mb-2">
                        <label class="fw-bold text-muted">Blockchain Tx ID:</label>
                        <p id="v_BlockchainTxId">-</p>
                    </div>
                    <div class="col-12 mb-2">
                        <label class="fw-bold text-muted">Company Code:</label>
                        <p id="v_CompanyCode">-</p>
                    </div>
                    @if (Model.Any())
                    {
                        var firstItem = Model.FirstOrDefault();
                        if (firstItem != null && firstItem.HasPhoto && !string.IsNullOrEmpty(firstItem.PhotoBase64))
                        {
                            <div class="col-12 mb-2">
                                <label class="fw-bold text-muted">Photo:</label>
                                <div class="mt-2">
                                    <img id="v_Photo" src="data:@(firstItem.PhotoContentType ?? "image/jpeg");base64,@firstItem.PhotoBase64"
                                         alt="Collateral Photo"
                                         style="max-width: 100%; max-height: 300px; border: 1px solid #ddd; border-radius: 4px; padding: 4px;" />
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Photo View Modal -->
<div class="modal fade" id="photoViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-image me-2"></i>Collateral Photo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="photoViewImg" src="" alt="Collateral Photo" style="max-width: 100%; max-height: 80vh; border-radius: 4px;" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedMember = null;
        let searchTimer = null;
        let isSearching = false;
        let currentPhotoFile = null;

        $(document).ready(function() {
            loadNewCode();
            if ($.fn.DataTable) {
                $('#dataTable').DataTable({
                    pageLength: 10,
                    ordering: true,
                    searching: false,
                    paging: true,
                    language: {
                        lengthMenu: "Show _MENU_ collaterals per page",
                        info: "Showing _START_ to _END_ of _TOTAL_ collaterals",
                        infoEmpty: "No collaterals found"
                    }
                });
            }

            // Auto-search for members as user types
            $('#memberSearchInput').on('input', function() {
                clearTimeout(searchTimer);
                var term = $(this).val().trim();

                if (term.length >= 2) {
                    showSearchLoading();
                    searchTimer = setTimeout(function() {
                        searchMember(term);
                    }, 300);
                } else {
                    $('#memberSearchResults').fadeOut(200);
                    if (term.length === 0 && !selectedMember) {
                        $('#memberResultsBody').html(`
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    <i class="bi bi-search me-2"></i> Type at least 2 characters to search...
                                </td>
                            </tr>
                        `);
                    }
                }
            });

            // Photo file change event
            $('#PhotoFile').on('change', function() {
                handlePhotoSelection(this);
            });

            // Handle click outside to close results
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#memberSearchInput, #memberSearchResults').length) {
                    setTimeout(function() {
                        if (!selectedMember) {
                            $('#memberSearchResults').fadeOut(200);
                        }
                    }, 200);
                }
            });

            // Enter key to search
            $('#memberSearchInput').on('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var term = $(this).val().trim();
                    if (term.length >= 2) {
                        searchMember(term);
                    }
                }
            });
        });

        function handlePhotoSelection(input) {
            const file = input.files[0];
            if (!file) {
                clearPhoto();
                return;
            }

            // Validate file type
            const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/bmp'];
            if (!validTypes.includes(file.type)) {
                showToast('error', 'Please upload a valid image file (JPG, PNG, GIF, WEBP, BMP)');
                input.value = '';
                clearPhoto();
                return;
            }

            // Validate file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                showToast('error', 'File size exceeds 5MB limit. Please compress the image.');
                input.value = '';
                clearPhoto();
                return;
            }

            currentPhotoFile = file;

            // Display preview
            const reader = new FileReader();
            reader.onload = function(e) {
                $('#photoPreviewImg').attr('src', e.target.result);
                $('#photoFileName').text('File: ' + file.name);
                $('#photoFileSize').text('Size: ' + (file.size / 1024).toFixed(1) + ' KB');
                $('#photoPreviewContainer').fadeIn(200);
                validateForm();
            };
            reader.readAsDataURL(file);
        }

        function clearPhoto() {
            currentPhotoFile = null;
            $('#PhotoFile').val('');
            $('#photoPreviewContainer').fadeOut(200);
            $('#photoPreviewImg').attr('src', '');
            $('#photoFileName').text('');
            $('#photoFileSize').text('');
            validateForm();
        }

        function viewPhoto(photoBase64, contentType) {
            if (photoBase64) {
                $('#photoViewImg').attr('src', 'data:' + (contentType || 'image/jpeg') + ';base64,' + photoBase64);
                $('#photoViewModal').modal('show');
            }
        }

        function showSearchLoading() {
            $('#memberResultsBody').html(`
                <tr>
                    <td colspan="6" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        Searching...
                    </td>
                </tr>
            `);
            $('#memberSearchResults').fadeIn(200);
        }

        function searchMember(term) {
            if (!term || term.length < 2) {
                $('#memberSearchResults').fadeOut(200);
                return;
            }

            isSearching = true;

            $.ajax({
                url: '/Collateral/SearchMembers',
                type: 'GET',
                data: { term: term },
                success: function(response) {
                    isSearching = false;
                    if (response.success && response.data && response.data.length > 0) {
                        displayMemberResults(response.data);
                    } else {
                        $('#memberResultsBody').html(`
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    <i class="bi bi-info-circle me-2"></i> No members found matching "${escapeHtml(term)}"
                                </td>
                            </tr>
                        `);
                        $('#memberSearchResults').fadeIn(200);
                    }
                },
                error: function() {
                    isSearching = false;
                    $('#memberResultsBody').html(`
                        <tr>
                            <td colspan="6" class="text-center text-danger py-3">
                                <i class="bi bi-exclamation-triangle me-2"></i> Error searching members. Please try again.
                            </td>
                        </tr>
                    `);
                    $('#memberSearchResults').fadeIn(200);
                }
            });
        }

        function displayMemberResults(members) {
            var tbody = $('#memberResultsBody');
            tbody.empty();

            members.forEach(function(member) {
                var row = `
                    <tr class="member-result-row" data-memberno="${escapeHtml(member.memberNo)}">
                        <td class="text-center">
                            <button class="btn btn-sm btn-success select-member-btn"
                                    onclick="selectMember('${escapeHtml(member.memberNo)}')">
                                <i class="bi bi-check"></i> Select
                            </button>
                        </td>
                        <td><strong>${escapeHtml(member.memberNo)}</strong></td>
                        <td>${escapeHtml(member.fullName)}</td>
                        <td>${escapeHtml(member.idno || 'N/A')}</td>
                        <td>${escapeHtml(member.phoneNo || 'N/A')}</td>
                        <td>${escapeHtml(member.email || 'N/A')}</td>
                    </tr>
                `;
                tbody.append(row);
            });

            $('.member-result-row').hover(
                function() { $(this).addClass('bg-light'); },
                function() { $(this).removeClass('bg-light'); }
            );

            $('#memberSearchResults').fadeIn(200);
        }

        function selectMember(memberNo) {
            $.ajax({
                url: '/Collateral/SearchMembers',
                type: 'GET',
                data: { term: memberNo },
                success: function(response) {
                    if (response.success && response.data) {
                        var member = response.data.find(m => m.memberNo === memberNo);
                        if (member) {
                            selectedMember = member;
                            $('#selectedMemberName').html(`<strong>${escapeHtml(member.fullName)}</strong>`);
                            $('#selectedMemberNo').text(member.memberNo);
                            $('#selectedMemberIdNo').text(member.idno || 'N/A');
                            $('#selectedMemberPhone').text(member.phoneNo || 'N/A');
                            $('#selectedMemberDisplay').fadeIn(200);
                            $('#MemberNo').val(member.memberNo);
                            $('#memberSearchInput').val(member.fullName + ' (' + member.memberNo + ')');
                            $('#memberSearchResults').fadeOut(200);
                            validateForm();
                            $('.member-result-row').removeClass('table-success');
                            $('.member-result-row[data-memberno="' + memberNo + '"]').addClass('table-success');
                        }
                    }
                }
            });
        }

        function closeSearchResults() {
            if (!selectedMember) {
                $('#memberSearchResults').fadeOut(200);
            }
        }

        function clearMemberSelection() {
            selectedMember = null;
            $('#selectedMemberDisplay').fadeOut(200);
            $('#memberSearchResults').fadeOut(200);
            $('#memberSearchInput').val('');
            $('#MemberNo').val('');
            $('#memberResultsBody').html(`
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">
                        <i class="bi bi-search me-2"></i> Type at least 2 characters to search...
                    </td>
                </tr>
            `);
            $('.member-result-row').removeClass('table-success');
            validateForm();
            $('#memberSearchInput').focus();
        }

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function filterTable() {
            var searchText = $('#searchInput').val().toLowerCase();
            $('#dataTable tbody tr').each(function() {
                var text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(searchText) > -1);
            });
        }

        function loadNewCode() {
            $.get('@Url.Action("GenerateCode", "Collateral")', function(r) {
                if (r.success) $('#ColCode').val(r.colCode);
            });
        }

        function validateForm() {
            var hasMember = $('#MemberNo').val() !== '';
            var hasDescription = $('#Coldescription').val() !== '';
            var hasPercentage = $('#Percentage').val() !== '';

            if (hasMember && hasDescription && hasPercentage) {
                $('#submitBtn').prop('disabled', false);
            } else {
                $('#submitBtn').prop('disabled', true);
            }
        }

        $('#Coldescription, #Percentage').on('input', function() {
            validateForm();
        });

        $('#collateralForm').on('submit', function(e) {
            e.preventDefault();

            if (!$('#MemberNo').val()) {
                showToast('error', 'Please select a member owner');
                $('#memberSearchInput').focus();
                return;
            }

            if (!$('#Coldescription').val()) {
                showToast('error', 'Collateral Description is required');
                $('#Coldescription').addClass('is-invalid').focus();
                return;
            }
            $('#Coldescription').removeClass('is-invalid');

            var percentage = parseFloat($('#Percentage').val());
            if (!percentage || percentage < 0 || percentage > 100) {
                showToast('error', 'Percentage must be between 0 and 100');
                $('#Percentage').addClass('is-invalid').focus();
                return;
            }
            $('#Percentage').removeClass('is-invalid');

            var formData = new FormData();
            formData.append('Id', $('#Id').val() || null);
            formData.append('ColCode', $('#ColCode').val());
            formData.append('Coldescription', $('#Coldescription').val());
            formData.append('Percentage', percentage);
            formData.append('MemberNo', $('#MemberNo').val());

            // Append photo file if selected
            if (currentPhotoFile) {
                formData.append('PhotoFile', currentPhotoFile);
            }

            var id = $('#Id').val();
            var url = id ? '/Collateral/Edit?id=' + id : '/Collateral/Create';
            var btn = $('#submitBtn');
            btn.prop('disabled', true).html('<i class="bi bi-hourglass-split me-2"></i>Saving...');

            $.ajax({
                url: url,
                type: 'POST',
                contentType: false,
                processData: false,
                data: formData,
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function(r) {
                    if (r.success) {
                        showToast('success', r.message);
                        setTimeout(function() { location.reload(); }, 1500);
                    } else {
                        showToast('error', r.message);
                        btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Save Collateral');
                    }
                },
                error: function(xhr) {
                    var errorMsg = 'An error occurred';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showToast('error', errorMsg);
                    btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Save Collateral');
                }
            });
        });

        function resetForm() {
            $('#collateralForm')[0].reset();
            $('#Id').val('');
            $('#formTitle').html('<i class="bi bi-plus-circle me-2"></i>Add New Collateral');
            $('#submitBtn').html('<i class="bi bi-save me-2"></i>Save Collateral');
            clearMemberSelection();
            clearPhoto();
            loadNewCode();
            $('#submitBtn').prop('disabled', true);
            $('#Coldescription, #Percentage').removeClass('is-invalid');
        }

        function editCollateral(id) {
            $.get('/Collateral/GetDetails?id=' + id, function(r) {
                if (r.success) {
                    var c = r.collateral;
                    $('#Id').val(c.id);
                    $('#ColCode').val(c.colCode);
                    $('#Coldescription').val(c.coldescription);
                    $('#Percentage').val(c.percentage);

                    if (c.memberNo) {
                        $('#MemberNo').val(c.memberNo);
                        $('#selectedMemberNo').text(c.memberNo);
                        $('#selectedMemberName').html(`<strong>${escapeHtml(c.memberName || c.memberNo)}</strong>`);
                        $('#selectedMemberIdNo').text(c.memberIdNo || 'N/A');
                        $('#selectedMemberPhone').text(c.memberPhone || 'N/A');
                        $('#selectedMemberDisplay').fadeIn(200);
                        $('#memberSearchInput').val(c.memberName || c.memberNo);
                    }

                    // Show existing photo if available
                    if (c.hasPhoto && c.photoBase64) {
                        $('#photoPreviewImg').attr('src', 'data:' + (c.photoContentType || 'image/jpeg') + ';base64,' + c.photoBase64);
                        $('#photoFileName').text('Existing photo');
                        $('#photoFileSize').text('');
                        $('#photoPreviewContainer').fadeIn(200);
                    } else {
                        clearPhoto();
                    }

                    $('#formTitle').html('<i class="bi bi-pencil-square me-2"></i>Edit Collateral');
                    $('#submitBtn').html('<i class="bi bi-save me-2"></i>Update Collateral');
                    $('#submitBtn').prop('disabled', false);
                    $('#formCard')[0].scrollIntoView({ behavior: 'smooth' });
                }
            });
        }

        function viewDetails(id) {
            $.get('/Collateral/GetDetails?id=' + id, function(r) {
                if (r.success) {
                    var c = r.collateral;
                    $('#v_ColCode').text(c.colCode);
                    $('#v_Coldescription').text(c.coldescription);
                    $('#v_Percentage').text(c.percentage + '%');
                    $('#v_MemberNo').text(c.memberNo || 'N/A');
                    $('#v_MemberName').text(c.memberName || 'N/A');
                    $('#v_BlockchainTxId').text(c.blockchainTxId || 'Not recorded');
                    $('#v_CompanyCode').text(c.companyCode || 'N/A');

                    // Show photo in modal if available
                    if (c.hasPhoto && c.photoBase64) {
                        var imgHtml = `<img src="data:${c.photoContentType || 'image/jpeg'};base64,${c.photoBase64}"
                                         alt="Collateral Photo"
                                         style="max-width: 100%; max-height: 300px; border: 1px solid #ddd; border-radius: 4px; padding: 4px;" />`;
                        $('#v_Photo').html(imgHtml);
                    } else {
                        $('#v_Photo').html('<span class="text-muted">No photo available</span>');
                    }

                    $('#viewModal').modal('show');
                }
            });
        }

        function deleteCollateral(id, code) {
            if (confirm(`Are you sure you want to delete collateral '${code}'? This action cannot be undone.`)) {
                $.ajax({
                    url: '/Collateral/Delete?id=' + id,
                    type: 'POST',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(r) {
                        if (r.success) {
                            showToast('success', r.message);
                            setTimeout(function() { location.reload(); }, 1000);
                        } else {
                            showToast('error', r.message);
                        }
                    }
                });
            }
        }

        function showToast(type, message) {
            var toastHtml = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0 position-fixed bottom-0 end-0 m-3" role="alert" style="z-index: 9999;">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>${escapeHtml(message)}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            $('body').append(toastHtml);
            var toast = $('.toast').last();
            var bsToast = new bootstrap.Toast(toast[0], { delay: 5000 });
            bsToast.show();
            toast.on('hidden.bs.toast', function() { $(this).remove(); });
        }
    </script>
}

