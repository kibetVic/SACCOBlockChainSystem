<!-- Views/Collateral/Report.cshtml -->
@model List<SACCOBlockChainSystem.Models.DTOs.CollateralReportDTO>

@{
    ViewData["Title"] = "Collateral Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companyName = ViewBag.CompanyName as string ?? "SACCO BlockChain System";
    var generatedDate = ViewBag.GeneratedDate as DateTime? ?? DateTime.Now;
    var hasData = ViewBag.HasData as bool? ?? false;
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-chart-line"></i> Collateral Report
            </h6>
            <div>
                <a asp-action="ExportCollateralToExcel" class="btn btn-success btn-sm">
                    <i class="fas fa-file-excel"></i> Export to Excel
                </a>
                <a asp-action="ExportCollateralToPdf" class="btn btn-danger btn-sm">
                    <i class="fas fa-file-pdf"></i> Export to PDF
                </a>
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="alert alert-info">
                        <strong>@companyName</strong><br />
                        Report Generated: @generatedDate.ToString("dd MMMM yyyy HH:mm:ss")
                    </div>
                </div>
            </div>

            @if (!hasData)
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-info-circle"></i> No collateral data found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="reportTable" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th>Member No</th>
                                <th>Names</th>
                                <th>Loan No</th>
                                <th>Collateral Description</th>
                                <th class="text-right">Market Value (KES)</th>
                                <th class="text-right">Balance (KES)</th>
                                <th class="text-center">Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MemberNo</td>
                                    <td>@item.Names</td>
                                    <td>@item.LoanNo</td>
                                    <td>@item.Coldescription</td>
                                    <td class="text-right">@item.Mktvalue.ToString("N2")</td>
                                    <td class="text-right">@item.Balance.ToString("N2")</td>
                                    <td class="text-center">@item.Percentage.ToString("P2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="bg-light font-weight-bold">
                                <td colspan="4" class="text-right">TOTAL:</td>
                                <td class="text-right">@Model.Sum(x => x.Mktvalue).ToString("N2")</td>
                                <td class="text-right">@Model.Sum(x => x.Balance).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-info text-white">
                                <i class="fas fa-chart-pie"></i> Summary Statistics
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="alert alert-success text-center">
                                            <h6>Total Collaterals</h6>
                                            <h4>@Model.Count</h4>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="alert alert-primary text-center">
                                            <h6>Total Market Value</h6>
                                            <h4>@Model.Sum(x => x.Mktvalue).ToString("N0")</h4>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="alert alert-warning text-center">
                                            <h6>Total Outstanding Balance</h6>
                                            <h4>@Model.Sum(x => x.Balance).ToString("N0")</h4>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="alert alert-secondary text-center">
                                            <h6>Coverage Ratio</h6>
                                            <h4>
                                                @{
                                                    var totalBalance = Model.Sum(x => x.Balance);
                                                    var totalValue = Model.Sum(x => x.Mktvalue);
                                                    var ratio = totalBalance > 0 ? (totalValue / totalBalance) * 100 : 0;
                                                }
                                                @ratio.ToString("F2")%
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#reportTable').DataTable({
                "order": [[0, "asc"]],
                "pageLength": 25,
                "language": {
                    "search": "Search:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });
        });
    </script>
}