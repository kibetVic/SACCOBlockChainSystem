@model IEnumerable<SACCOBlockChainSystem.Models.DTOs.DividendDetailsResponseDTO>

@{
    ViewData["Title"] = "Dividend Details";
}

<div class="container mt-4">

    <h3>Dividend Management</h3>

    <!-- SEARCH CARD -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5>Search Member</h5>
        </div>
        <div class="card-body">
            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control"
                       placeholder="Search member by name or member number..." />
                <button type="button" class="btn btn-primary" onclick="searchMembers()">
                    Search
                </button>
                <button type="button" class="btn btn-secondary" onclick="clearSearch()">
                    Clear
                </button>
            </div>
            <div id="searchResults" style="display:none;">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Member No</th>
                            <th>Name</th>
                            <th>ID No</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="membersResult"></tbody>
                </table>
            </div>
            <div id="noResultsMessage" class="alert alert-warning" style="display:none;">
                No members found
            </div>
        </div>
    </div>

    <!-- CREATE FORM -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5>Create Dividend</h5>
        </div>
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-3">
                    <label>Year</label>
                    <input id="DividendYear" class="form-control" value="@DateTime.Now.Year" />
                </div>
                <div class="col-md-3">
                    <label>Member No</label>
                    <input id="MemberNo" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label>Member Name</label>
                    <input id="MemberName" class="form-control" readonly />
                </div>
            </div>
            <button type="button" id="saveDividendBtn" class="btn btn-success mt-3">
                Calculate & Save Dividend
            </button>
        </div>
    </div>

    <!-- LIST -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5>Dividend Records</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Year</th>
                        <th>Member No</th>
                        <th>Member Name</th>
                        <th>Weighted Savings</th>
                        <th>Savings Dividend</th>
                        <th>Share Dividend</th>
                        <th>Gross Dividend</th>
                        <th>Tax</th>
                        <th>Net</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DividendYear</td>
                            <td>@item.MemberNo</td>
                            <td>@(ViewBag.MemberNames != null && ViewBag.MemberNames.ContainsKey(item.MemberNo) ? ViewBag.MemberNames[item.MemberNo] : "Unknown")</td>
                            <td class="text-end">@item.WeightedSavings.ToString("N2")</td>
                            <td class="text-end">@item.SavingsDividend.ToString("N2")</td>
                            <td class="text-end">@item.ShareDividend.ToString("N2")</td>
                            <td class="text-end">@item.GrossDividend.ToString("N2")</td>
                            <td class="text-end">@item.WithholdingTax.ToString("N2")</td>
                            <td class="text-end fw-bold">@item.NetDividend.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Bind save button click event
            $("#saveDividendBtn").on("click", saveDividend);

            // Enter key support for search
            $("#searchInput").on("keypress", function(e) {
                if (e.which === 13) {
                    searchMembers();
                }
            });
        });

        function searchMembers() {
            let term = $("#searchInput").val().trim();

            if (term.length < 2) {
                alert("Enter at least 2 characters");
                return;
            }

            $("#searchResults").show();
            $("#noResultsMessage").hide();

            $.ajax({
                url: '@Url.Action("SearchMembers", "DividendDetails")',
                type: 'GET',
                data: { term: term },
                success: function(response) {
                    let html = "";
                    if (response.success && response.data.length > 0) {
                        $.each(response.data, function(i, m) {
                            html += '<tr>';
                            html += '<td>' + escapeHtml(m.memberNo) + '</td>';
                            html += '<td>' + escapeHtml(m.name) + '</td>';
                            html += '<td>' + escapeHtml(m.idno || '-') + '</td>';
                            html += '<td>' + escapeHtml(m.phoneNo || '-') + '</td>';
                            html += '<td><button type="button" class="btn btn-sm btn-success" onclick="selectMember(\'' + escapeHtml(m.memberNo) + '\', \'' + escapeHtml(m.name.replace(/'/g, "\\'")) + '\')">Select</button></td>';
                            html += '</tr>';
                        });
                        $("#membersResult").html(html);
                        $("#noResultsMessage").hide();
                    } else {
                        $("#membersResult").html("");
                        $("#noResultsMessage").show();
                    }
                },
                error: function(xhr) {
                    console.log(xhr.responseText);
                    alert("Search failed");
                }
            });
        }

        function selectMember(memberNo, name) {
            console.log("Selected MemberNo:", memberNo);
            $("#MemberNo").val(memberNo);
            $("#MemberName").val(name);
            $("#searchResults").hide();
            $("#noResultsMessage").hide();
        }

        function saveDividend() {
            let year = $("#DividendYear").val();
            let memberNo = $("#MemberNo").val();

            console.log("Year:", year);
            console.log("MemberNo:", memberNo);

            if (!year || !memberNo) {
                alert("Please select a member and enter the year");
                return;
            }

            let currentYear = new Date().getFullYear();
            let yearNum = parseInt(year);

            if (isNaN(yearNum) || yearNum < 2000 || yearNum > currentYear + 1) {
                alert("Please enter a valid year (2000-" + (currentYear + 1) + ")");
                return;
            }

            let saveButton = $("#saveDividendBtn");
            let originalText = saveButton.html();
            saveButton.html('<i class="fas fa-spinner fa-spin"></i> Calculating...').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("Calculate", "DividendDetails")',
                type: 'POST',
                data: {
                    DividendYear: yearNum,
                    MemberNo: memberNo,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                dataType: 'json',
                success: function(response) {
                    console.log("RESPONSE:", response);
                    if (response.success) {
                        let details = response.data;
                        let message = response.message + "\n\n";
                        message += "Year: " + details.dividendYear + "\n";
                        message += "Member: " + (details.memberName || details.memberNo) + "\n";
                        message += "Net Dividend: KES " + details.netDividend;
                        alert(message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.log("Status:", status);
                    console.log("Error:", error);
                    let errorMsg = "Error saving dividend. ";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg += xhr.responseJSON.message;
                    } else {
                        errorMsg += "Please try again.";
                    }
                    alert(errorMsg);
                },
                complete: function() {
                    saveButton.html(originalText).prop('disabled', false);
                }
            });
        }

        function clearSearch() {
            $("#searchInput").val("");
            $("#membersResult").html("");
            $("#searchResults").hide();
            $("#noResultsMessage").hide();
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }
    </script>
}