@model IEnumerable<SACCOBlockChainSystem.Models.DTOs.DividendDetailsResponseDTO>

@{
    ViewData["Title"] = "Dividend Details";
}

<div class="container mt-4">

    <h3>Dividend Management</h3>

    <!-- SEARCH CARD -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5>Search Member</h5>
        </div>

        <div class="card-body">

            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control"
                       placeholder="Search member..." />

                <button type="button" class="btn btn-primary" onclick="searchMembers()">
                    Search
                </button>

                <button type="button" class="btn btn-secondary" onclick="clearSearch()">
                    Clear
                </button>
            </div>

            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Member No</th>
                        <th>Name</th>
                        <th>ID No</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody id="membersResult"></tbody>
            </table>

        </div>
    </div>

    <!-- CREATE FORM -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5>Create Dividend</h5>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">

                <div class="row">
                    <div class="col-md-3">
                        <label>Year</label>
                        <input name="DividendYear" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label>Member No</label>
                        <input name="MemberNo" class="form-control" />
                    </div>
                </div>

                <button class="btn btn-success mt-3">Save</button>

            </form>
        </div>
    </div>

    <!-- LIST -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            Records
        </div>

        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Year</th>
                        <th>Member</th>
                        <th>Net</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DividendYear</td>
                            <td>@item.MemberNo</td>
                            <td>@item.NetDividend</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function searchMembers() {

            let term = $("#searchInput").val();

            if (!term || term.length < 2) {
                alert("Enter at least 2 characters");
                return;
            }

            $.ajax({
                 $.ajax({
        url: '@Url.Action("SearchMembers", "DividendDetails")',
        type: 'GET',
        data: { term: term },
              
                success: function (res) {

                    console.log(res);

                    if (res.success) {

                        let html = "";

                        res.data.forEach(m => {
                            html += `
                                <tr onclick="selectMember('${m.memberNo}', '${m.name}')">
                                    <td>${m.memberNo}</td>
                                    <td>${m.name}</td>
                                    <td>${m.idno}</td>
                                    <td>${m.phoneNo}</td>
                                </tr>
                            `;
                        });

                        $("#membersResult").html(html);
                    }
                },
                error: function (err) {
                    console.log(err);
                    alert("Search failed");
                }
            });
        }

        function selectMember(memberNo, name) {
            $("input[name='MemberNo']").val(memberNo);
            $("#searchInput").val(name);
            $("#membersResult").html("");
        }

        function clearSearch() {
            $("#searchInput").val("");
            $("#membersResult").html("");
        }
    </script>
}