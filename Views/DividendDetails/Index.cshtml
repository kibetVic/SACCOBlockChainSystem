@model IEnumerable<SACCOBlockChainSystem.Models.DTOs.DividendDetailsResponseDTO>

@{
    ViewData["Title"] = "Dividend Details";
}

<div class="container mt-4">

    <h3>Dividend Management</h3>

    <!-- SEARCH CARD -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5>Search Member</h5>
        </div>

        <div class="card-body">

            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control"
                       placeholder="Search member by name or member number..." />

                <button type="button" class="btn btn-primary" onclick="searchMembers()">
                    Search
                </button>

                <button type="button" class="btn btn-secondary" onclick="clearSearch()">
                    Clear
                </button>
            </div>

            <div id="searchResults" style="display:none;">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Member No</th>
                            <th>Name</th>
                            <th>ID No</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="membersResult"></tbody>
                </table>
            </div>

            <div id="noResultsMessage" class="alert alert-warning" style="display:none;">
                No members found
            </div>

        </div>
    </div>

    <!-- CREATE FORM -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5>Create Dividend</h5>
        </div>

        <div class="card-body">

            @Html.AntiForgeryToken()

            <div class="row">

                <div class="col-md-3">
                    <label>Year</label>
                    <input id="DividendYear" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>Member No</label>
                    <input id="MemberNo" class="form-control" readonly />
                </div>

                <div class="col-md-4">
                    <label>Member Name</label>
                    <input id="MemberName" class="form-control" readonly />
                </div>

            </div>

            <button type="button"
                    class="btn btn-success mt-3"
                    onclick="saveDividend()">
                Calculate & Save Dividend
            </button>

        </div>
    </div>

    <!-- LIST -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5>Dividend Records</h5>
        </div>

        <div class="card-body">

            <table class="table table-striped table-hover" id="dividendTable">

                <thead>
                    <tr>
                        <th>Year</th>
                        <th>Member No</th>
                        <th>Member Name</th>
                        <th>Weighted Savings</th>
                        <th>Savings Dividend</th>
                        <th>Share Dividend</th>
                        <th>Gross Dividend</th>
                        <th>Tax</th>
                        <th>Net</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DividendYear</td>
                            <td>@item.MemberNo</td>
                            <td>
                                @if (ViewBag.MemberNames != null && ViewBag.MemberNames.ContainsKey(item.MemberNo))
                                {
                                    @ViewBag.MemberNames[item.MemberNo]
                                }
                                else
                                {
                                    <span class="text-muted">Unknown</span>
                                }
                            </td>
                            <td>@item.WeightedSavings.ToString("N2")</td>
                            <td>@item.SavingsDividend.ToString("N2")</td>
                            <td>@item.ShareDividend.ToString("N2")</td>
                            <td>@item.GrossDividend.ToString("N2")</td>
                            <td>@item.WithholdingTax.ToString("N2")</td>
                            <td class="fw-bold">@item.NetDividend.ToString("N2")</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>

<script>

    function searchMembers() {

        let term = $("#searchInput").val().trim();

        if (term.length < 2) {
            alert("Enter at least 2 characters");
            return;
        }

        $("#searchResults").show();

        $.ajax({
            url: '@Url.Action("SearchMembers", "DividendDetails")',
            type: 'GET',
            data: { term: term },

            success: function (response) {

                let html = "";

                if (response.success && response.data.length > 0) {

                    response.data.forEach(m => {

                        html += `
                            <tr>
                                <td>${m.memberNo}</td>
                                <td>${m.name}</td>
                                <td>${m.idno}</td>
                                <td>${m.phoneNo}</td>
                                <td>
                                    <button type="button"
                                        class="btn btn-sm btn-success"
                                        onclick="selectMember('${m.memberNo}','${m.name.replace(/'/g,"\\'")}')">
                                        Select
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    $("#membersResult").html(html);
                }
            },

            error: function (xhr) {
                console.log(xhr.responseText);
            }
        });
    }

    function selectMember(memberNo, name) {

        console.log("Selected MemberNo:", memberNo); // DEBUG

        $("#MemberNo").val(memberNo);
        $("#MemberName").val(name);

        $("#searchResults").hide();
    }

    function saveDividend() {

        let year = $("#DividendYear").val();
        let memberNo = $("#MemberNo").val();

        console.log("Year:", year);
        console.log("MemberNo:", memberNo);

        if (!year || !memberNo) {
            alert("Select member and year");
            return;
        }

        $.ajax({
            url: '@Url.Action("Create", "DividendDetails")',
            type: 'POST',

            data: {
                DividendYear: year,
                MemberNo: memberNo,
                __RequestVerificationToken:
                    $('input[name="__RequestVerificationToken"]').val()
            },

            success: function (response) {

                console.log("RESPONSE:", response);

                if (response.success) {

                    alert(response.message);
                    location.reload();
                }
                else {
                    alert(response.message);
                }
            },

            error: function (xhr, status, error) {

                console.log("STATUS:", status);
                console.log("ERROR:", error);
                console.log("RESPONSE:", xhr.responseText);

                alert("Error saving dividend. Check console.");
            }
        });
    }

    function clearSearch() {

        $("#searchInput").val("");
        $("#membersResult").html("");
        $("#searchResults").hide();
    }

</script>