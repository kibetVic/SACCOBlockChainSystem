@using SACCOBlockChainSystem.Models.ViewModels
@model RepaymentReceiptViewModel

@{
    ViewData["Title"] = "Repayment Receipt";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Repayment Receipt - @Model.ReceiptNo</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6f9;
            font-size: 13px;
        }

        /* SCREEN VIEW */
        .receipt-container {
            max-width: 650px;
            margin: 20px auto;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }

        .receipt-header {
            background: #28a745;
            color: #fff;
            text-align: center;
            padding: 15px;
        }

        .receipt-title {
            font-size: 22px;
            font-weight: bold;
        }

        .receipt-subtitle {
            font-size: 12px;
        }

        .company-details-header {
            background: #f8f9fa;
            text-align: center;
            padding: 10px;
            border-bottom: 2px solid #28a745;
        }

        .company-name {
            font-weight: bold;
            color: #28a745;
        }

        .receipt-body {
            padding: 15px;
        }

        .info-row {
            margin-bottom: 12px;
            border-bottom: 1px solid #eee;
            padding-bottom: 8px;
        }

        .info-label {
            font-weight: 600;
            color: #666;
            font-size: 11px;
        }

        .info-value {
            font-size: 13px;
        }

        .method-details {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 6px;
            margin: 10px 0;
        }

        .allocation-table {
            width: 100%;
        }

        .allocation-table td {
            padding: 4px 0;
        }

        .receipt-footer {
            background: #f8f9fa;
            text-align: center;
            padding: 10px;
            font-size: 11px;
            border-top: 1px solid #ddd;
        }

        .btn-print {
            position: fixed;
            bottom: 20px;
            right: 20px;
        }

        @@media print {

            @@page {
                size: 70mm auto;
                margin: 5mm;
            }

            html, body {
                width: 70mm !important;
                font-size: 12px !important;
                background: #fff !important;
            }

            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .receipt-container {
                width: 100% !important;
                padding: 5px !important;
            }
            /* 🔥 FIX HEADER PRINT (BLACK BG, WHITE TEXT) */
            .receipt-header {
                background: #000 !important;
                color: #fff !important;
                border: 1px solid #000 !important;
            }

            .receipt-title,
            .receipt-subtitle {
                color: #fff !important;
            }

            .receipt-no {
                font-size: 14px !important;
                font-weight: bold !important;
            }

            .info-row {
                margin-bottom: 12px !important;
            }

            .allocation-table td {
                padding: 6px 0 !important;
            }
        }
    </style>
</head>

<body>

    <!-- Buttons -->
    <div class="no-print text-center mb-3">
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fas fa-print"></i> Print / Save PDF
        </button>
        <button onclick="goBack()" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </button>
    </div>

    <div class="receipt-container">

        <!-- HEADER -->
        <div class="receipt-header">
            <!-- Optional Logo -->
            <!-- <img src="/images/logo.png" style="height:50px;" /> -->
            <div class="receipt-title">LOAN REPAYMENT RECEIPT</div>
            <div class="receipt-subtitle">Payment Confirmation</div>
        </div>

        <!-- COMPANY -->
        <div class="company-details-header">
            <div class="company-name">@Model.CompanyName</div>
            <div>@Model.CompanyAddress</div>
            <div>Tel: @Model.CompanyPhone | Email: @Model.CompanyEmail</div>
        </div>

        <!-- BODY -->
        <div class="receipt-body">

            <!-- Receipt No -->
            <div class="text-center mb-2">
                <span class="badge bg-success">Receipt No: @Model.ReceiptNo</span>
            </div>

            <!-- MEMBER -->
            <div class="info-row">
                <div class="info-label">Member Details</div>
                <div class="info-value">
                   Name: @Model.MemberName<br />
                    Member No: @Model.MemberNo<br />
                    Phone: @Model.MemberPhone<br />
                    Loan No: @Model.LoanNo
                </div>
            </div>

            <!-- PAYMENT METHOD -->
            <div class="method-details">
                <strong>@Model.PaymentMethod</strong><br />
                Reference: @Model.ReferenceNo
            </div>

            <!-- ALLOCATION -->
            <div class="info-row">
                <div class="info-label">Payment Breakdown</div>
                <table class="allocation-table">
                    <tr>
                        <td>Principal</td>
                        <td class="text-end">KES @Model.PrincipalAllocated.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Interest</td>
                        <td class="text-end">KES @Model.InterestAllocated.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Penalty</td>
                        <td class="text-end text-danger">KES @Model.PenaltyAllocated.ToString("N2")</td>
                    </tr>
                    <tr class="fw-bold border-top">
                        <td>Total Paid</td>
                        <td class="text-end">KES @Model.AmountPaid.ToString("N2")</td>
                    </tr>
                </table>
            </div>

            <!-- BALANCE -->
            <div class="info-row">
                <div class="info-label">Remaining Balance</div>
                <div class="info-value">
                    KES @Model.BalanceAfter.ToString("N2")
                </div>
            </div>

            @if (Model.IsFullSettlement)
            {
                <div class="text-success fw-bold text-center mt-2">
                    <i class="fas fa-check-circle"></i> LOAN FULLY SETTLED
                </div>
            }

        </div>

        <!-- FOOTER -->
        <div class="receipt-footer">
            <div>Received by: @Model.ReceivedBy</div>
            <div>Printed: @Model.PrintedAt.ToString("dd MMM yyyy HH:mm")</div>
            <div>This is a system generated receipt.</div>
        </div>

    </div>

    <!-- Floating button -->
    <div class="btn-print no-print">
        <button onclick="window.print()" class="btn btn-primary" style="width:60px;height:60px;">
            <i class="fas fa-print"></i>
        </button>
    </div>

    <script>
        function goBack() {
            window.history.back();
        }
    </script>

</body>
</html>