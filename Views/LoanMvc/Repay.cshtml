@model SACCOBlockChainSystem.Models.DTOs.LoanRepaymentDTO
@{
    ViewData["Title"] = "Loan Repayment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companyCode = ViewBag.CompanyCode as string ?? Context.Request.Query["companyCode"].ToString();
    if (string.IsNullOrEmpty(companyCode))
    {
        companyCode = User?.FindFirst("CompanyCode")?.Value ?? "DEFAULT";
    }
    var glAccounts = ViewBag.GlAccounts as IEnumerable<dynamic> ?? new List<dynamic>();
}

<style>
    #loansTable tbody tr {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        #loansTable tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        #loansTable tbody tr.table-primary {
            background-color: rgba(13, 110, 253, 0.1);
        }

    .loan-selected {
        border-left: 4px solid #0d6efd;
    }

    .allocation-card {
        transition: all 0.3s ease;
    }

        .allocation-card .progress {
            height: 8px;
            border-radius: 4px;
        }

    .amount-display {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .badge-overdue {
        background-color: #dc3545;
        color: white;
    }

    .badge-on-time {
        background-color: #28a745;
        color: white;
    }

    .total-due-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .search-type-btn {
        margin-right: 5px;
    }

        .search-type-btn.active {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }

    .search-results-table tbody tr {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .search-results-table tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

    .selected-member-card {
        border-left: 4px solid #28a745;
    }

    .highlight-row {
        background-color: #e8f4fd !important;
    }

    .btn-select-member {
        min-width: 80px;
    }

    /* New styles for repayment breakdown */
    .breakdown-card {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        border: 1px solid #dee2e6;
    }

    .breakdown-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .breakdown-item:last-child {
        border-bottom: none;
    }

    .breakdown-label {
        font-weight: 500;
        color: #495057;
    }

    .breakdown-value {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .breakdown-value.principal {
        color: #0d6efd;
    }
    .breakdown-value.interest {
        color: #198754;
    }
    .breakdown-value.penalty {
        color: #dc3545;
    }
    .breakdown-value.total {
        color: #6f42c1;
        font-size: 1.2rem;
    }

    .allocation-progress {
        height: 12px;
        border-radius: 6px;
        overflow: hidden;
        background-color: #e9ecef;
        margin-top: 5px;
    }

    .allocation-progress .progress-bar {
        float: left;
        height: 100%;
        transition: width 0.3s ease;
    }

    .allocation-progress .principal-bar {
        background-color: #0d6efd;
    }
    .allocation-progress .interest-bar {
        background-color: #198754;
    }
    .allocation-progress .penalty-bar {
        background-color: #dc3545;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .overpayment-warning {
        background-color: #fff3cd;
        border: 1px solid #ffc107;
        color: #856404;
        padding: 10px 15px;
        border-radius: 6px;
        margin-top: 10px;
    }

    .exceeds-balance-error {
        background-color: #f8d7da;
        border: 1px solid #dc3545;
        color: #721c24;
        padding: 10px 15px;
        border-radius: 6px;
        margin-top: 10px;
    }

    .balance-info {
        background-color: #e7f3ff;
        border: 1px solid #b3d7ff;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
    }
</style>

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center">
            <a asp-action="AllLoans" class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
            <h2 class="page-title mb-0">
                <i class="bi bi-cash-stack me-2"></i>Loan Repayment
            </h2>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Find and Repay Loan</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Repay" method="post" id="repaymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CompanyCode" />
                        <input type="hidden" asp-for="ReceivedBy" />
                        <input type="hidden" asp-for="LoanNo" id="LoanNo" />
                        <input type="hidden" asp-for="MemberNo" id="MemberNo" />
                        <input type="hidden" asp-for="GlAccountNo" id="GlAccountNoHidden" />
                        <input type="hidden" id="printReceiptHidden" name="printReceipt" value="true" />
                        <input type="hidden" asp-for="IpAddress" value="@Context.Connection.RemoteIpAddress?.ToString() ?? "127.0.0.1"" />
                        <input type="hidden" asp-for="ChequeNumber" id="ChequeNumber" />

                        <!-- Enhanced Search Section -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <h6 class="card-title mb-3">Step 1: Search & Select Member</h6>
                                        </div>

                                        <!-- Search Input -->
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label class="fw-bold">Search Member</label>
                                                    <div class="input-group">
                                                        <input type="text" id="searchInput" class="form-control"
                                                               placeholder="Search by Member Number, Name, ID Number, or Phone Number..." />
                                                        <button type="button" class="btn btn-primary" onclick="searchMembers()">
                                                            <i class="bi bi-search"></i> Search
                                                        </button>
                                                        <button type="button" class="btn btn-secondary" onclick="clearSearch()">
                                                            <i class="bi bi-x-lg"></i> Clear
                                                        </button>
                                                    </div>
                                                    <small class="text-muted">Enter at least 3 characters to search</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Search Results -->
                                        <div id="searchResults" style="display: none;">
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-hover search-results-table">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Select</th>
                                                            <th>Member No</th>
                                                            <th>Full Name</th>
                                                            <th>ID Number</th>
                                                            <th>Phone Number</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="searchResultsBody"></tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- Loading Indicator -->
                                        <div id="searchLoading" style="display: none;" class="text-center p-3">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p>Searching for members...</p>
                                        </div>

                                        <!-- Selected Member Display -->
                                        <div id="selectedMemberCard" style="display: none;" class="mt-3">
                                            <div class="alert alert-success selected-member-card">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        <strong>Selected Member:</strong>
                                                        <span id="selectedMemberName"></span>
                                                        <br />
                                                        <small>
                                                            <span id="selectedMemberNoDisplay"></span> |
                                                            ID: <span id="selectedMemberIdNo"></span> |
                                                            Phone: <span id="selectedMemberPhone"></span>
                                                        </small>
                                                    </div>
                                                    <div>
                                                        <button type="button" class="btn btn-sm btn-primary me-1" onclick="loadMemberLoans()">
                                                            <i class="bi bi-search"></i> View Loans
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearSelectedMember()">
                                                            <i class="bi bi-arrow-left"></i> Change
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Results Section -->
                        <div id="resultsSection" class="d-none">
                            <div id="memberInfo" class="alert alert-info mb-3">
                                <i class="bi bi-person-check-fill me-2"></i>
                                <strong id="memberName"></strong>
                                <div id="memberDetails" class="mt-2"></div>
                            </div>

                            <!-- Active Loans Table -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h6 class="fw-bold mb-3">Active Loans Found</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="loansTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Action</th>
                                                    <th>Loan Number</th>
                                                    <th>Loan Type</th>
                                                    <th>Principal</th>
                                                    <th>Interest</th>
                                                    <th>Penalty</th>
                                                    <th>Outstanding</th>
                                                    <th>Days</th>
                                                </tr>
                                            </thead>
                                            <tbody id="loansTableBody">
                                                <tr>
                                                    <td colspan="8" class="text-center text-muted py-4">
                                                        <i class="bi bi-search me-2"></i>Search for a loan to see results
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div id="paymentSection" class="d-none">
                                <hr />
                                <h6 class="mb-3">Payment Details</h6>

                                <!-- Total Due -->
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <div class="card total-due-card">
                                            <div class="card-body py-3">
                                                <div id="totalDueDisplay" class="d-flex flex-column gap-1">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span>Current Installment Due:</span>
                                                        <strong class="fs-5" id="currentInstallmentDueDisplay">KES 0.00</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="text-light-emphasis">Total Outstanding Balance:</span>
                                                        <strong class="fs-4" id="totalOutstandingDisplay">KES 0.00</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Balance Info -->
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <div class="balance-info" id="balanceInfo">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <small><strong>Principal Balance:</strong> <span id="principalBalanceDisplay">KES 0.00</span></small>
                                                </div>
                                                <div class="col-md-4">
                                                    <small><strong>Interest Balance:</strong> <span id="interestBalanceDisplay">KES 0.00</span></small>
                                                </div>
                                                <div class="col-md-4">
                                                    <small><strong>Penalty Balance:</strong> <span id="penaltyBalanceDisplay">KES 0.00</span></small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Row 1 -->
                                <div class="row mb-3">
                                    <!-- GL Account -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">GL Account *</label>
                                        <select id="glAccountSelect" class="form-select" required>
                                            <option value="">-- Select GL Account --</option>
                                            @if (glAccounts != null && glAccounts.Any())
                                            {
                                                foreach (var account in glAccounts)
                                                {
                                                    <option value="@account.AccNo" data-account-name="@account.Glaccname">
                                                        @account.DisplayText
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Payment Date -->
                                    <div class="col-md-4">
                                        <label asp-for="PaymentDate" class="form-label fw-bold"></label>
                                        <input asp-for="PaymentDate" class="form-control" type="date"
                                               value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                    </div>

                                    <!-- Amount -->
                                    <div class="col-md-4">
                                        <label asp-for="AmountPaid" class="form-label fw-bold"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">KES</span>
                                            <input asp-for="AmountPaid" class="form-control" type="number" min="0.01" required id="amountPaid" />
                                        </div>
                                        <div id="amountValidationMessage" class="mt-1"></div>
                                    </div>
                                </div>

                                <!-- Row 2 -->
                                <div class="row mb-3">
                                    <!-- Payment Method -->
                                    <div class="col-md-4">
                                        <label asp-for="PaymentMethod" class="form-label fw-bold"></label>
                                        <select asp-for="PaymentMethod" class="form-select" required id="PaymentMethod">
                                            <option value="">-- Select Method --</option>
                                            <option value="Cash">Cash</option>
                                            <option value="Bank Transfer">Bank Transfer</option>
                                            <option value="Cheque">Cheque</option>
                                            <option value="Mobile Money">Mobile Money</option>
                                            <option value="Payroll Deduction">Payroll Deduction</option>
                                        </select>
                                    </div>

                                    <!-- Reference -->
                                    <div class="col-md-4">
                                        <label asp-for="ReferenceNo" class="form-label"></label>
                                        <input asp-for="ReferenceNo" class="form-control" id="referenceNo" placeholder="Transaction ID, Cheque No, etc." />
                                    </div>

                                    <!-- Remarks -->
                                    <div class="col-md-4">
                                        <label asp-for="Remarks" class="form-label"></label>
                                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                                    </div>
                                </div>

                                <!-- Repayment Breakdown -->
                                <div class="row mb-3" id="breakdownSection" style="display: none;">
                                    <div class="col-md-12">
                                        <div class="breakdown-card">
                                            <h6 class="mb-3">Payment Breakdown</h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="breakdown-item">
                                                        <span class="breakdown-label">Principal Allocation</span>
                                                        <span class="breakdown-value principal" id="allocatedPrincipal">KES 0.00</span>
                                                    </div>
                                                    <div class="breakdown-item">
                                                        <span class="breakdown-label">Interest Allocation</span>
                                                        <span class="breakdown-value interest" id="allocatedInterest">KES 0.00</span>
                                                    </div>
                                                    <div class="breakdown-item">
                                                        <span class="breakdown-label">Penalty Allocation</span>
                                                        <span class="breakdown-value penalty" id="allocatedPenalty">KES 0.00</span>
                                                    </div>
                                                    <div class="breakdown-item">
                                                        <span class="breakdown-label"><strong>Total Allocated</strong></span>
                                                        <span class="breakdown-value total" id="totalAllocated">KES 0.00</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div>
                                                        <small class="text-muted">Allocation Distribution</small>
                                                        <div class="allocation-progress">
                                                            <div class="progress-bar principal-bar" id="principalProgress" style="width: 0%;">0%</div>
                                                            <div class="progress-bar interest-bar" id="interestProgress" style="width: 0%;">0%</div>
                                                            <div class="progress-bar penalty-bar" id="penaltyProgress" style="width: 0%;">0%</div>
                                                        </div>
                                                        <div class="d-flex justify-content-between mt-1">
                                                            <small><span class="text-primary">■</span> Principal</small>
                                                            <small><span class="text-success">■</span> Interest</small>
                                                            <small><span class="text-danger">■</span> Penalty</small>
                                                        </div>
                                                    </div>
                                                    <div class="mt-3">
                                                        <div class="breakdown-item">
                                                            <span class="breakdown-label">Overpayment</span>
                                                            <span class="breakdown-value" id="overpaymentDisplay" style="color: #ffc107;">KES 0.00</span>
                                                        </div>
                                                        <div class="breakdown-item">
                                                            <span class="breakdown-label">Balance After Payment</span>
                                                            <span class="breakdown-value" id="balanceAfterDisplay" style="color: #6f42c1;">KES 0.00</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- Warning Messages -->
                                            <div id="overpaymentMessage" class="overpayment-warning mt-2" style="display: none;">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                <span>This payment exceeds the outstanding balance. The excess (overpayment) will be recorded.</span>
                                            </div>
                                            <div id="exceedsBalanceMessage" class="exceeds-balance-error mt-2" style="display: none;">
                                                <i class="bi bi-x-circle-fill me-2"></i>
                                                <span>The payment amount exceeds the total outstanding balance. Please enter a lower amount.</span>
                                            </div>
                                            <div id="fullPaymentMessage" class="alert alert-success mt-2" style="display: none;">
                                                <i class="bi bi-check-circle-fill me-2"></i>
                                                <span>This payment will fully settle the loan!</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Print Receipt Checkbox -->
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="printReceipt" checked />
                                            <label class="form-check-label" for="printReceipt">
                                                <i class="fas fa-print"></i> Print receipt after repayment
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Buttons -->
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <div class="btn-group flex-wrap">
                                            <button type="button" class="btn btn-outline-primary btn-sm" id="fullBalanceBtn" disabled>
                                                <i class="bi bi-cash-stack me-1"></i> Pay Full Balance
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" id="roundedAmountBtn" disabled>
                                                <i class="bi bi-arrow-up-circle me-1"></i> Current Due
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" onclick="resetForm()">
                                Clear
                            </button>
                            <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                                <i class="bi bi-check-circle me-2"></i>Process Payment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const companyCode = '@companyCode';
        let selectedLoan = null;
        let currentMemberNo = null;
        let loansData = null;
        let totalDue = 0;
        let totalOutstandingBalance = 0;
        let isMemberSelected = false;
        let selectedMemberData = null;

        $(document).ready(function() {
            $('#glAccountSelect').on('change', function() {
                var selectedValue = $(this).val();
                $('#GlAccountNoHidden').val(selectedValue);
            });

            // Print receipt checkbox sync
            $('#printReceipt').on('change', function() {
                $('#printReceiptHidden').val(this.checked);
            });

            // Auto-search when typing (debounced)
            let searchTimeout;
            $('#searchInput').on('input', function() {
                clearTimeout(searchTimeout);
                const searchTerm = $(this).val().trim();
                if (searchTerm.length >= 3) {
                    searchTimeout = setTimeout(function() {
                        searchMembers();
                    }, 500);
                } else if (searchTerm.length === 0) {
                    clearSearch();
                }
            });

            // Search input enter key
            $('#searchInput').on('keypress', function(e) {
                if (e.key === 'Enter') {
                    searchMembers();
                }
            });

            // Amount validation on input
            $('#amountPaid').on('input', function() {
                if (selectedLoan) {
                    const amount = parseFloat($(this).val()) || 0;
                    validateAmount(amount);
                    if (amount > 0) {
                        calculateAllocation();
                    }
                }
            });

            $('#paymentDate').on('change', function() {
                if (selectedLoan && $('#amountPaid').val() > 0) {
                    calculateAllocation();
                }
            });

            // Update ChequeNumber when ReferenceNo changes
            $('#referenceNo').on('input', function() {
                $('#ChequeNumber').val($(this).val() || 'N/A');
            });
        });

        // ============================================================
        // AMOUNT VALIDATION
        // ============================================================
        function validateAmount(amount) {
            const msgContainer = document.getElementById('amountValidationMessage');
            const submitBtn = document.getElementById('submitBtn');
            const fullBalanceBtn = document.getElementById('fullBalanceBtn');

            if (amount <= 0) {
                msgContainer.innerHTML = '';
                submitBtn.disabled = true;
                return false;
            }

            // Check against total outstanding balance
            if (amount > totalOutstandingBalance + 0.01) {
                msgContainer.innerHTML = `
                    <div class="text-danger">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        Amount exceeds outstanding balance by KES ${(amount - totalOutstandingBalance).toFixed(2)}
                    </div>
                `;
                submitBtn.disabled = true;
                document.getElementById('exceedsBalanceMessage').style.display = 'block';
                document.getElementById('breakdownSection').style.display = 'none';
                return false;
            } else {
                msgContainer.innerHTML = '';
                submitBtn.disabled = false;
                document.getElementById('exceedsBalanceMessage').style.display = 'none';
                if (amount > 0) {
                    document.getElementById('breakdownSection').style.display = 'block';
                }
                return true;
            }
        }

        // ============================================================
        // SEARCH MEMBERS
        // ============================================================
        async function searchMembers() {
            const searchTerm = document.getElementById('searchInput').value.trim();

            if (searchTerm.length < 3) {
                Swal.fire('Warning', 'Please enter at least 3 characters to search', 'warning');
                return;
            }

            // Show loading
            document.getElementById('searchLoading').style.display = 'block';
            document.getElementById('searchResults').style.display = 'none';
            document.getElementById('searchResultsBody').innerHTML = '';

            try {
                const response = await fetch(`/api/Member/search?searchTerm=${encodeURIComponent(searchTerm)}`);

                if (!response.ok) {
                    throw new Error('Search failed');
                }

                const data = await response.json();

                if (data.success && data.data && data.data.length > 0) {
                    displaySearchResults(data.data);
                } else {
                    document.getElementById('searchResultsBody').innerHTML =
                        '<tr><td colspan="7" class="text-center text-warning">No members found matching your search</td></tr>';
                    document.getElementById('searchResults').style.display = 'block';
                    Swal.fire('Info', 'No members found matching your search', 'info');
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('searchResultsBody').innerHTML =
                    '<tr><td colspan="7" class="text-center text-danger">Error searching members. Please try again.</td></tr>';
                document.getElementById('searchResults').style.display = 'block';
                Swal.fire('Error', 'Error searching members', 'error');
            } finally {
                document.getElementById('searchLoading').style.display = 'none';
            }
        }

        // ============================================================
        // DISPLAY SEARCH RESULTS
        // ============================================================
        function displaySearchResults(members) {
            const tbody = document.getElementById('searchResultsBody');
            tbody.innerHTML = '';

            members.forEach(member => {
                const statusBadge = member.status == 1 ?
                    '<span class="badge bg-success">Active</span>' :
                    '<span class="badge bg-danger">Inactive</span>';

                const fullName = (member.surname || '') + ' ' + (member.otherNames || '');
                const phone = member.phoneNo || member.phone || 'N/A';

                const row = tbody.insertRow();
                row.innerHTML = `
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-success btn-select-member" onclick="selectMember('${member.memberNo}')">
                            <i class="bi bi-check-lg"></i> Select
                        </button>
                    </td>
                    <td><strong>${escapeHtml(member.memberNo)}</strong></td>
                    <td>${escapeHtml(fullName.trim() || member.memberNo)}</td>
                    <td>${escapeHtml(member.idno || 'N/A')}</td>
                    <td>${escapeHtml(phone)}</td>
                    <td>${statusBadge}</td>
                `;
            });

            document.getElementById('searchResults').style.display = 'block';
        }

        // ============================================================
        // SELECT MEMBER
        // ============================================================
        function selectMember(memberNo) {
            document.getElementById('selectedMemberNoDisplay').innerHTML = memberNo;
            document.getElementById('selectedMemberCard').style.display = 'block';
            document.getElementById('searchResults').style.display = 'none';
            document.getElementById('searchInput').value = '';
            currentMemberNo = memberNo;
            isMemberSelected = true;

            fetch(`/api/Member/${memberNo}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.data) {
                        selectedMemberData = data.data;
                        const fullName = (data.data.surname || '') + ' ' + (data.data.otherNames || '');
                        document.getElementById('selectedMemberName').innerHTML =
                            `<strong>${escapeHtml(fullName.trim() || memberNo)}</strong>`;
                        document.getElementById('selectedMemberIdNo').innerHTML = data.data.idno || 'N/A';
                        document.getElementById('selectedMemberPhone').innerHTML = data.data.phoneNo || data.data.phone || 'N/A';
                        document.getElementById('selectedMemberNoDisplay').innerHTML = memberNo;

                        loadMemberLoans();
                    }
                })
                .catch(error => {
                    console.error('Error fetching member details:', error);
                    Swal.fire('Error', 'Error fetching member details', 'error');
                });
        }

        // ============================================================
        // LOAD MEMBER LOANS
        // ============================================================
        async function loadMemberLoans() {
            if (!currentMemberNo) {
                Swal.fire('Error', 'Please select a member first', 'error');
                return;
            }

            document.getElementById('resultsSection').classList.remove('d-none');
            document.getElementById('loansTableBody').innerHTML = `
                <tr>
                    <td colspan="8" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading loans for member...</p>
                    </td>
                </tr>
            `;

            try {
                const response = await fetch(`/LoanMvc/GetActiveLoans?companyCode=${encodeURIComponent(companyCode)}&memberNo=${encodeURIComponent(currentMemberNo)}`);
                const data = await response.json();

                if (data.success && data.loans && data.loans.length > 0) {
                    loansData = data.loans;
                    displaySearchResultsWithLoans(data);
                } else {
                    document.getElementById('loansTableBody').innerHTML = `
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle me-2"></i>
                                No active loans found for this member
                            </td>
                        </tr>
                    `;
                    Swal.fire('Info', 'No active loans found for this member', 'info');
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('loansTableBody').innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center text-danger py-4">
                            Error loading loans. Please try again.
                        </td>
                    </tr>
                `;
                Swal.fire('Error', 'Error loading loans', 'error');
            }
        }

        // ============================================================
        // DISPLAY SEARCH RESULTS WITH LOANS
        // ============================================================
        function displaySearchResultsWithLoans(data) {
            document.getElementById('resultsSection').classList.remove('d-none');

            const memberInfo = document.getElementById('memberInfo');
            memberInfo.className = 'alert alert-success mb-3';
            document.getElementById('memberName').innerHTML = `<strong>Member:</strong> ${data.memberName || 'N/A'}`;
            document.getElementById('memberDetails').innerHTML = `
                <div class="row">
                    <div class="col-md-3">
                        <small><strong>Member No:</strong> ${data.memberNo || 'N/A'}</small>
                    </div>
                    <div class="col-md-3">
                        <small><strong>ID No:</strong> ${data.idNo || 'N/A'}</small>
                    </div>
                    <div class="col-md-3">
                        <small><strong>Phone:</strong> ${data.phone || 'N/A'}</small>
                    </div>
                    <div class="col-md-3">
                        <small><strong>Email:</strong> ${data.email || 'N/A'}</small>
                    </div>
                </div>
                <div class="mt-2">
                    <small><strong>Active Loans Found:</strong> ${data.loans.length}</small>
                </div>
            `;

            const tableBody = document.getElementById('loansTableBody');
            tableBody.innerHTML = '';

            if (data.loans && data.loans.length > 0) {
                data.loans.forEach((loan, index) => {
                    const isOverdue = loan.daysSinceLastPayment > 30;
                    const row = `
                        <tr id="loanRow_${loan.loanNo}">
                            <td>
                                <button type="button" class="btn btn-sm btn-primary w-100" onclick="selectLoan('${loan.loanNo}', ${index})">
                                    <i class="bi bi-cash-stack me-1"></i> Select & Repay
                                </button>
                            </td>
                            <td><strong>${loan.loanNo}</strong>${isOverdue ? '<br><span class="badge bg-danger mt-1">OVERDUE</span>' : ''}</td>
                            <td>${loan.loanType || 'N/A'}</td>
                            <td>
                                KES ${(loan.outstandingPrincipal || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}
                            </td>
                            <td>
                                KES ${(loan.outstandingInterest || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}
                            </td>
                            <td>
                                KES ${(loan.outstandingPenalty || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}
                            </td>
                            <td>
                                KES ${(loan.totalOutstanding || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}
                            </td>
                            <td>
                                <span class="badge ${isOverdue ? 'bg-danger' : 'bg-info'}">
                                    ${loan.daysSinceLastPayment || 0} days
                                </span>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            } else {
                tableBody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No active loans found</td></tr>';
            }
        }

        // ============================================================
        // SELECT LOAN
        // ============================================================
        function selectLoan(loanNo, index) {
            const loan = loansData[index];

            if (!loan) {
                alert('Loan data not found');
                return;
            }

            selectedLoan = {
                loanNo: loan.loanNo,
                loanType: loan.loanType,
                currentInstallmentPrincipal: parseFloat(loan.outstandingPrincipal) || 0,
                currentInstallmentInterest: parseFloat(loan.outstandingInterest) || 0,
                currentInstallmentPenalty: parseFloat(loan.outstandingPenalty) || 0,
                currentInstallmentTotal: parseFloat(loan.totalOutstanding) || 0,
                nextInstallmentAmount: parseFloat(loan.nextInstallmentAmount) || 0,
                dueDate: loan.dueDate,
                daysSinceLastPayment: parseInt(loan.daysSinceLastPayment) || 0,
                disbursementDate: loan.disbursementDate,
                repayMethod: loan.repayMethod || 'AMT',
                installmentNo: loan.installmentNo || 1,
                totalPrincipalBalance: parseFloat(loan.totalPrincipalBalance) || 0,
                totalInterestBalance: parseFloat(loan.totalInterestBalance) || 0
            };

            // Calculate total outstanding balance
            const totalRemainingPrincipal = selectedLoan.totalPrincipalBalance;
            const totalRemainingInterest = selectedLoan.totalInterestBalance;
            const totalRemainingPenalty = selectedLoan.currentInstallmentPenalty;
            totalOutstandingBalance = totalRemainingPrincipal + totalRemainingInterest + totalRemainingPenalty;

            const currentInstallmentDue = selectedLoan.currentInstallmentTotal;

            document.getElementById('LoanNo').value = selectedLoan.loanNo;
            document.getElementById('MemberNo').value = currentMemberNo;

            document.querySelectorAll('#loansTableBody tr').forEach(row => {
                row.classList.remove('table-primary');
            });
            const selectedRow = document.getElementById(`loanRow_${loanNo}`);
            if (selectedRow) {
                selectedRow.classList.add('table-primary');
            }

            // Update total due display
            document.getElementById('totalDueDisplay').innerHTML = `
                <div class="d-flex justify-content-between align-items-center w-100">
                    <span>Current Installment Due:</span>
                    <strong class="fs-5">KES ${currentInstallmentDue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center w-100 mt-1">
                    <span class="text-light-emphasis">Total Outstanding Balance:</span>
                    <strong class="fs-4">KES ${totalOutstandingBalance.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</strong>
                </div>
            `;

            // Update balance info
            document.getElementById('principalBalanceDisplay').textContent =
                `KES ${totalRemainingPrincipal.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById('interestBalanceDisplay').textContent =
                `KES ${totalRemainingInterest.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById('penaltyBalanceDisplay').textContent =
                `KES ${totalRemainingPenalty.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

            // Update quick buttons
            document.getElementById('fullBalanceBtn').disabled = false;
            document.getElementById('roundedAmountBtn').disabled = false;

            document.getElementById('fullBalanceBtn').onclick = function() {
                setAmount(totalOutstandingBalance);
            };
            document.getElementById('roundedAmountBtn').onclick = function() {
                const roundedCurrentDue = Math.ceil(currentInstallmentDue);
                setAmount(roundedCurrentDue);
            };

            document.getElementById('paymentSection').classList.remove('d-none');
            document.getElementById('submitBtn').disabled = true; // Disabled until valid amount entered

            document.getElementById('paymentSection').scrollIntoView({ behavior: 'smooth', block: 'start' });

            // Reset amount and breakdown
            document.getElementById('amountPaid').value = '';
            document.getElementById('breakdownSection').style.display = 'none';
            document.getElementById('amountValidationMessage').innerHTML = '';
            document.getElementById('exceedsBalanceMessage').style.display = 'none';
            document.getElementById('overpaymentMessage').style.display = 'none';
            document.getElementById('fullPaymentMessage').style.display = 'none';
        }

        // ============================================================
        // CALCULATE ALLOCATION
        // ============================================================
        async function calculateAllocation() {
            if (!selectedLoan) return;

            const amount = parseFloat(document.getElementById('amountPaid').value) || 0;
            const paymentDate = document.getElementById('PaymentDate').value;

            if (amount <= 0) {
                resetAllocationDisplay();
                return;
            }

            // Validate amount first
            if (!validateAmount(amount)) {
                return;
            }

            try {
                const response = await fetch(`/LoanMvc/CalculateRepayment?loanNo=${selectedLoan.loanNo}&amount=${amount}&paymentDate=${paymentDate}`);
                const result = await response.json();

                if (result.success) {
                    const data = result.data;
                    const totalAllocated = data.penaltyAllocated + data.interestAllocated + data.principalAllocated;

                    // Update breakdown display
                    document.getElementById('allocatedPenalty').textContent =
                        `KES ${data.penaltyAllocated.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    document.getElementById('allocatedInterest').textContent =
                        `KES ${data.interestAllocated.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    document.getElementById('allocatedPrincipal').textContent =
                        `KES ${data.principalAllocated.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    document.getElementById('totalAllocated').textContent =
                        `KES ${totalAllocated.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    document.getElementById('overpaymentDisplay').textContent =
                        `KES ${data.overpayment.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    document.getElementById('balanceAfterDisplay').textContent =
                        `KES ${data.balanceAfter.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

                    // Update progress bars
                    if (amount > 0) {
                        const penaltyPct = (data.penaltyAllocated / amount) * 100;
                        const interestPct = (data.interestAllocated / amount) * 100;
                        const principalPct = (data.principalAllocated / amount) * 100;

                        document.getElementById('penaltyProgress').style.width = `${penaltyPct}%`;
                        document.getElementById('penaltyProgress').textContent = `${penaltyPct.toFixed(0)}%`;
                        document.getElementById('interestProgress').style.width = `${interestPct}%`;
                        document.getElementById('interestProgress').textContent = `${interestPct.toFixed(0)}%`;
                        document.getElementById('principalProgress').style.width = `${principalPct}%`;
                        document.getElementById('principalProgress').textContent = `${principalPct.toFixed(0)}%`;
                    }

                    // Show/hide messages
                    document.getElementById('breakdownSection').style.display = 'block';
                    document.getElementById('exceedsBalanceMessage').style.display = 'none';

                    const overpaymentMsg = document.getElementById('overpaymentMessage');
                    if (data.overpayment > 0.01) {
                        overpaymentMsg.style.display = 'block';
                    } else {
                        overpaymentMsg.style.display = 'none';
                    }

                    const fullPaymentMsg = document.getElementById('fullPaymentMessage');
                    if (data.balanceAfter <= 0.01) {
                        fullPaymentMsg.style.display = 'block';
                    } else {
                        fullPaymentMsg.style.display = 'none';
                    }

                    // Enable submit button if amount is valid
                    document.getElementById('submitBtn').disabled = false;
                }
            } catch (error) {
                console.error('Error calculating allocation:', error);
            }
        }

        // ============================================================
        // RESET ALLOCATION DISPLAY
        // ============================================================
        function resetAllocationDisplay() {
            document.getElementById('allocatedPenalty').textContent = 'KES 0.00';
            document.getElementById('allocatedInterest').textContent = 'KES 0.00';
            document.getElementById('allocatedPrincipal').textContent = 'KES 0.00';
            document.getElementById('totalAllocated').textContent = 'KES 0.00';
            document.getElementById('overpaymentDisplay').textContent = 'KES 0.00';
            document.getElementById('balanceAfterDisplay').textContent = 'KES 0.00';

            document.getElementById('penaltyProgress').style.width = '0%';
            document.getElementById('penaltyProgress').textContent = '0%';
            document.getElementById('interestProgress').style.width = '0%';
            document.getElementById('interestProgress').textContent = '0%';
            document.getElementById('principalProgress').style.width = '0%';
            document.getElementById('principalProgress').textContent = '0%';

            document.getElementById('fullPaymentMessage').style.display = 'none';
            document.getElementById('overpaymentMessage').style.display = 'none';
            document.getElementById('exceedsBalanceMessage').style.display = 'none';
            document.getElementById('amountValidationMessage').innerHTML = '';
        }

        // ============================================================
        // SET AMOUNT
        // ============================================================
        function setAmount(amount) {
            document.getElementById('amountPaid').value = amount.toFixed(2);
            validateAmount(amount);
            if (amount > 0) {
                calculateAllocation();
            }
        }

        // ============================================================
        // CLEAR SELECTED MEMBER
        // ============================================================
        function clearSelectedMember() {
            currentMemberNo = null;
            selectedMemberData = null;
            isMemberSelected = false;
            selectedLoan = null;
            loansData = null;
            totalOutstandingBalance = 0;

            document.getElementById('selectedMemberCard').style.display = 'none';
            document.getElementById('resultsSection').classList.add('d-none');
            document.getElementById('paymentSection').classList.add('d-none');
            document.getElementById('loansTableBody').innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-search me-2"></i>Search for a loan to see results</td></tr>';
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('fullBalanceBtn').disabled = true;
            document.getElementById('roundedAmountBtn').disabled = true;
            document.getElementById('amountPaid').value = '';
            document.getElementById('LoanNo').value = '';
            document.getElementById('MemberNo').value = '';
            document.getElementById('GlAccountNoHidden').value = '';
            $('#glAccountSelect').val('');
            resetAllocationDisplay();
            document.getElementById('breakdownSection').style.display = 'none';
            document.getElementById('amountValidationMessage').innerHTML = '';
        }

        // ============================================================
        // CLEAR SEARCH
        // ============================================================
        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResults').style.display = 'none';
            document.getElementById('searchResultsBody').innerHTML = '';
            clearSelectedMember();
        }

        // ============================================================
        // RESET FORM
        // ============================================================
        function resetForm() {
            clearSelectedMember();
            clearSearch();
        }

        // ============================================================
        // ESCAPE HTML
        // ============================================================
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ============================================================
        // FORM SUBMIT VALIDATION
        // ============================================================
        $('#repaymentForm').on('submit', function(e) {
            var amount = parseFloat($('#amountPaid').val()) || 0;
            var loanNo = $('#LoanNo').val();
            var glAccount = $('#GlAccountNoHidden').val();
            var glAccountText = $('#glAccountSelect option:selected').text();
            var paymentMethod = $('#PaymentMethod').val();
            var paymentMethodText = $('#PaymentMethod option:selected').text();
            var overpayment = parseFloat(document.getElementById('overpaymentDisplay').textContent.replace(/[^0-9.-]/g, '')) || 0;
            var balanceAfter = parseFloat(document.getElementById('balanceAfterDisplay').textContent.replace(/[^0-9.-]/g, '')) || 0;

            if (!loanNo) {
                e.preventDefault();
                alert('Please select a loan to repay');
                return false;
            }

            if (!glAccount) {
                e.preventDefault();
                alert('Please select a GL Account');
                return false;
            }

            if (!paymentMethod) {
                e.preventDefault();
                alert('Please select a payment method');
                return false;
            }

            if (amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount');
                return false;
            }

            // Check if amount exceeds outstanding balance (final validation)
            if (amount > totalOutstandingBalance + 0.01) {
                e.preventDefault();
                alert(`Payment amount (KES ${amount.toFixed(2)}) exceeds total outstanding balance (KES ${totalOutstandingBalance.toFixed(2)}). Please enter a lower amount.`);
                return false;
            }

            var message = `Confirm payment details:\n\n`;
            message += `Loan Number: ${loanNo}\n`;
            message += `Payment Amount: KES ${amount.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}\n`;
            message += `GL Account: ${glAccountText}\n`;
            message += `Payment Method: ${paymentMethodText}\n\n`;
            message += `Breakdown:\n`;
            message += `  Principal: KES ${document.getElementById('allocatedPrincipal').textContent.replace(/[^0-9.-]/g, '').trim() || '0.00'}\n`;
            message += `  Interest: KES ${document.getElementById('allocatedInterest').textContent.replace(/[^0-9.-]/g, '').trim() || '0.00'}\n`;
            message += `  Penalty: KES ${document.getElementById('allocatedPenalty').textContent.replace(/[^0-9.-]/g, '').trim() || '0.00'}\n`;

            if (overpayment > 0) {
                message += `\n⚠️ Overpayment: KES ${overpayment.toFixed(2)}\n`;
                message += `This excess amount will be recorded as overpayment.\n`;
            }

            message += `\nAfter payment, balance will be: KES ${balanceAfter.toFixed(2)}\n\n`;
            message += `This action cannot be undone.`;

            return confirm(message);
        });
    </script>
}