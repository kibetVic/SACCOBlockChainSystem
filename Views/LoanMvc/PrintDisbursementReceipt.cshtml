﻿@using SACCOBlockChainSystem.Models.ViewModels
@model DisbursementReceiptViewModel

@{
    ViewData["Title"] = "Disbursement Receipt";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Disbursement Receipt - @Model.ReceiptNo</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6f9;
            font-size: 13px;
        }

        /* SCREEN VIEW */
        .receipt-container {
            max-width: 650px;
            margin: 20px auto;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }

        .receipt-header {
            background: #007bff;
            color: #fff;
            text-align: center;
            padding: 15px;
        }

        .receipt-title {
            font-size: 22px;
            font-weight: bold;
        }

        .receipt-subtitle {
            font-size: 12px;
        }

        .company-details-header {
            background: #f8f9fa;
            text-align: center;
            padding: 10px;
            border-bottom: 2px solid #007bff;
        }

        .company-name {
            font-weight: bold;
            color: #007bff;
        }

        .receipt-body {
            padding: 15px;
        }

        .info-row {
            margin-bottom: 12px;
            border-bottom: 1px solid #eee;
            padding-bottom: 8px;
        }

        .info-label {
            font-weight: 600;
            color: #666;
            font-size: 11px;
        }

        .info-value {
            font-size: 13px;
        }

        .method-details {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 6px;
            margin: 10px 0;
        }

        .disbursement-table {
            width: 100%;
        }

            .disbursement-table td {
                padding: 4px 0;
            }

        .receipt-footer {
            background: #f8f9fa;
            text-align: center;
            padding: 10px;
            font-size: 11px;
            border-top: 1px solid #ddd;
        }

        .btn-print {
            position: fixed;
            bottom: 20px;
            right: 20px;
        }

        @@media print {

            @@page {
                size: 70mm auto;
                margin: 5mm;
            }

            html, body {
                width: 70mm !important;
                font-size: 12px !important;
                background: #fff !important;
            }

            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .receipt-container {
                width: 100% !important;
                padding: 5px !important;
            }
            /* FIX HEADER PRINT */
            .receipt-header {
                background: #000 !important;
                color: #fff !important;
                border: 1px solid #000 !important;
            }

            .receipt-title,
            .receipt-subtitle {
                color: #fff !important;
            }

            .receipt-no {
                font-size: 14px !important;
                font-weight: bold !important;
            }

            .info-row {
                margin-bottom: 12px !important;
            }

            .disbursement-table td {
                padding: 6px 0 !important;
            }
        }
    </style>
</head>

<body>

    <!-- Buttons -->
    <div class="no-print text-center mb-3">
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fas fa-print"></i> Print / Save PDF
        </button>
        <button onclick="goBack()" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </button>
    </div>

    <div class="receipt-container">

        <!-- HEADER -->
        <div class="receipt-header">
            <div class="receipt-title">LOAN DISBURSEMENT RECEIPT</div>
            <div class="receipt-subtitle">Funds Release Confirmation</div>
        </div>

        <!-- COMPANY -->
        <div class="company-details-header">
            <div class="company-name">@Model.CompanyName</div>
            <div>@Model.CompanyAddress</div>
            <div>Tel: @Model.CompanyPhone | Email: @Model.CompanyEmail</div>
        </div>

        <!-- BODY -->
        <div class="receipt-body">

            <!-- Receipt No -->
            <div class="text-center mb-2">
                <span class="badge bg-primary">Voucher No: @Model.ReceiptNo</span>
            </div>

            <!-- MEMBER INFO -->
            <div class="info-row">
                <div class="info-label">Member Details</div>
                <div class="info-value">
                    Name: @Model.MemberName<br />
                    Member No: @Model.MemberNo<br />
                    @if (!string.IsNullOrEmpty(Model.MemberIdNo) && Model.MemberIdNo != "N/A")
                    {
                        <text>ID No: @Model.MemberIdNo<br /></text>
                    }
                    Loan No: @Model.LoanNo
                </div>
            </div>

            <!-- DISBURSEMENT METHOD (DYNAMIC) -->
            @if (Model.DisbursementMethod == "MPESA" || Model.DisbursementMethod == "M-Pesa")
            {
                <div class="method-details">
                    <strong>M-PESA</strong><br />
                    Mobile Number: @Model.MemberPhone<br />
                    Recipient Name: @Model.MemberName<br />
                    Transaction Status: Completed
                </div>
            }
            else if (Model.DisbursementMethod == "BANK_TRANSFER" || Model.DisbursementMethod == "Bank Transfer")
            {
                <div class="method-details">
                    <strong>BANK TRANSFER</strong><br />
                    Bank Name: @Model.BankName<br />
                    @if (!string.IsNullOrEmpty(Model.ReferenceNo))
                    {
                        <text>Reference Number: @Model.ReferenceNo<br /></text>
                    }
                    Transfer Status: Processed
                </div>
            }
            else if (Model.DisbursementMethod == "CHEQUE" || Model.DisbursementMethod == "Cheque")
            {
                <div class="method-details">
                    <strong>CHEQUE PAYMENT</strong><br />
                    Cheque Number: @Model.ReferenceNo<br />
                    Cheque Amount: KES @Model.NetAmount.ToString("N2")<br />
                    Payable To: @Model.MemberName
                </div>
            }
            else if (Model.DisbursementMethod == "CASH" || Model.DisbursementMethod == "Cash")
            {
                <div class="method-details">
                    <strong>CASH PAYMENT</strong><br />
                    Received By: @Model.MemberName<br />
                    @if (!string.IsNullOrEmpty(Model.MemberIdNo) && Model.MemberIdNo != "N/A")
                    {
                        <text>ID Number: @Model.MemberIdNo<br /></text>
                    }
                    Payment Status: Paid
                </div>
            }

            <!-- DISBURSEMENT BREAKDOWN -->
            <div class="info-row">
                <div class="info-label">Disbursement Breakdown</div>
                <table class="disbursement-table">
                    <tr>
                        <td>Approved Amount</td>
                        <td class="text-end">KES @Model.ApprovedAmount.ToString("N2")</td>
                    </tr>
                    @if (Model.TotalDeductions > 0)
                    {
                        <tr>
                            <td>Total Deductions</td>
                            <td class="text-end text-danger">- KES @Model.TotalDeductions.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="fw-bold border-top">
                        <td>Net Amount Disbursed</td>
                        <td class="text-end">KES @Model.NetAmount.ToString("N2")</td>
                    </tr>
                </table>
            </div>

            <!-- DISBURSEMENT DATE -->
            <div class="info-row">
                <div class="info-label">Disbursement Date</div>
                <div class="info-value">
                    @Model.DisbursementDate.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>

        </div>

        <!-- FOOTER -->
        <div class="receipt-footer">
            <div>Disbursed by: @Model.DisbursedBy</div>
            <div>Printed: @Model.PrintedAt.ToString("dd MMM yyyy HH:mm")</div>
            <div>This is a system generated receipt.</div>
            <div class="mt-1"><i class="fas fa-shield-alt"></i> Verified on Blockchain</div>
        </div>

    </div>

    <!-- Floating button -->
    <div class="btn-print no-print">
        <button onclick="window.print()" class="btn btn-primary" style="width:60px;height:60px;">
            <i class="fas fa-print"></i>
        </button>
    </div>

    <script>
        function goBack() {
            window.history.back();
        }
    </script>

</body>
</html>