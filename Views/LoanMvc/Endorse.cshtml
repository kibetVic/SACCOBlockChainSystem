@model SACCOBlockChainSystem.Models.DTOs.LoanEndorsementDTO
@{
    ViewData["Title"] = "Loan Endorsement";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loan = ViewBag.Loan as SACCOBlockChainSystem.Models.Loan;
    var grossAmount = ViewBag.GrossAmount as decimal? ?? 0;
    var allGlAccounts = ViewBag.AllGlAccounts as IEnumerable<dynamic> ?? new List<dynamic>();
}


<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center">
                <a asp-action="PendingEndorsement" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
                <h2 class="page-title mb-0">
                    <i class="bi bi-calculator me-2"></i>Loan Endorsement
                </h2>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Endorsement Details</h5>
                </div>
                <div class="card-body">
                    <!-- Loan Information Summary -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="bg-light p-3 rounded text-center">
                                <small class="text-muted">Loan Number</small>
                                <h5 class="mb-0">@loan?.LoanNo</h5>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-light p-3 rounded text-center">
                                <small class="text-muted">Member</small>
                                <h5 class="mb-0">@loan?.MemberNo</h5>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-light p-3 rounded text-center">
                                <small class="text-muted">Approved Amount</small>
                                <h5 class="mb-0 text-primary">KES @grossAmount.ToString("N0")</h5>
                            </div>
                        </div>
                    </div>

                    <!-- Checkboxes for Endorsement Decision - Place this after the Loan Information Summary -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <i class="bi bi-check-circle me-2"></i>Endorsement Decision
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="acceptCheckbox" checked>
                                                <label class="form-check-label fw-bold text-success" for="acceptCheckbox">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Accept Endorsement
                                                </label>
                                                <small class="text-muted d-block mt-1">
                                                    Approve the loan for disbursement (GL transactions will be created)
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="rejectCheckbox">
                                                <label class="form-check-label fw-bold text-danger" for="rejectCheckbox">
                                                    <i class="bi bi-x-circle-fill me-1"></i> Reject Endorsement
                                                </label>
                                                <small class="text-muted d-block mt-1">
                                                    Reject the loan - No deductions or GL transactions will be created
                                                </small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hidden field to store the actual boolean value -->
                                    <input type="hidden" asp-for="IsAccepted" id="IsAcceptedHidden" value="true" />

                                    <!-- Rejection Reason Section (shown only when reject is checked) -->
                                    <div id="rejectionReasonDiv" style="display: none;" class="mt-3 p-3 border rounded bg-light">
                                        <label asp-for="Remarks" class="form-label fw-bold text-danger">Rejection Reason *</label>
                                        <textarea asp-for="Remarks" class="form-control" rows="3"
                                                  placeholder="Please provide a detailed reason for rejecting this loan endorsement..."></textarea>
                                        <small class="text-muted mt-1 d-block">
                                            <i class="bi bi-exclamation-triangle"></i> This reason will be recorded in the audit trail and blockchain
                                        </small>
                                    </div>

                                    <!-- Warning when rejected -->
                                    <div id="rejectionWarningDiv" style="display: none;" class="mt-3 alert alert-warning">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        <strong>Warning:</strong> When you reject this endorsement:
                                        <ul class="mt-2 mb-0">
                                            <li>No deductions or GL transactions will be created</li>
                                            <li>No cheque will be generated</li>
                                            <li>The loan will be marked as <strong>Rejected</strong></li>
                                            <li>The rejection reason will be recorded in the blockchain</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    
                    <form asp-action="Endorse" method="post" id="endorsementForm" onsubmit="return window.validateForm()">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="LoanNo" />
                        <input type="hidden" asp-for="CompanyCode" />
                        <input type="hidden" asp-for="EndorsedBy" />
                        <input type="hidden" asp-for="EndorsementDate" value="@DateTime.Now" />
                        <input type="hidden" asp-for="SourceAccountNo" id="sourceAccountNo" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- WRAP THE ENTIRE DEDUCTIONS SECTION IN A DIV -->
                        <div id="deductionsWrapper">
                            <h6 class="text-uppercase text-muted mb-3">Deductions/Charges</h6>
                            <p class="text-muted mb-3">
                                <i class="bi bi-info-circle"></i>
                                For each deduction, select the income account where the money will go.
                                These accounts will be DEBITED (money goes TO here).
                            </p>

                            <div class="table-responsive">
                                <table class="table table-bordered" id="deductionsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 15%">Deduction Type</th>
                                            <th style="width: 30%">Income Account (Destination)</th>
                                            <th style="width: 15%">Amount (KES)</th>
                                            <th style="width: 15%">Percentage (%)</th>
                                            <th style="width: 20%">Description</th>
                                            <th style="width: 5%"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Deductions.Count; i++)
                                        {
                                            var deduction = Model.Deductions[i];
                                            <tr class="deduction-row" data-index="@i">
                                                <td class="align-middle">
                                                    <input type="hidden" name="Deductions[@i].DeductionCode" value="@deduction.DeductionCode" />
                                                    <input type="hidden" name="Deductions[@i].DeductionName" value="@deduction.DeductionName" />
                                                    <input type="hidden" name="Deductions[@i].IsMandatory" value="@deduction.IsMandatory.ToString().ToLower()" />
                                                    <input type="hidden" name="Deductions[@i].IsPercentage" id="IsPercentage_@i" value="@deduction.IsPercentage.ToString().ToLower()" />
                                                    <input type="hidden" name="Deductions[@i].PercentageValue" id="PercentageValue_@i" value="@deduction.PercentageValue" />
                                                    <strong>@deduction.DeductionName</strong>
                                                    @if (deduction.IsMandatory)
                                                    {
                                                        <span class="badge bg-danger ms-1">Mandatory</span>
                                                    }
                                                </td>
                                                <td class="align-middle">
                                                    <select name="Deductions[@i].GlAccountNo"
                                                            class="form-select form-select-sm deduction-account"
                                                            data-index="@i"
                                                            onchange="updateGlAccountName(@i, this.value)">
                                                        <option value="">-- Select Income Account --</option>
                                                        @foreach (var account in allGlAccounts)
                                                        {
                                                            <option value="@account.AccountNo"
                                                                    data-account-name="@account.AccountName"
                                                                    selected="@(deduction.GlAccountNo == account.AccountNo ? "selected" : null)">
                                                                @account.DisplayText
                                                            </option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="Deductions[@i].GlAccountName" id="GlAccountName_@i" value="@deduction.GlAccountName" />
                                                </td>
                                                <td class="align-middle">
                                                    <input type="number"
                                                           name="Deductions[@i].Amount"
                                                           class="form-control deduction-amount"
                                                           id="Amount_@i"
                                                           value="@deduction.Amount"
                                                           min="0"
                                                           step="any"
                                                           placeholder="Enter amount"
                                                           onchange="updateTotals()" />
                                                </td>
                                                <td class="align-middle">
                                                    <div class="input-group input-group-sm">
                                                        <input type="number"
                                                               class="form-control deduction-percentage"
                                                               id="PercentageInput_@i"
                                                               value="@(deduction.IsPercentage? deduction.PercentageValue: 0)"
                                                               min="0"
                                                               max="100"
                                                               step="0.01"
                                                               placeholder="%"
                                                               @(deduction.IsPercentage ? "" : "disabled")
                                                               onchange="calculatePercentageAmount(@i)" />
                                                        <button type="button"
                                                                class="btn btn-outline-secondary toggle-percentage"
                                                                data-index="@i"
                                                                onclick="togglePercentageMode(@i)"
                                                                title="Toggle between fixed amount and percentage">
                                                            <i class="bi bi-percent"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="align-middle">
                                                    <input type="text"
                                                           name="Deductions[@i].Description"
                                                           class="form-control form-control-sm"
                                                           value="@deduction.Description" />
                                                </td>
                                                <td class="align-middle text-center">
                                                    @if (!deduction.IsMandatory)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-danger remove-deduction" data-index="@i" title="Remove">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="addCustomDeductionBtn">
                                    <i class="bi bi-plus-circle"></i> Add Custom Deduction
                                </button>
                            </div>

                            <div class="row mt-4">
                                <!-- LEFT SIDE: Remarks -->
                                <div class="col-md-6 mb-4">
                                    <label asp-for="Remarks" class="form-label fw-bold">Remarks</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="5"
                                              placeholder="Enter any remarks about the endorsement"></textarea>
                                </div>

                                <!-- RIGHT SIDE: Summary Table -->
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold">Endorsement Summary</h6>
                                            <table class="table table-borderless mb-0">
                                                <tr>
                                                    <td><strong>Gross Amount:</strong></td>
                                                    <td class="text-end">
                                                        KES
                                                        <span id="grossAmountDisplay">@grossAmount.ToString("N2")</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Total Deductions:</strong></td>
                                                    <td class="text-end text-danger">
                                                        KES
                                                        <span id="totalDeductions">0.00</span>
                                                    </td>
                                                </tr>
                                                <tr class="border-top">
                                                    <td><strong>Net Amount:</strong></td>
                                                    <td class="text-end fw-bold text-primary">
                                                        KES
                                                        <span id="netAmount">0.00</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="PendingEndorsement" class="btn btn-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="bi bi-check-circle me-2"></i>Create Endorsement
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Instructions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-success small">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <strong>GL Account Explanation:</strong>
                        <ul class="mt-2 mb-0">
                            <li><strong>Income Account (Deduction):</strong> Where fees go TO - DEBIT entry</li>
                            <li>The source account (where money comes FROM) will be automatically determined</li>
                        </ul>
                    </div>
                    <div class="alert alert-warning small">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Important:</strong>
                        <ul class="mt-2 mb-0">
                            <li>For each deduction with amount > 0, select an income account</li>
                            <li>Net amount cannot be negative</li>
                            <li>All deductions with amount > 0 require an income account</li>
                            <li>Use percentage mode for interest-based calculations</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var grossAmount = @grossAmount;
        var deductionCounter = @Model.Deductions.Count;

        // Function to update GL Account Name
        function updateGlAccountName(index, accountNo) {
            var accountName = '';

            // Find the selected account name from the dropdown
            var selectElement = document.querySelector(`select[name="Deductions[${index}].GlAccountNo"]`);
            if (selectElement && selectElement.selectedIndex > 0) {
                var selectedOption = selectElement.options[selectElement.selectedIndex];
                accountName = selectedOption.getAttribute('data-account-name') || selectedOption.textContent.split(' - ')[1] || '';
            }

            // Update the hidden field
            var hiddenField = document.getElementById(`GlAccountName_${index}`);
            if (hiddenField) {
                hiddenField.value = accountName;
            }

            // Also update the validation
            validateForm();
        }

        // Function to toggle between fixed amount and percentage mode
        function togglePercentageMode(index) {
            var isPercentageField = document.getElementById(`IsPercentage_${index}`);
            var percentageInput = document.getElementById(`PercentageInput_${index}`);
            var amountInput = document.getElementById(`Amount_${index}`);
            var percentageValueField = document.getElementById(`PercentageValue_${index}`);

            if (isPercentageField && isPercentageField.value === 'true') {
                // Switch to fixed amount mode
                isPercentageField.value = 'false';
                percentageInput.disabled = true;
                percentageInput.value = '';
                percentageValueField.value = '';
                amountInput.disabled = false;
                amountInput.value = 0;
                // Trigger change event to update totals
                amountInput.dispatchEvent(new Event('change'));
            } else {
                // Switch to percentage mode
                isPercentageField.value = 'true';
                percentageInput.disabled = false;
                amountInput.disabled = true;
                amountInput.value = 0;
                // Calculate percentage if percentage input has value
                if (percentageInput.value && parseFloat(percentageInput.value) > 0) {
                    calculatePercentageAmount(index);
                } else {
                    updateTotals();
                }
            }
        }

        // Function to calculate amount from percentage
        function calculatePercentageAmount(index) {
            var isPercentageField = document.getElementById(`IsPercentage_${index}`);
            if (isPercentageField && isPercentageField.value === 'true') {
                var percentageInput = document.getElementById(`PercentageInput_${index}`);
                var amountInput = document.getElementById(`Amount_${index}`);
                var percentageValueField = document.getElementById(`PercentageValue_${index}`);

                var percentage = parseFloat(percentageInput.value) || 0;
                if (percentage > 100) {
                    percentage = 100;
                    percentageInput.value = 100;
                }
                if (percentage < 0) {
                    percentage = 0;
                    percentageInput.value = 0;
                }

                var calculatedAmount = (grossAmount * percentage) / 100;
                amountInput.value = calculatedAmount.toFixed(2);
                percentageValueField.value = percentage;

                // IMPORTANT: Trigger change event to update totals
                amountInput.dispatchEvent(new Event('change'));

                // Also trigger change on percentage input for real-time updates
                updateTotals();
            }
        }

                // Function to add custom deduction - FIXED VERSION
        function addCustomDeduction() {
            var newIndex = deductionCounter++;
            var tbody = document.querySelector('#deductionsTable tbody');
            var newRow = document.createElement('tr');
            newRow.className = 'deduction-row';
            newRow.setAttribute('data-index', newIndex);

            newRow.innerHTML = `
                <td class="align-middle">
                    <input type="hidden" name="Deductions[${newIndex}].DeductionCode" value="CUSTOM" />
                    <input type="hidden" name="Deductions[${newIndex}].DeductionName" id="DeductionName_${newIndex}" value="Custom Deduction" />
                    <input type="hidden" name="Deductions[${newIndex}].IsMandatory" value="false" />
                    <input type="hidden" name="Deductions[${newIndex}].IsPercentage" id="IsPercentage_${newIndex}" value="false" />
                    <input type="hidden" name="Deductions[${newIndex}].PercentageValue" id="PercentageValue_${newIndex}" value="0" />
                    <input type="text" class="form-control form-control-sm" value="Custom Deduction"
                           onchange="updateDeductionName(${newIndex}, this.value)" />
                </td>
                <td class="align-middle">
                    <select name="Deductions[${newIndex}].GlAccountNo"
                            class="form-select form-select-sm deduction-account"
                            data-index="${newIndex}"
                            onchange="updateGlAccountName(${newIndex}, this.value)">
                        <option value="">-- Select Income Account --</option>
                        ${getAccountOptions()}
                    </select>
                    <input type="hidden" name="Deductions[${newIndex}].GlAccountName" id="GlAccountName_${newIndex}" value="" />
                </td>
                <td class="align-middle">
                    <input type="number"
                           name="Deductions[${newIndex}].Amount"
                           class="form-control deduction-amount"
                           id="Amount_${newIndex}"
                           value="0"
                           min="0"
                           step="any"
                           placeholder="Enter amount"
                           onchange="updateTotals()"
                           oninput="updateTotals()" />
                </td>
                <td class="align-middle">
                    <div class="input-group input-group-sm">
                        <input type="number"
                               class="form-control deduction-percentage"
                               id="PercentageInput_${newIndex}"
                               value="0"
                               min="0"
                               max="100"
                               step="0.01"
                               placeholder="%"
                               disabled
                               onchange="calculatePercentageAmount(${newIndex})" />
                        <button type="button"
                                class="btn btn-outline-secondary toggle-percentage"
                                data-index="${newIndex}"
                                onclick="togglePercentageMode(${newIndex})"
                                title="Toggle between fixed amount and percentage">
                            <i class="bi bi-percent"></i>
                        </button>
                    </div>
                </div>
                </td>
                <td class="align-middle">
                    <input type="text"
                           name="Deductions[${newIndex}].Description"
                           class="form-control form-control-sm"
                           value="" />
                </td>
                <td class="align-middle text-center">
                    <button type="button" class="btn btn-sm btn-danger remove-deduction" data-index="${newIndex}" title="Remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(newRow);

            // Force recalculation of totals
            updateTotals();

            // Also trigger a change event to ensure validation runs
            var amountInput = document.getElementById(`Amount_${newIndex}`);
            if (amountInput) {
                amountInput.dispatchEvent(new Event('change'));
            }
        }

        // Function to get account options as HTML string - FIXED VERSION
        function getAccountOptions() {
            var options = '<option value="">-- Select Income Account --</option>';
            @foreach (var account in allGlAccounts)
            {
                    @:options += `<option value="@account.AccountNo" data-account-name="@account.AccountName">@(account.DisplayText?.ToString()?.Replace("'", "\\'") ?? "")</option>`;
            }
            return options;
        }

        // Function to update deduction name
        function updateDeductionName(index, newName) {
            var nameInput = document.querySelector(`input[name="Deductions[${index}].DeductionName"]`);
            if (nameInput) {
                nameInput.value = newName;
            }
        }

        // Function to update totals
        function updateTotals() {
            var totalDeductions = 0;
            var hasInvalidAmount = false;

            // Loop through all deduction amount inputs
            var amountInputs = document.querySelectorAll('.deduction-amount');
            amountInputs.forEach(function(input) {
                // Always check value regardless of disabled state
                var amount = parseFloat(input.value) || 0;
                if (amount < 0) {
                    hasInvalidAmount = true;
                }
                totalDeductions += amount;
            });

            var netAmount = grossAmount - totalDeductions;

            // Update displays
            var totalDeductionsSpan = document.getElementById('totalDeductions');
            var netAmountSpan = document.getElementById('netAmount');
            var submitBtn = document.getElementById('submitBtn');

            if (totalDeductionsSpan) {
                totalDeductionsSpan.textContent = totalDeductions.toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            if (netAmountSpan) {
                netAmountSpan.textContent = netAmount.toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

                if (netAmount < 0 || hasInvalidAmount) {
                    netAmountSpan.style.color = 'red';
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.title = netAmount < 0 ? 'Net amount cannot be negative' : 'Invalid amount entered';
                    }
                } else {
                    netAmountSpan.style.color = '#0d6efd';
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.removeAttribute('title');
                    }
                }
            }
        }

                // Override the main validateForm to handle dynamically added deductions
        window.validateForm = function() {
            var acceptCheckbox = document.getElementById('acceptCheckbox');
            var rejectCheckbox = document.getElementById('rejectCheckbox');
            var isValid = true;
            var errorMessage = '';

            // Check if accepted
            if (acceptCheckbox && acceptCheckbox.checked) {
                // Validate deductions - get all deduction rows
                var deductionRows = document.querySelectorAll('#deductionsTable tbody tr');

                for (var i = 0; i < deductionRows.length; i++) {
                    var amountInput = deductionRows[i].querySelector('.deduction-amount');
                    var glSelect = deductionRows[i].querySelector('.deduction-account');

                    var amount = parseFloat(amountInput?.value) || 0;
                    var glAccount = glSelect?.value || '';

                    if (amount > 0 && !glAccount) {
                        isValid = false;
                        errorMessage = 'Please select an income account for all deductions with amounts greater than 0';
                        break;
                    }
                }

                // Check net amount
                if (isValid) {
                    var netAmountSpan = document.getElementById('netAmount');
                    var netAmountText = netAmountSpan ? netAmountSpan.textContent.replace(/[^0-9.-]/g, '') : '0';
                    var netAmount = parseFloat(netAmountText) || 0;

                    if (netAmount < 0) {
                        isValid = false;
                        errorMessage = 'Net amount cannot be negative. Please reduce deductions.';
                    }
                }
            }
            // Check if rejected
            else if (rejectCheckbox && rejectCheckbox.checked) {
                var rejectionReason = document.querySelector('textarea[name="Remarks"]');
                if (!rejectionReason || !rejectionReason.value || rejectionReason.value.trim() === '') {
                    isValid = false;
                    errorMessage = 'Please provide a reason for rejecting the endorsement.';
                }
            }

            if (!isValid && errorMessage) {
                alert(errorMessage);
                return false;
            }

            return true;
        };

        // Validate form before submission
        function validateForm() {
            var amountInputs = document.querySelectorAll('.deduction-amount');
            var glSelects = document.querySelectorAll('.deduction-account');
            var isValid = true;
            var errorMessage = '';

            for (var i = 0; i < amountInputs.length; i++) {
                var amount = parseFloat(amountInputs[i].value) || 0;
                var glAccount = glSelects[i].value;

                if (amount > 0 && !glAccount) {
                    isValid = false;
                    errorMessage = 'Please select an income account for all deductions with amounts greater than 0';
                    break;
                }
            }

            var netAmountSpan = document.getElementById('netAmount');
            var netAmountText = netAmountSpan ? netAmountSpan.textContent.replace(/[^0-9.-]/g, '') : '0';
            var netAmount = parseFloat(netAmountText) || 0;

            if (netAmount < 0) {
                isValid = false;
                errorMessage = 'Net amount cannot be negative. Please reduce deductions.';
            }

            if (!isValid && errorMessage) {
                alert(errorMessage);
                return false;
            }

            return true;
        }

        // Remove deduction row
        function removeDeduction(btn) {
            var row = btn.closest('tr');
            if (row) {
                row.remove();
                updateTotals();
                // Reindex remaining rows
                reindexRows();
            }
        }

        // Reindex rows after removal
        function reindexRows() {
            var rows = document.querySelectorAll('#deductionsTable tbody tr');
            rows.forEach(function(row, newIndex) {
                row.setAttribute('data-index', newIndex);
                var inputs = row.querySelectorAll('input, select');
                inputs.forEach(function(input) {
                    var name = input.getAttribute('name');
                    var id = input.getAttribute('id');
                    if (name) {
                        var newName = name.replace(/Deductions\[\d+\]/, `Deductions[${newIndex}]`);
                        input.setAttribute('name', newName);
                    }
                    if (id) {
                        var newId = id.replace(/_\d+$/, `_${newIndex}`);
                        input.setAttribute('id', newId);
                    }
                });
            });
        }

        // Add event listeners for real-time percentage updates
        function addPercentageEventListeners() {
            var percentageInputs = document.querySelectorAll('.deduction-percentage');
            percentageInputs.forEach(function(input, idx) {
                input.removeEventListener('input', percentageInputHandler);
                input.addEventListener('input', percentageInputHandler);
            });
        }

        function percentageInputHandler(e) {
            var input = e.target;
            var index = input.id.replace('PercentageInput_', '');
            calculatePercentageAmount(index);
        }

        // Initialize when document is ready
        document.addEventListener('DOMContentLoaded', function() {
            // Set initial values for GL Account Names
            var deductionCount = @Model.Deductions.Count;
            for (var i = 0; i < deductionCount; i++) {
                var selectElement = document.querySelector(`select[name="Deductions[${i}].GlAccountNo"]`);
                if (selectElement && selectElement.value) {
                    updateGlAccountName(i, selectElement.value);
                }
            }

            // Calculate initial totals
            updateTotals();

            // Add custom deduction button handler
            var addBtn = document.getElementById('addCustomDeductionBtn');
            if (addBtn) {
                addBtn.addEventListener('click', addCustomDeduction);
            }

            // Remove deduction button handlers (event delegation)
            document.addEventListener('click', function(e) {
                if (e.target.closest('.remove-deduction')) {
                    var btn = e.target.closest('.remove-deduction');
                    removeDeduction(btn);
                }
            });

            // Add real-time percentage input listeners
            addPercentageEventListeners();

            // Also add change event to amount inputs for better UX
            var amountInputs = document.querySelectorAll('.deduction-amount');
            amountInputs.forEach(function(input) {
                input.addEventListener('input', function() {
                    updateTotals();
                });
            });
        });

        // Two Checkboxes Logic for Endorsement Decision
        document.addEventListener('DOMContentLoaded', function() {
            // Get the checkbox elements
            var acceptCheckbox = document.getElementById('acceptCheckbox');
            var rejectCheckbox = document.getElementById('rejectCheckbox');
            var hiddenField = document.getElementById('IsAcceptedHidden');
            var rejectionReasonDiv = document.getElementById('rejectionReasonDiv');
            var rejectionWarningDiv = document.getElementById('rejectionWarningDiv');
            var remarksTextarea = document.querySelector('textarea[name="Remarks"]');
            var deductionsWrapper = document.getElementById('deductionsWrapper');
            var submitBtn = document.getElementById('submitBtn');

            // Function to handle Accept state
            function setAcceptState() {
                acceptCheckbox.checked = true;
                rejectCheckbox.checked = false;
                if (hiddenField) hiddenField.value = 'true';

                // Hide rejection sections
                if (rejectionReasonDiv) rejectionReasonDiv.style.display = 'none';
                if (rejectionWarningDiv) rejectionWarningDiv.style.display = 'none';

                // Clear rejection reason if any
                if (remarksTextarea) remarksTextarea.value = '';

                // SHOW the entire deductions wrapper
                if (deductionsWrapper) {
                    deductionsWrapper.style.display = '';
                }

                // Enable submit button
                if (submitBtn) submitBtn.disabled = false;
            }

            // Function to handle Reject state
            function setRejectState() {
                acceptCheckbox.checked = false;
                rejectCheckbox.checked = true;
                if (hiddenField) hiddenField.value = 'false';

                // Show rejection sections
                if (rejectionReasonDiv) rejectionReasonDiv.style.display = 'block';
                if (rejectionWarningDiv) rejectionWarningDiv.style.display = 'block';

                // HIDE the entire deductions wrapper
                if (deductionsWrapper) {
                    deductionsWrapper.style.display = 'none';
                }

                // Clear any deduction values
                var amountInputs = document.querySelectorAll('.deduction-amount');
                amountInputs.forEach(function(input) {
                    input.value = 0;
                });

                // Enable submit button (will be validated in validateForm)
                if (submitBtn) submitBtn.disabled = false;
            }

            // Add event listeners to checkboxes
            if (acceptCheckbox) {
                acceptCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        setAcceptState();
                    } else {
                        // If accept is unchecked and reject is also unchecked, default to accept
                        if (!rejectCheckbox.checked) {
                            setAcceptState();
                        }
                    }
                });
            }

            if (rejectCheckbox) {
                rejectCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        setRejectState();
                    } else {
                        // If reject is unchecked and accept is also unchecked, default to accept
                        if (!acceptCheckbox.checked) {
                            setAcceptState();
                        }
                    }
                });
            }

            // Initial state - default to Accept
            setAcceptState();

            // Override validateForm to include rejection reason check
            window.validateForm = function() {
                var acceptCheckbox = document.getElementById('acceptCheckbox');
                var rejectCheckbox = document.getElementById('rejectCheckbox');
                var isValid = true;
                var errorMessage = '';

                // Check if accepted
                if (acceptCheckbox && acceptCheckbox.checked) {
                    // Validate deductions
                    var amountInputs = document.querySelectorAll('.deduction-amount');
                    var glSelects = document.querySelectorAll('.deduction-account');

                    for (var i = 0; i < amountInputs.length; i++) {
                        var amount = parseFloat(amountInputs[i].value) || 0;
                        var glAccount = glSelects[i] ? glSelects[i].value : '';

                        if (amount > 0 && !glAccount) {
                            isValid = false;
                            errorMessage = 'Please select an income account for all deductions with amounts greater than 0';
                            break;
                        }
                    }

                    // Check net amount
                    if (isValid) {
                        var netAmountSpan = document.getElementById('netAmount');
                        var netAmountText = netAmountSpan ? netAmountSpan.textContent.replace(/[^0-9.-]/g, '') : '0';
                        var netAmount = parseFloat(netAmountText) || 0;

                        if (netAmount < 0) {
                            isValid = false;
                            errorMessage = 'Net amount cannot be negative. Please reduce deductions.';
                        }
                    }
                }
                // Check if rejected
                else if (rejectCheckbox && rejectCheckbox.checked) {
                    var rejectionReason = document.querySelector('textarea[name="Remarks"]');
                    if (!rejectionReason || !rejectionReason.value || rejectionReason.value.trim() === '') {
                        isValid = false;
                        errorMessage = 'Please provide a reason for rejecting the endorsement.';
                    }
                }

                if (!isValid && errorMessage) {
                    alert(errorMessage);
                    return false;
                }

                return true;
            };
        });

        // Updated validateForm function to include rejection reason validation
        function validateForm() {
            var acceptCheckbox = document.getElementById('acceptCheckbox');
            var rejectCheckbox = document.getElementById('rejectCheckbox');
            var isValid = true;
            var errorMessage = '';

            // Check if accepted
            if (acceptCheckbox && acceptCheckbox.checked) {
                // Validate deductions
                var amountInputs = document.querySelectorAll('.deduction-amount');
                var glSelects = document.querySelectorAll('.deduction-account');

                for (var i = 0; i < amountInputs.length; i++) {
                    var amount = parseFloat(amountInputs[i].value) || 0;
                    var glAccount = glSelects[i]?.value;

                    if (amount > 0 && !glAccount) {
                        isValid = false;
                        errorMessage = 'Please select an income account for all deductions with amounts greater than 0';
                        break;
                    }
                }

                // Check net amount
                if (isValid) {
                    var netAmountSpan = document.getElementById('netAmount');
                    var netAmountText = netAmountSpan ? netAmountSpan.textContent.replace(/[^0-9.-]/g, '') : '0';
                    var netAmount = parseFloat(netAmountText) || 0;

                    if (netAmount < 0) {
                        isValid = false;
                        errorMessage = 'Net amount cannot be negative. Please reduce deductions.';
                    }
                }
            }
            // Check if rejected
            else if (rejectCheckbox && rejectCheckbox.checked) {
                var rejectionReason = document.querySelector('[name="Remarks"]')?.value;
                if (!rejectionReason || rejectionReason.trim() === '') {
                    isValid = false;
                    errorMessage = 'Please provide a reason for rejecting the endorsement.';
                }
            }
            // Neither checked - default to accept
            else {
                // Default to accept, no additional validation needed
            }

            if (!isValid && errorMessage) {
                alert(errorMessage);
                return false;
            }

            return true;
        }
    </script>
}