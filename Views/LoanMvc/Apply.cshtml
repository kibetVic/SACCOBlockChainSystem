@model SACCOBlockChainSystem.Models.DTOs.LoanApplicationDTO
@{
    ViewData["Title"] = "Loan Application";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loanTypes = ViewBag.LoanTypes as List<SACCOBlockChainSystem.Models.DTOs.LoanTypeResponseDTO>;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center">
            <a asp-action="AllLoans" class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
            <h2 class="page-title mb-0">
                <i class="bi bi-file-earmark-text me-2"></i> Loan Application
            </h2>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @ViewBag.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-alt"></i> Loan Application Form
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Apply" method="post" id="loanApplicationForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="MemberNo" id="selectedMemberNo" />

                        <!-- Member Search Section -->
                        <div class="card mb-4 border-primary">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fas fa-search"></i> Step 1: Search & Select Member
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group mb-3">
                                            <label>Search Member By:</label>
                                            <div class="input-group">
                                                <input type="text" id="searchInput" class="form-control"
                                                       placeholder="Search by Member Number, Name, ID Number, or Phone Number..." />
                                                <button type="button" class="btn btn-primary" onclick="searchMembers()">
                                                    <i class="fas fa-search"></i> Search
                                                </button>
                                                <button type="button" class="btn btn-secondary" onclick="clearSearch()">
                                                    <i class="fas fa-times"></i> Clear
                                                </button>
                                            </div>
                                            <small class="text-muted">Enter at least 3 characters to search</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Search Results Table -->
                                <div id="searchResults" style="display: none;">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Select</th>
                                                    <th>Member No</th>
                                                    <th>Full Name</th>
                                                    <th>ID Number</th>
                                                    <th>Phone Number</th>
                                                    <th>Email</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody id="searchResultsBody">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Loading Indicator -->
                                <div id="searchLoading" style="display: none;" class="text-center p-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p>Searching for members...</p>
                                </div>

                                <!-- Selected Member Display -->
                                <div id="selectedMemberCard" style="display: none;" class="mt-3">
                                    <div class="alert alert-success">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="fas fa-check-circle"></i>
                                                <strong>Selected Member:</strong>
                                                <span id="selectedMemberName"></span>
                                                <br />
                                                <small>
                                                    <span id="selectedMemberNoDisplay"></span> |
                                                    ID: <span id="selectedMemberIdNo"></span> |
                                                    Phone: <span id="selectedMemberPhone"></span>
                                                </small>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearSelectedMember()">
                                                <i class="fas fa-trash"></i> Change
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Member Eligibility Info -->
                                <div id="memberEligibilityInfo" style="display: none;" class="mt-3">
                                    <div class="alert" id="eligibilityAlert">
                                        <div id="eligibilityContent"></div>
                                    </div>
                                </div>

                                <!-- Existing Loans Display for Top-Up -->
                                <div id="existingLoansInfo" style="display: none;" class="mt-3">
                                    <div class="alert alert-info" id="existingLoansAlert">
                                        <div id="existingLoansContent"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Loan Details Section -->
                        <div class="card mb-4 border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="fas fa-hand-holding-usd"></i> Step 2: Loan Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Loan Type Selection -->
                                <div class="row mb-3">
                                    <label asp-for="LoanCode" class="col-sm-3 col-form-label fw-bold">Loan Type *</label>
                                    <div class="col-sm-9">
                                        <select asp-for="LoanCode" class="form-select" id="loanType" disabled required>
                                            <option value="">-- Select Loan Type --</option>
                                            <!-- Populated by JavaScript -->
                                        </select>
                                        <span asp-validation-for="LoanCode" class="text-danger"></span>
                                        <div id="loanTypeMessage" class="form-text"></div>
                                    </div>
                                </div>

                                <!-- Top-Up Warning/Info Section -->
                                <div id="topUpInfo" class="d-none">
                                    <div id="topUpAlert" class="alert alert-warning">
                                        <div id="topUpContent">
                                            <i class="fas fa-arrow-up-circle me-2"></i>
                                            @* <strong>Top-Up Loan Application</strong>
                                            <p class="mb-0 mt-1">This member has existing loans. Only Top-Up loan products are available.</p> *@
                                        </div>
                                    </div>
                                </div>

                                <!-- Loan Amount -->
                                <div class="row mb-3">
                                    <label asp-for="PrincipalAmount" class="col-sm-3 col-form-label fw-bold">Loan Amount *</label>
                                    <div class="col-sm-9">
                                        <div class="input-group">
                                            <span class="input-group-text">KES</span>
                                            <input asp-for="PrincipalAmount" class="form-control" id="principalAmount"
                                                   type="number" min="0" disabled required />
                                        </div>
                                        <span asp-validation-for="PrincipalAmount" class="text-danger"></span>
                                        <div id="maxAmountHint" class="form-text"></div>
                                    </div>
                                </div>

                                <!-- Repayment Period -->
                                <div class="row mb-3">
                                    <label asp-for="RepayPeriod" class="col-sm-3 col-form-label fw-bold">Repayment Period *</label>
                                    <div class="col-sm-9">
                                        <div class="input-group">
                                            <input asp-for="RepayPeriod" class="form-control" id="repayPeriod"
                                                   type="number" min="1" max="360" step="1" disabled required />
                                            <span class="input-group-text">months</span>
                                        </div>
                                        <span asp-validation-for="RepayPeriod" class="text-danger"></span>
                                        <div id="repayPeriodHint" class="form-text">
                                            <span id="maxRepayPeriodHint" class="text-warning"></span>
                                            <small class="text-muted d-block">Enter the number of months you want to repay this loan (e.g., 4 for 4 months)</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Application Date -->
                                <div class="row mb-3">
                                    <label asp-for="ApplicationDate" class="col-sm-3 col-form-label fw-bold">Application Date</label>
                                    <div class="col-sm-9">
                                        <input asp-for="ApplicationDate" class="form-control" type="date"
                                               id="applicationDate" />
                                        <span asp-validation-for="ApplicationDate" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Purpose -->
                                <div class="row mb-3">
                                    <label asp-for="Purpose" class="col-sm-3 col-form-label fw-bold">Loan Purpose *</label>
                                    <div class="col-sm-9">
                                        <textarea asp-for="Purpose" class="form-control" rows="3"
                                                  placeholder="Describe the purpose of this loan" disabled required></textarea>
                                        <span asp-validation-for="Purpose" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Guarantor Info -->
                                <div id="guarantorInfo" class="alert alert-warning d-none">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <span id="guarantorMessage"></span>
                                </div>
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2" onclick="history.back()">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                                <i class="bi bi-send"></i> Submit Application
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-calculator"></i> Loan Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div id="loanSummary" class="text-center text-muted py-4">
                        <i class="bi bi-calculator fs-1"></i>
                        <p class="mt-3">Select loan type and enter amount to see summary</p>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle"></i> Loan Guidelines
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Minimum loan amount vary by loan type
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Must have eligible shares for guarantee
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Interest rates vary by loan type
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Guarantors may be required
                        </li>
                        <li class="mb-2" id="topUpGuideline">
                            <i class="bi bi-arrow-up-circle-fill text-warning me-2"></i>
                            <strong>Top-Up Loans:</strong> Members with existing loans can apply for Top-Up loan products
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Top-Up Information Card -->
            <div class="card mt-4" id="topUpInfoCard" style="display: none;">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-arrow-up-circle"></i> Top-Up Loan Info
                    </h5>
                </div>
                <div class="card-body" id="topUpInfoCardBody">
                    <div id="topUpInfoCardContent"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Pass loan types from server to JavaScript using a safe approach
        var allLoanTypes = @Html.Raw(Json.Serialize(loanTypes));

        // Set application date
        document.addEventListener('DOMContentLoaded', function() {
            var dateInput = document.getElementById('applicationDate');
            if (dateInput) {
                var today = new Date();
                var year = today.getFullYear();
                var month = String(today.getMonth() + 1).padStart(2, '0');
                var day = String(today.getDate()).padStart(2, '0');
                dateInput.value = year + '-' + month + '-' + day;
            }
        });

        let currentMemberNo = null;
        let selectedMemberData = null;
        let memberEligibilityData = null;
        let currentMaxRepayPeriod = 360;
        let isMemberEligible = false;
        let hasExistingLoan = false;
        let canApplyForTopUp = false;
        let topUpLoanTypeCodes = [];
        let bridgingLoanTypeCode = null;
        let bridgingLoanTypeName = null;
        let existingLoansList = [];
        let searchTimeout = null;

        // Auto-search with debounce
        document.getElementById('searchInput').addEventListener('keyup', function(e) {
            // Don't trigger on Enter key (handled separately)
            if (e.key === 'Enter') {
                searchMembers();
                return;
            }

            // Clear previous timeout
            if (searchTimeout) {
                clearTimeout(searchTimeout);
            }

            var searchTerm = this.value.trim();

            // Only search if 3 or more characters
            if (searchTerm.length >= 3) {
                searchTimeout = setTimeout(function() {
                    searchMembers();
                }, 500); // 500ms debounce delay
            } else if (searchTerm.length === 0) {
                clearSearch();
            }
        });

        // Enter key support for search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                searchMembers();
            }
        });

        // Search members function
        async function searchMembers() {
            const searchTerm = document.getElementById('searchInput').value.trim();

            if (searchTerm.length < 3) {
                // Don't show warning for auto-search, just clear results
                if (searchTerm.length > 0) {
                    Swal.fire('Warning', 'Please enter at least 3 characters to search', 'warning');
                }
                document.getElementById('searchResults').style.display = 'none';
                return;
            }

            document.getElementById('searchLoading').style.display = 'block';
            document.getElementById('searchResults').style.display = 'none';
            document.getElementById('searchResultsBody').innerHTML = '';

            try {
                // Get company code from hidden field or session
                var companyCode = '@ViewBag.CompanyCode';

                const response = await fetch('/api/LoanApi/search?searchTerm=' + encodeURIComponent(searchTerm) + '&companyCode=' + encodeURIComponent(companyCode));

                if (response.ok) {
                    const data = await response.json();

                    if (data.success && data.data && data.data.length > 0) {
                        displaySearchResults(data.data);
                    } else {
                        document.getElementById('searchResultsBody').innerHTML =
                            '<tr><td colspan="7" class="text-center text-danger">No members found matching your search</td></tr>';
                        document.getElementById('searchResults').style.display = 'block';
                        if (searchTerm.length > 0) {
                            Swal.fire('Info', 'No members found matching your search', 'info');
                        }
                    }
                } else {
                    throw new Error('Search failed');
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('searchResultsBody').innerHTML =
                    '<tr><td colspan="7" class="text-center text-danger">Error searching members. Please try again.</td></tr>';
                document.getElementById('searchResults').style.display = 'block';
                if (searchTerm.length > 0) {
                    Swal.fire('Error', 'Error searching members', 'error');
                }
            } finally {
                document.getElementById('searchLoading').style.display = 'none';
            }
        }

        function displaySearchResults(members) {
            const tbody = document.getElementById('searchResultsBody');
            tbody.innerHTML = '';

            for (var i = 0; i < members.length; i++) {
                var member = members[i];
                var row = tbody.insertRow();
                var isActive = member.isActive != false;
                var statusText = isActive ? 'Active' : 'Inactive';
                var statusClass = isActive ? 'bg-success' : 'bg-danger';

                row.innerHTML = `
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-success" onclick="selectMember('${member.memberNo}')">
                            <i class="fas fa-check"></i> Select
                        </button>
                    </td>
                    <td><strong>${escapeHtml(member.memberNo)}</strong></td>
                    <td>${escapeHtml(member.fullName || member.surname + ' ' + member.otherNames)}</td>
                    <td>${escapeHtml(member.idNo || 'N/A')}</td>
                    <td>${escapeHtml(member.phoneNo || 'N/A')}</td>
                    <td>${escapeHtml(member.email || 'N/A')}</td>
                    <td>
                        <span class="badge ${statusClass}">
                            ${statusText}
                        </span>
                    </td>
                `;
            }

            document.getElementById('searchResults').style.display = 'block';
        }

        // Updated: selectMember function with Top-Up support
        async function selectMember(memberNo) {
            try {
                var eligibilityDiv = document.getElementById('memberEligibilityInfo');
                eligibilityDiv.style.display = 'block';
                var eligibilityAlert = document.getElementById('eligibilityAlert');
                eligibilityAlert.className = 'alert alert-info';
                document.getElementById('eligibilityContent').innerHTML = `
                    <i class="fas fa-spinner fa-spin me-2"></i>
                    Checking member eligibility...
                `;

                document.getElementById('existingLoansInfo').style.display = 'none';
                document.getElementById('loanTypeMessage').innerHTML = '';
                document.getElementById('topUpInfoCard').style.display = 'none';
                document.getElementById('topUpInfo').classList.add('d-none');

                var companyCode = '@ViewBag.CompanyCode';
                var response = await fetch('/LoanMvc/CheckMemberEligibility?memberNo=' + memberNo);
                var data = await response.json();

                if (response.ok && data.success) {
                    memberEligibilityData = data.data;
                    currentMemberNo = memberNo;
                    selectedMemberData = data.data;
                    hasExistingLoan = data.hasExistingLoan || false;
                    canApplyForTopUp = data.canApplyForTopUp || false;
                    topUpLoanTypeCodes = data.topUpLoanTypeCodes || [];
                    bridgingLoanTypeCode = data.bridgingLoanTypeCode || null;
                    bridgingLoanTypeName = data.bridgingLoanTypeName || null;
                    existingLoansList = data.existingLoans || [];

                    document.getElementById('selectedMemberNo').value = memberNo;
                    document.getElementById('selectedMemberName').innerHTML =
                        '<strong>' + escapeHtml(data.data.name || data.data.memberNo) + '</strong>';
                    document.getElementById('selectedMemberNoDisplay').innerHTML = memberNo;
                    document.getElementById('selectedMemberIdNo').innerHTML = data.data.idNo || 'N/A';
                    document.getElementById('selectedMemberPhone').innerHTML = data.data.phone || 'N/A';

                    document.getElementById('selectedMemberCard').style.display = 'block';
                    document.getElementById('searchResults').style.display = 'none';
                    document.getElementById('searchInput').value = '';

                    // Check: Does member have existing loans?
                    if (hasExistingLoan) {
                        // Case: Member has existing loans - Show only Top-Up loan types
                        if (topUpLoanTypeCodes.length === 0) {
                            // No Top-Up loan types available
                            isMemberEligible = false;
                            eligibilityAlert.className = 'alert alert-warning';

                            var existingLoansHtml = '';
                            if (existingLoansList.length > 0) {
                                existingLoansHtml = '<div class="mt-2"><strong>Existing Loans:</strong><ul class="mb-0 mt-1">';
                                for (var k = 0; k < existingLoansList.length; k++) {
                                    var loan = existingLoansList[k];
                                    var bridgingText = loan.bridgingAllowed ? '✅ Top-Up Allowed' : '❌ No Top-Up';
                                    existingLoansHtml += '<li>' + loan.loanNo + ' - ' + loan.loanType + ' (' + loan.loanStatus + ') - Paid: ' + loan.percentagePaid + '% - ' + bridgingText + '</li>';
                                }
                                existingLoansHtml += '</ul></div>';
                            }

                            document.getElementById('eligibilityContent').innerHTML = `
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>Member Has Existing Loans</strong>
                                <p class="mb-0 mt-1">This member has existing loans but no Top-Up loan products are currently available.</p>
                                ${existingLoansHtml}
                                <small class="text-muted mt-2 d-block">Please clear existing loans first or contact the administrator to enable Top-Up loan products.</small>
                            `;

                            populateLoanTypes([]);
                            document.getElementById('loanTypeMessage').innerHTML =
                                '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> No loan types available. Please clear existing loans first.</span>';
                            disableLoanForm();
                            return;
                        }

                        // Filter loan types to ONLY Top-Up eligible ones (IsTopUp = true)
                        var filteredLoanTypes = allLoanTypes.filter(function(lt) {
                            return topUpLoanTypeCodes.indexOf(lt.loanCode) !== -1;
                        });

                        if (filteredLoanTypes.length === 0) {
                            isMemberEligible = false;
                            eligibilityAlert.className = 'alert alert-warning';
                            document.getElementById('eligibilityContent').innerHTML = `
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>No Top-Up Loan Types Available</strong>
                                <p class="mb-0 mt-1">This member has existing loans but no eligible Top-Up loan types are currently available.</p>
                                <small class="text-muted mt-2 d-block">Please contact the administrator to configure Top-Up loan types.</small>
                            `;
                            populateLoanTypes([]);
                            document.getElementById('loanTypeMessage').innerHTML =
                                '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> No Top-Up loan types available.</span>';
                            disableLoanForm();
                            return;
                        }

                        // Populate ONLY Top-Up loan types
                        populateLoanTypes(filteredLoanTypes);

                        var topUpNames = filteredLoanTypes.map(function(lt) {
                            return lt.loanType;
                        }).join(', ');

                        
                        // Enable loan form
                        document.getElementById('loanType').disabled = false;
                        document.getElementById('principalAmount').disabled = false;
                        document.getElementById('repayPeriod').disabled = false;
                        document.getElementById('Purpose').disabled = false;

                        var existingLoansHtml = '';
                        if (existingLoansList.length > 0) {
                            existingLoansHtml = '<div class="mt-2"><strong>Existing Loans (will be topped up):</strong><ul class="mb-0 mt-1">';
                            for (var j = 0; j < existingLoansList.length; j++) {
                                var loan = existingLoansList[j];
                                var bridgingText = loan.bridgingAllowed ? '✅ Top-Up Allowed' : '❌ No Top-Up';
                                existingLoansHtml += '<li>' + loan.loanNo + ' - Paid: ' + loan.percentagePaid + '% - ' + bridgingText + '</li>';
                            }
                            existingLoansHtml += '</ul></div>';
                        }

                        eligibilityAlert.className = 'alert alert-info';
                        document.getElementById('eligibilityContent').innerHTML = `
                            <i class="fas fa-arrow-up-circle me-2"></i>
                            <strong>Top-Up Loan Available</strong>
                            <p class="mb-0 mt-1">This member has existing loans but can apply for a Top-Up loan.</p>
                            ${existingLoansHtml}
                            <div class="mt-2">
                                <span class="badge bg-warning text-dark">Available Top-Up Products: ${topUpNames}</span>
                            </div>
                            <small class="text-info mt-2 d-block">✓ The new loan will be added on top of existing loans. Maximum loan amount is reduced by outstanding balance.</small>
                        `;

                        enableLoanForm(data.data.maxLoanAmount || 50000, data.data.eligibleShares || 0);
                        isMemberEligible = true;

                        document.getElementById('topUpInfoCard').style.display = 'block';
                        document.getElementById('topUpInfoCardContent').innerHTML = `
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-arrow-up-circle-fill me-2"></i>
                                <strong>Top-Up Loan</strong>
                                <p class="mb-0 mt-1">This is a Top-Up loan application. The new loan will be added on top of existing loans.</p>
                                <small class="text-muted">Please ensure the new loan amount plus existing balance does not exceed the maximum eligible amount.</small>
                            </div>
                        `;

                        return;
                    }

                    // Case: No existing loans - Show all loan types (normal)
                    populateLoanTypes(allLoanTypes);
                    document.getElementById('loanTypeMessage').innerHTML =
                        '<span class="text-success"><i class="bi bi-check-circle"></i> You can apply for any available loan type.</span>';
                    document.getElementById('loanType').disabled = false;
                    document.getElementById('topUpInfo').classList.add('d-none');

                    if (!data.data.hasValidShares) {
                        isMemberEligible = false;
                        eligibilityAlert.className = 'alert alert-danger';
                        document.getElementById('eligibilityContent').innerHTML = `
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Member Not Eligible</strong>
                            <p class="mb-0 mt-1">${data.message || 'Member does not have eligible shares for a loan.'}</p>
                            <small class="text-muted">Member must have shares in eligible share types (UsedToGuarantee=true, UsedToOffset=true, Withdrawable=true)</small>
                        `;
                        disableLoanForm();
                        return;
                    }

                    isMemberEligible = true;
                    eligibilityAlert.className = 'alert alert-success';
                    document.getElementById('eligibilityContent').innerHTML = `
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>Member Verified & Eligible</strong>
                        <div class="row mt-2">
                            <div class="col-md-6">
                                <small><strong>Member No:</strong> ${escapeHtml(data.data.memberNo)}</small><br>
                                <small><strong>Phone:</strong> ${escapeHtml(data.data.phone || 'N/A')}</small>
                            </div>
                            <div class="col-md-6">
                                <small><strong>Email:</strong> ${escapeHtml(data.data.email || 'N/A')}</small><br>
                                <small><strong>Eligible Shares:</strong> KES ${(data.data.eligibleShares || 0).toLocaleString()}</small>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="badge bg-success">Maximum Loan: KES ${(data.data.maxLoanAmount || 0).toLocaleString()}</span>
                            <span class="badge bg-info ms-2">Based on ${(data.data.eligibleShares || 0).toLocaleString()} eligible shares</span>
                        </div>
                    `;

                    document.getElementById('topUpInfoCard').style.display = 'none';
                    enableLoanForm(data.data.maxLoanAmount || 50000, data.data.eligibleShares || 0);

                } else {
                    isMemberEligible = false;
                    eligibilityAlert.className = 'alert alert-danger';
                    document.getElementById('eligibilityContent').innerHTML = `
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Error:</strong> ${data.message || 'Member not found or not eligible'}
                    `;
                    disableLoanForm();
                }
            } catch (error) {
                console.error('Error:', error);
                var eligibilityAlert = document.getElementById('eligibilityAlert');
                eligibilityAlert.className = 'alert alert-danger';
                document.getElementById('eligibilityContent').innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    An error occurred while checking member eligibility. Please try again.
                    <br><small class="text-muted">${error.message}</small>
                `;
                disableLoanForm();
            }
        }

        function populateLoanTypes(loanTypes) {
            var select = document.getElementById('loanType');
            select.innerHTML = '<option value="">-- Select Loan Type --</option>';

            if (!loanTypes || loanTypes.length === 0) {
                select.innerHTML = '<option value="">-- No loan types available --</option>';
                return;
            }

            for (var i = 0; i < loanTypes.length; i++) {
                var lt = loanTypes[i];
                var option = document.createElement('option');
                option.value = lt.loanCode;

                var displayText = lt.loanType;
                var tags = [];

                if (lt.mobileLoan) tags.push('Mobile');
                if (lt.isProject) tags.push('Project');
                if (lt.isTopUp) tags.push('Top-Up');

                if (tags.length > 0) {
                    displayText += ' (' + tags.join(', ') + ')';
                }

                option.text = displayText;
                option.dataset.maxAmount = lt.maxAmount || 0;
                option.dataset.interest = lt.interest || 0;
                option.dataset.repayPeriod = lt.repayPeriod || 360;
                option.dataset.guarantor = lt.guarantor || '';
                option.dataset.selfGuarantee = lt.selfGuarantee || false;
                option.dataset.processingFee = lt.processingFee || 0;
                option.dataset.repayMethod = lt.repayMethod || 'AMT';
                option.dataset.mobile = lt.mobileLoan || false;
                option.dataset.project = lt.isProject || false;
                option.dataset.isTopUp = lt.isTopUp || false;
                option.dataset.maxLoans = lt.maxLoans || 5;

                select.appendChild(option);
            }
        }

        function enableLoanForm(maxLoanAmount, eligibleShares) {
            document.getElementById('loanType').disabled = false;
            document.getElementById('principalAmount').disabled = false;
            document.getElementById('repayPeriod').disabled = false;
            document.getElementById('Purpose').disabled = false;

            document.getElementById('principalAmount').setAttribute('max', maxLoanAmount);
            document.getElementById('principalAmount').setAttribute('min', 1000);
            document.getElementById('maxAmountHint').innerHTML =
                '<i class="bi bi-piggy-bank-fill me-1"></i>' +
                'Maximum loan based on eligible shares (' + (eligibleShares || 0).toLocaleString() + '): KES ' + (maxLoanAmount || 0).toLocaleString() +
                '<br><small class="text-muted">Loan-to-Share ratio: ' + ((maxLoanAmount || 0) / ((eligibleShares || 1))).toFixed(1) + 'x</small>';
        }

        function disableLoanForm() {
            document.getElementById('loanType').disabled = true;
            document.getElementById('principalAmount').disabled = true;
            document.getElementById('repayPeriod').disabled = true;
            document.getElementById('Purpose').disabled = true;
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('loanSummary').innerHTML =
                '<i class="bi bi-calculator fs-1"></i>' +
                '<p class="mt-3">Select an eligible member to see loan summary</p>';
            document.getElementById('topUpInfo').classList.add('d-none');
            document.getElementById('topUpInfoCard').style.display = 'none';
            document.getElementById('loanTypeMessage').innerHTML = '';
        }

        function clearSelectedMember() {
            currentMemberNo = null;
            selectedMemberData = null;
            memberEligibilityData = null;
            isMemberEligible = false;
            hasExistingLoan = false;
            canApplyForTopUp = false;
            topUpLoanTypeCodes = [];
            bridgingLoanTypeCode = null;
            bridgingLoanTypeName = null;
            existingLoansList = [];

            document.getElementById('selectedMemberNo').value = '';
            document.getElementById('selectedMemberCard').style.display = 'none';
            document.getElementById('memberEligibilityInfo').style.display = 'none';
            document.getElementById('existingLoansInfo').style.display = 'none';
            document.getElementById('loanType').value = '';
            document.getElementById('principalAmount').value = '';
            document.getElementById('repayPeriod').value = '';
            document.getElementById('Purpose').value = '';
            document.getElementById('maxAmountHint').innerHTML = '';
            document.getElementById('maxRepayPeriodHint').innerHTML = '';
            document.getElementById('guarantorInfo').classList.add('d-none');
            document.getElementById('loanTypeMessage').innerHTML = '';

            populateLoanTypes(allLoanTypes);
            document.getElementById('topUpInfo').classList.add('d-none');
            document.getElementById('topUpInfoCard').style.display = 'none';
            disableLoanForm();
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResults').style.display = 'none';
            document.getElementById('searchResultsBody').innerHTML = '';
        }

        // Update loan type details when selected
        document.getElementById('loanType').addEventListener('change', function() {
            if (!isMemberEligible) {
                alert('Please select an eligible member first');
                this.value = '';
                return;
            }

            var selected = this.options[this.selectedIndex];
            if (!selected || !selected.value) {
                return;
            }

            var maxAmount = parseFloat(selected.dataset.maxAmount) || 0;
            var eligibleAmount = memberEligibilityData?.maxLoanAmount || 0;
            var guarantor = selected.dataset.guarantor;
            var selfGuarantee = selected.dataset.selfGuarantee;
            var processingFee = parseFloat(selected.dataset.processingFee) || 0;
            var maxRepayPeriodFromLoanType = parseInt(selected.dataset.repayPeriod) || 360;

            currentMaxRepayPeriod = maxRepayPeriodFromLoanType;
            var repayPeriodInput = document.getElementById('repayPeriod');
            repayPeriodInput.setAttribute('max', maxRepayPeriodFromLoanType);
            repayPeriodInput.setAttribute('min', 1);
            document.getElementById('maxRepayPeriodHint').innerHTML =
                '<i class="bi bi-info-circle me-1"></i>' +
                'Maximum allowed for this loan type: <strong>' + maxRepayPeriodFromLoanType + ' months</strong>' +
                (maxRepayPeriodFromLoanType < 12 ? '<span class="text-danger ms-2">Short-term loan</span>' : '');

            var currentValue = parseInt(repayPeriodInput.value);
            if (currentValue && currentValue > maxRepayPeriodFromLoanType) {
                repayPeriodInput.value = maxRepayPeriodFromLoanType;
            }

            if (!repayPeriodInput.value) {
                var defaultPeriod = Math.min(12, maxRepayPeriodFromLoanType);
                repayPeriodInput.value = defaultPeriod;
            }

            var currentMaxAmount = maxAmount > 0 ? Math.min(maxAmount, eligibleAmount) : eligibleAmount;

            if (currentMaxAmount > 0) {
                var principalInput = document.getElementById('principalAmount');
                principalInput.setAttribute('max', currentMaxAmount);
                document.getElementById('maxAmountHint').innerHTML =
                    'Maximum allowed: KES ' + (currentMaxAmount || 0).toLocaleString() +
                    (maxAmount > 0 && maxAmount < eligibleAmount ? '<br><small class="text-muted">Loan type limit: KES ' + (maxAmount || 0).toLocaleString() + '</small>' : '') +
                    (eligibleAmount > 0 && eligibleAmount < maxAmount ? '<br><small class="text-muted">Member limit: KES ' + (eligibleAmount || 0).toLocaleString() + '</small>' : '');
                document.getElementById('submitBtn').disabled = false;
            } else {
                document.getElementById('submitBtn').disabled = true;
                document.getElementById('maxAmountHint').innerHTML = '<span class="text-danger">No eligible amount available for this loan type</span>';
            }

            var requiresGuarantor = guarantor && guarantor !== 'No' && guarantor !== 'N';
            var guarantorInfo = document.getElementById('guarantorInfo');
            var guarantorMessage = document.getElementById('guarantorMessage');

            if (requiresGuarantor) {
                var guarantorCount = 1;
                if (guarantor === 'Yes' || guarantor === 'Y') {
                    guarantorCount = 1;
                } else if (!isNaN(parseInt(guarantor))) {
                    guarantorCount = parseInt(guarantor);
                }

                guarantorInfo.classList.remove('d-none');
                if (selfGuarantee === true || selfGuarantee === 'true' || selfGuarantee === 'Yes') {
                    guarantorMessage.innerHTML =
                        '<i class="bi bi-shield-check me-2"></i>' +
                        '<strong>Guarantor Required:</strong> This loan requires ' + guarantorCount + ' guarantor(s).' +
                        'You can use your own shares as guarantee.';
                } else {
                    guarantorMessage.innerHTML =
                        '<i class="bi bi-people me-2"></i>' +
                        '<strong>Guarantor Required:</strong> This loan requires ' + guarantorCount + ' guarantor(s).' +
                        'You will need to assign guarantors after creating the application.';
                }
            } else {
                guarantorInfo.classList.add('d-none');
            }

            updateLoanSummary();
        });

        // Real-time validation for repayment period
        document.getElementById('repayPeriod').addEventListener('input', function() {
            var enteredValue = parseInt(this.value);
            var maxAllowed = currentMaxRepayPeriod;

            if (enteredValue > maxAllowed) {
                this.value = maxAllowed;
                document.getElementById('repayPeriodHint').innerHTML =
                    '<span id="maxRepayPeriodHint" class="text-danger">' +
                        '<i class="bi bi-exclamation-triangle-fill me-1"></i>' +
                        'Value adjusted to maximum allowed: ' + maxAllowed + ' months' +
                    '</span>' +
                    '<small class="text-muted d-block">Enter the number of months you want to repay this loan</small>';
                setTimeout(function() {
                    document.getElementById('maxRepayPeriodHint').innerHTML =
                        '<i class="bi bi-info-circle me-1"></i>' +
                        'Maximum allowed for this loan type: <strong>' + maxAllowed + ' months</strong>';
                }, 3000);
            } else if (enteredValue < 1) {
                this.value = 1;
            } else {
                document.getElementById('maxRepayPeriodHint').innerHTML =
                    '<i class="bi bi-info-circle me-1"></i>' +
                    'Maximum allowed for this loan type: <strong>' + maxAllowed + ' months</strong>' +
                    (enteredValue > 0 ? '<br><span class="text-success">Selected: ' + enteredValue + ' months</span>' : '');
            }
            updateLoanSummary();
        });

        // Update summary on amount or period change
        document.getElementById('principalAmount').addEventListener('input', updateLoanSummary);

        function updateLoanSummary() {
            if (!isMemberEligible) return;

            var amount = parseFloat(document.getElementById('principalAmount').value) || 0;
            var repayPeriod = parseInt(document.getElementById('repayPeriod').value) || 12;
            var selected = document.getElementById('loanType').options[document.getElementById('loanType').selectedIndex];

            if (!selected || !selected.value) {
                return;
            }

            var interestRate = parseFloat(selected.dataset.interest) || 0;
            var processingFee = parseFloat(selected.dataset.processingFee) || 0;
            var maxAmount = parseFloat(document.getElementById('principalAmount').getAttribute('max')) || 0;
            var maxRepayPeriod = currentMaxRepayPeriod;
            var repaymentMethod = selected.dataset.repayMethod || 'AMT';

            var loanSummary = document.getElementById('loanSummary');

            if (amount > 0 && interestRate > 0 && amount <= maxAmount && repayPeriod <= maxRepayPeriod && repayPeriod >= 1) {
                var monthlyRate = interestRate / 100 / 12;
                var months = repayPeriod;

                var emi = 0;
                var totalInterest = 0;
                var totalRepayable = 0;
                var netDisbursement = amount - (processingFee || 0);

                if (repaymentMethod === 'AMT') {
                    if (monthlyRate > 0) {
                        var factor = Math.pow(1 + monthlyRate, months);
                        emi = amount * monthlyRate * factor / (factor - 1);
                    } else {
                        emi = amount / months;
                    }
                    totalInterest = (emi * months) - amount;
                    totalRepayable = amount + totalInterest;
                } else if (repaymentMethod === 'STL') {
                    totalInterest = amount * (interestRate / 100) * (months / 12);
                    var monthlyPrincipal = amount / months;
                    var monthlyInterest = totalInterest / months;
                    emi = monthlyPrincipal + monthlyInterest;
                    totalRepayable = amount + totalInterest;
                } else if (repaymentMethod === 'RBAL') {
                    var monthlyPrincipal = amount / months;
                    var balance = amount;
                    var totalInterestRB = 0;
                    for (var i = 0; i < months; i++) {
                        var interest = balance * monthlyRate;
                        totalInterestRB += interest;
                        balance -= monthlyPrincipal;
                    }
                    totalInterest = totalInterestRB;
                    totalRepayable = amount + totalInterest;
                    emi = totalRepayable / months;
                } else {
                    var factor = Math.pow(1 + monthlyRate, months);
                    emi = amount * monthlyRate * factor / (factor - 1);
                    totalInterest = (emi * months) - amount;
                    totalRepayable = amount + totalInterest;
                }

                emi = Math.round(emi * 100) / 100;
                totalInterest = Math.round(totalInterest * 100) / 100;
                totalRepayable = Math.round(totalRepayable * 100) / 100;
                netDisbursement = Math.round(netDisbursement * 100) / 100;

                var methodDescription = '';
                if (repaymentMethod === 'AMT') {
                    methodDescription = '<span class="badge bg-info">Amortized (EMI)</span>';
                } else if (repaymentMethod === 'STL') {
                    methodDescription = '<span class="badge bg-primary">Straight Line (Flat Rate)</span>';
                } else if (repaymentMethod === 'RBAL') {
                    methodDescription = '<span class="badge bg-warning">Reducing Balance</span>';
                }

                loanSummary.innerHTML =
                    '<h6>Loan Summary <small class="text-muted">' + methodDescription + '</small></h6>' +
                    '<table class="table table-sm table-borderless">' +
                        '<tr><td>Principal:</td><td class="text-end fw-bold">KES ' + (amount || 0).toLocaleString() + '</td></tr>' +
                        '<tr><td>Interest Rate:</td><td class="text-end">' + interestRate + '% p.a.</td></tr>' +
                        '<tr><td>Repayment Period:</td><td class="text-end">' + months + ' months</td></tr>' +
                        '<tr><td>Monthly Payment:</td><td class="text-end fw-bold">KES ' + (emi || 0).toLocaleString() + '</td></tr>' +
                        '<tr><td>Total Interest:</td><td class="text-end">KES ' + (totalInterest || 0).toLocaleString() + '</td></tr>' +
                        ((processingFee || 0) > 0 ? '<tr><td>Processing Fee:</td><td class="text-end">KES ' + (processingFee || 0).toLocaleString() + '</td></tr>' +
                        '<tr><td>Net Disbursement:</td><td class="text-end fw-bold text-primary">KES ' + (netDisbursement || 0).toLocaleString() + '</td></tr>' : '') +
                        '<tr class="border-top"><td class="fw-bold">Total Repayable:</td><td class="text-end fw-bold text-primary">KES ' + (totalRepayable || 0).toLocaleString() + '</td></tr>' +
                    '</table>';
            } else {
                loanSummary.innerHTML =
                    '<i class="bi bi-calculator fs-1"></i>' +
                    '<p class="mt-3">Enter loan details to see summary</p>';
            }
        }

        // Form validation before submit
        document.getElementById('loanApplicationForm').addEventListener('submit', function(e) {
            if (!isMemberEligible) {
                e.preventDefault();
                Swal.fire('Error', 'Please select an eligible member first', 'error');
                return false;
            }

            var amount = parseFloat(document.getElementById('principalAmount').value) || 0;
            var maxAmount = parseFloat(document.getElementById('principalAmount').getAttribute('max')) || 0;
            var repayPeriod = parseInt(document.getElementById('repayPeriod').value) || 0;
            var maxRepayPeriod = currentMaxRepayPeriod;
            var loanType = document.getElementById('loanType').value;

            if (!loanType) {
                e.preventDefault();
                Swal.fire('Error', 'Please select a loan type', 'error');
                return false;
            }

            if (amount <= 0) {
                e.preventDefault();
                Swal.fire('Error', 'Please enter a valid loan amount', 'error');
                return false;
            }

            if (amount > maxAmount) {
                e.preventDefault();
                Swal.fire('Error', 'Loan amount cannot exceed KES ' + (maxAmount || 0).toLocaleString(), 'error');
                return false;
            }

            if (amount < 100) {
                e.preventDefault();
                Swal.fire('Error', 'Minimum loan amount is KES 100', 'error');
                return false;
            }

            if (repayPeriod <= 0) {
                e.preventDefault();
                Swal.fire('Error', 'Please enter a valid repayment period', 'error');
                return false;
            }

            if (repayPeriod > maxRepayPeriod) {
                e.preventDefault();
                Swal.fire('Error', 'Repayment period (' + repayPeriod + ' months) exceeds maximum allowed of ' + maxRepayPeriod + ' months for this loan type', 'error');
                return false;
            }

            var purpose = document.getElementById('Purpose').value.trim();
            if (!purpose) {
                e.preventDefault();
                Swal.fire('Error', 'Please enter the loan purpose', 'error');
                return false;
            }

            var submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

            return true;
        });

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('searchInput').focus();
            populateLoanTypes(allLoanTypes);
        });
    </script>
}