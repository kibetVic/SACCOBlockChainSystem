@using SACCOBlockChainSystem.Models.DTOs
@model List<LoanScheduleDTO>
@{
    ViewData["Title"] = "Loan Repayment Schedule";

    var loan = ViewBag.Loan as Loan;
    var member = ViewBag.Member as Member;
    var loanBalance = ViewBag.LoanBalance as Loanbal;
    var endmain = ViewBag.Endmain as Endmain;
    var repayments = ViewBag.Repayments as List<Repay> ?? new List<Repay>();

    decimal approvedAmount = ViewBag.ApprovedAmount ?? 0;
    decimal totalPrincipal = ViewBag.TotalPrincipal ?? 0;
    decimal totalInterest = ViewBag.TotalInterest ?? 0;
    decimal totalRepayable = ViewBag.TotalRepayable ?? 0;
    decimal totalPaid = ViewBag.TotalPaid ?? 0;
    decimal totalPrincipalPaid = ViewBag.TotalPrincipalPaid ?? 0;
    decimal totalInterestPaid = ViewBag.TotalInterestPaid ?? 0;
    decimal totalPenaltyPaid = ViewBag.TotalPenaltyPaid ?? 0;
    decimal totalOutstanding = ViewBag.TotalOutstanding ?? 0;
    string repaymentMethod = ViewBag.RepaymentMethod ?? "AMT";

    decimal totalPrincipalOutstanding = totalPrincipal - totalPrincipalPaid;
    decimal totalInterestOutstanding = totalInterest - totalInterestPaid;
    decimal paidPercentage = totalRepayable > 0 ? (totalPaid / totalRepayable) * 100 : 0;

    var methodNames = new Dictionary<string, string>
    {
        { "AMT", "Amortized (Equal Monthly Installments - EMI)" },
        { "STL", "Straight Line (Flat Rate)" },
        { "RBAL", "Reducing Balance (Interest Only Minimum)" }
    };
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-calendar-alt text-primary me-2"></i>
            Loan Repayment Schedule
        </h2>
        <div>
            <a asp-action="ExportSchedule" asp-route-loanNo="@loan?.LoanNo" class="btn btn-success">
                <i class="fas fa-file-excel me-2"></i> Export to CSV
            </a>
            <button onclick="window.print()" class="btn btn-secondary">
                <i class="fas fa-print me-2"></i> Print
            </button>
            <a asp-action="Details" asp-route-loanNo="@loan?.LoanNo" class="btn btn-primary">
                <i class="fas fa-arrow-left me-2"></i> Back to Loan Details
            </a>
        </div>
    </div>

    <!-- Loan Summary Card -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Loan Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="text-muted">Loan Number</label>
                    <p class="fw-bold">@loan?.LoanNo</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted">Member</label>
                    <p class="fw-bold">
                        @if (member != null)
                        {
                            <span>@member.Surname @member.OtherNames</span>
                        
                            <br />
                            <small class="text-muted">@member.MemberNo</small>
                        }
                        else
                        {
                            <span>@loan?.MemberNo</span>
                        }
                    </p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted">Repayment Method</label>
                    <p class="fw-bold">
                        <span class="badge bg-info">@repaymentMethod</span>
                        <br />
                        <small class="text-muted">@(methodNames.ContainsKey(repaymentMethod) ? methodNames[repaymentMethod] : repaymentMethod)</small>
                    </p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted">Interest Rate</label>
                    <p class="fw-bold">@loan?.Interest% per annum</p>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3">
                    <label class="text-muted">Principal Amount</label>
                    <p class="fw-bold text-primary">@approvedAmount.ToString("N2") KES</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted">Total Interest</label>
                    <p class="fw-bold text-warning">@totalInterest.ToString("N2") KES</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted">Total Repayable</label>
                    <p class="fw-bold text-success">@totalRepayable.ToString("N2") KES</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted">Repayment Period</label>
                    <p class="fw-bold">@(loan?.RepayPeriod) months</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Progress Card -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Payment Progress</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="text-center">
                        <h3>@totalPaid.ToString("N2") KES</h3>
                        <p class="text-muted">Total Paid</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-center">
                        <h3 class="text-danger">@totalOutstanding.ToString("N2") KES</h3>
                        <p class="text-muted">Outstanding Balance</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-center">
                        <h3 class="text-info">@totalPrincipalPaid.ToString("N2") KES</h3>
                        <p class="text-muted">Principal Paid</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-center">
                        <h3 class="text-warning">@totalInterestPaid.ToString("N2") KES</h3>
                        <p class="text-muted">Interest Paid</p>
                    </div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <span>Repayment Progress</span>
                    <span>@paidPercentage.ToString("F1")%</span>
                </div>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-success"
                         role="progressbar"
                         style="width: @paidPercentage%"
                         aria-valuenow="@paidPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @paidPercentage.ToString("F1")%
                    </div>
                </div>
            </div>

            <!-- RBAL Warning -->
            @if (repaymentMethod == "RBAL")
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>RBAL (Reducing Balance) Note:</strong> This is an interest-only minimum payment loan.
                    The principal balance of <strong>@approvedAmount.ToString("N2") KES</strong> remains unchanged
                    unless you make extra principal payments. Minimum payment shown is interest only.
                </div>
            }
        </div>
    </div>

    <!-- Schedule Table -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Repayment Schedule</h5>
        </div>
        <div class="card-body">
            <!-- Filter Controls -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by installment..." />
                        <button class="btn btn-outline-secondary" onclick="clearSearch()">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <select id="statusFilter" class="form-select">
                        <option value="all">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Partial">Partial</option>
                        <option value="Paid">Paid</option>
                        <option value="Overdue">Overdue</option>
                    </select>
                </div>
                <div class="col-md-7 text-end">
                    <button class="btn btn-sm btn-secondary" onclick="expandAll()">
                        <i class="fas fa-expand me-1"></i> Expand All
                    </button>
                    <button class="btn btn-sm btn-secondary" onclick="collapseAll()">
                        <i class="fas fa-compress me-1"></i> Collapse All
                    </button>
                </div>
            </div>

            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-bordered table-hover" id="scheduleTable">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th style="width: 100px;">Due Date</th>
                            <th class="text-end" style="width: 120px;">Principal (KES)</th>
                            <th class="text-end" style="width: 120px;">Interest (KES)</th>
                            <th class="text-end" style="width: 120px;">Total Due (KES)</th>
                            <th class="text-end" style="width: 120px;">Paid (KES)</th>
                            <th class="text-end" style="width: 120px;">Outstanding (KES)</th>
                            <th class="text-end" style="width: 100px;">Penalty (KES)</th>
                            <th style="width: 100px;">Status</th>
                            <th style="width: 120px;">Paid Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var index = 1;
                            foreach (var inst in Model)
                            {
                                var statusClass = inst.Status switch
                                {
                                    "Paid" => "table-success",
                                    "Partial" => "table-warning",
                                    "Overdue" => "table-danger",
                                    _ => ""
                                };
                                var statusIcon = inst.Status switch
                                {
                                    "Paid" => "fas fa-check-circle text-success",
                                    "Partial" => "fas fa-clock text-warning",
                                    "Overdue" => "fas fa-exclamation-circle text-danger",
                                    "Pending" => "fas fa-hourglass-half text-info",
                                    _ => "fas fa-question-circle"
                                };

                                <tr class="@statusClass" data-status="@inst.Status" data-installment="@inst.InstallmentNo">
                                    <td class="text-center">
                                        <strong>@inst.InstallmentNo</strong>
                                        @if (inst.IsFlexible)
                                        {
                                            <span class="badge bg-info ms-1" title="Flexible Payment">F</span>
                                        }
                                    </td>
                                    <td>@inst.DueDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">@inst.PrincipalAmount.ToString("N2")</td>
                                    <td class="text-end">@inst.InterestAmount.ToString("N2")</td>
                                    <td class="text-end fw-bold">@inst.TotalInstallment.ToString("N2")</td>
                                    <td class="text-end text-success">@inst.PaidAmount.ToString("N2")</td>
                                    <td class="text-end text-danger fw-bold">@inst.OutstandingAmount.ToString("N2")</td>
                                    <td class="text-end text-warning">@inst.PenaltyAmount.ToString("N2")</td>
                                    <td>
                                        <i class="@statusIcon me-1"></i>
                                        <span class="badge @(inst.Status == "Paid" ? "bg-success" : inst.Status == "Partial" ? "bg-warning" : inst.Status == "Overdue" ? "bg-danger" : "bg-secondary")">
                                            @inst.Status
                                        </span>
                                    </td>
                                    <td>@(inst.PaidDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <i class="fas fa-calendar-times fa-3x text-muted mb-3 d-block"></i>
                                    <h5>No schedule found</h5>
                                    <p class="text-muted">The loan schedule has not been generated yet.</p>
                                    <button onclick="generateSchedule()" class="btn btn-primary mt-2">
                                        <i class="fas fa-sync-alt me-2"></i> Generate Schedule
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-dark">
                        <tr>
                            <th colspan="2" class="text-end">Totals:</th>
                            <th class="text-end">@totalPrincipal.ToString("N2")</th>
                            <th class="text-end">@totalInterest.ToString("N2")</th>
                            <th class="text-end">@totalRepayable.ToString("N2")</th>
                            <th class="text-end">@totalPaid.ToString("N2")</th>
                            <th class="text-end">@totalOutstanding.ToString("N2")</th>
                            <th class="text-end">@(Model?.Sum(m => m.PenaltyAmount).ToString("N2") ?? "0.00")</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Repayment History Card -->
    @if (repayments.Any())
    {
        <div class="card mt-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Repayment History</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Receipt No</th>
                                <th class="text-end">Amount (KES)</th>
                                <th class="text-end">Principal (KES)</th>
                                <th class="text-end">Interest (KES)</th>
                                <th class="text-end">Penalty (KES)</th>
                                <th>Payment Method</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var repayment in repayments.OrderByDescending(r => r.DateReceived))
                            {
                                <tr>
                                    <td>@repayment.DateReceived?.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge bg-primary">@repayment.ReceiptNo</span></td>
                                    <td class="text-end fw-bold">@repayment.Amount?.ToString("N2")</td>
                                    <td class="text-end">@repayment.Principal?.ToString("N2")</td>
                                    <td class="text-end">@repayment.Interest?.ToString("N2")</td>
                                    <td class="text-end">@repayment.Penalty?.ToString("N2")</td>
                                    <td>@repayment.ApiKey</td>
                                    <td>@repayment.TransactionNo</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="2" class="text-end">Total:</th>
                                <th class="text-end">@totalPaid.ToString("N2")</th>
                                <th class="text-end">@totalPrincipalPaid.ToString("N2")</th>
                                <th class="text-end">@totalInterestPaid.ToString("N2")</th>
                                <th class="text-end">@totalPenaltyPaid.ToString("N2")</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .sticky-top {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 100;
    }

    .progress {
        border-radius: 25px;
        background-color: #e9ecef;
    }

    .progress-bar {
        transition: width 0.5s ease;
        border-radius: 25px;
    }

    .table-responsive::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 4px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    .highlight {
        background-color: #fff3cd !important;
    }

    @@media print {
        .btn, .input-group, .alert-warning, .card-header .btn {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .progress {
            border: 1px solid #ddd;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .sticky-top {
            position: relative !important;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            $('#searchInput').on('keyup', filterTable);
            $('#statusFilter').on('change', filterTable);
            initializeExpandCollapse();
        });

        function filterTable() {
            const searchTerm = $('#searchInput').val().toLowerCase();
            const statusFilter = $('#statusFilter').val();

            $('#scheduleTable tbody tr').each(function() {
                const row = $(this);
                const installment = row.find('td:first').text().toLowerCase();
                const status = row.data('status') || '';

                const matchesSearch = searchTerm === '' || installment.includes(searchTerm);
                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                if (matchesSearch && matchesStatus) {
                    row.show();
                } else {
                    row.hide();
                }
            });
        }

        function clearSearch() {
            $('#searchInput').val('');
            $('#statusFilter').val('all');
            $('#scheduleTable tbody tr').show();
        }

        function generateSchedule() {
            Swal.fire({
                title: 'Generate Schedule',
                text: 'Are you sure you want to generate the loan schedule?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Yes, generate',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoading(true);
                    $.ajax({
                        url: '@Url.Action("GenerateSchedule", "Loan")',
                        type: 'POST',
                        data: { loanNo: '@loan?.LoanNo' },
                        success: function(response) {
                            showLoading(false);
                            if (response.success) {
                                Swal.fire('Success!', response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            showLoading(false);
                            Swal.fire('Error', 'An error occurred while generating the schedule.', 'error');
                        }
                    });
                }
            });
        }

        function expandAll() {
            $('.collapse-row').removeClass('d-none').show();
        }

        function collapseAll() {
            $('.collapse-row').addClass('d-none').hide();
        }

        function initializeExpandCollapse() {
            // Add expand/collapse buttons to each row if needed
            $('tr[data-has-details="true"]').each(function() {
                const row = $(this);
                const detailsRow = $('<tr class="collapse-row d-none"><td colspan="10"><div class="p-3 bg-light">' +
                    '<strong>Details:</strong> ' + row.data('details') + '</div></td></tr>');
                row.after(detailsRow);
            });
        }

        function showLoading(show) {
            if (show) {
                $('#loadingOverlay').fadeIn(200);
            } else {
                $('#loadingOverlay').fadeOut(200);
            }
        }

        // Highlight search text
        function highlightText() {
            const searchTerm = $('#searchInput').val();
            if (!searchTerm) return;

            $('td').each(function() {
                const text = $(this).text();
                if (text.toLowerCase().includes(searchTerm.toLowerCase())) {
                    const regex = new RegExp(`(${searchTerm})`, 'gi');
                    const newText = text.replace(regex, '<span class="highlight">$1</span>');
                    $(this).html(newText);
                }
            });
        }
    </script>
}

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; text-align:center; padding-top:20%;">
    <div class="spinner-border text-light" style="width:3rem; height:3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="text-light mt-2">Generating schedule...</div>
</div>