@using System.Security.Claims
@* @using Radzen.Blazor *@

@{
    // ============================================================
    // USER ROLE VARIABLES - MUST BE DEFINED AT THE TOP
    // ============================================================
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    var isSuperAdmin = userRole == "Super Admin" || userRole == "SuperAdmin";
    var isCountyAdmin = userRole == "County Admin" || userRole == "CountyAdmin";
    var userGroupClaim = User.FindFirst("UserGroup")?.Value;
    var isMember = userGroupClaim == "MEMBER" || userGroupClaim == "Member" || userGroupClaim == "member";
    var companyCount = ViewBag.CompanyCount ?? 0;
}


