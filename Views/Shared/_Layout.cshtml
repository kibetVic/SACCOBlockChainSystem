    <link rel="icon" type="image/png" href="/AdminLte/dist/assets/img/Easyblock.png" />
    <title>@ViewData["Title"] - EasySacco MIS </title>
    <link href="~/Syncfusion/styles/material.css" rel="stylesheet" />
    <script src="~/Syncfusion/scripts/ej2.min.js"></script>
    <link rel="stylesheet" href="~/AdminLte/dist/css/adminlte.css" />
    <!-- Radzen CSS - Make sure these come after Bootstrap -->
