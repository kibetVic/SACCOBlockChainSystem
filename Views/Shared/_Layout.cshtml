                    <!-- Show only the role/user group -->
                    <li>
                        <div class="dropdown-item-text">
                            <i class="fas fa-user-tag me-2"></i>
                            <strong class="brand-text fw-bold fs-5">
                                @{
                                    // Debug: Check available claims
                                    var userGroupClaim = User.FindFirst("UserGroup")?.Value;
                                    var roleClaim = User.FindFirst(ClaimTypes.Role)?.Value;
                                    var userName = User.Identity?.Name;
                                    
                                    if (!string.IsNullOrEmpty(userGroupClaim))
                                    {
                                        @userGroupClaim
                                    }
                                    else if (!string.IsNullOrEmpty(roleClaim))
                                    {
                                        @roleClaim
                                    }
                                    else
                                    {
                                        @userName
                                    }
                                }
                            </strong>
                        </div>
                    </li>
                    <!--end::Brand Text-->
                </a>
                <!--end::Brand Link-->
            </div>
            <!--end::Sidebar Brand-->
