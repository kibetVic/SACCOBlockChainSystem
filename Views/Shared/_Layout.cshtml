                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        @using System.Security.Claims
                        @* @using Radzen.Blazor *@

                        @if (User.Identity.IsAuthenticated)
                        {
                            var userGroupClaims = User.FindFirstValue(ClaimTypes.Role);

                            <div class="company-info">
                                <small>
                                    @if (isSuperAdmin)
                                    {
                                        if (companyCount > 0)
                                        {
                                            <strong>@companyCount Integrated System SACCOs</strong>
                                        }
                                        else
                                        {
                                            <strong>System SACCOs</strong>
                                        }
                                    }
                                    else if (isCountyAdmin && Model.IsCountyView)
                                    {
                                        // County Admin - Show county name and number of SACCOs
                                        <strong>
                                            <i class="fas fa-map-marker-alt text-primary me-1"></i>
                                            @Model.CountyName County
                                            <span class="badge bg-info ms-1">@(Model.Companies?.Count ?? 0) SACCOs</span>
                                        </strong>
                                    }
                                    else if (isMember)
                                    {
                                        // For members, show the Employer field from Members table
                                        var memberEmployer = User.FindFirstValue("CompanyName") ?? "SACCO Member";
                                        <strong><i class="fas fa-building"></i> @memberEmployer</strong>
                                    }
                                    else
                                    {
                                        // For staff/admin users (non-county)
                                        <strong>@User.FindFirstValue("CompanyName")</strong>
                                    }
                                </small>
                            </div>
                        }
                    </li>
                </ul>
                <!--end::Start Navbar Links-->
                <!--begin::End Navbar Links-->
                <ul class="navbar-nav ms-auto">
                    <!--begin::Fullscreen Toggle-->
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>
                    <!--end::Fullscreen Toggle-->
                    <!--begin::User Menu Dropdown-->
                    <!--begin::User Menu Dropdown-->
                    <li class="nav-item dropdown user-menu">
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav ms-auto">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-user-circle me-1"></i>
                                            @{
                                                // Show username instead of role
                                                var userName = User.Identity?.Name;
                                            }
                                            @userName
                                        </a>
                                        <ul class="dropdown-menu">

                                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Super Admin"))
                                            {
                                                <li><hr class="dropdown-divider m-0"></li>
                                                <li><a class="dropdown-item" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Admin Panel</a></li>
                                            }

                                            @* <li><hr class="dropdown-divider m-0"></li> *@
                                            <li>
                                                <form method="post" asp-controller="Account" asp-action="LogoutPost">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="/Account/Login">
                                            <i class="fas fa-sign-in-alt me-1"></i>Login
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/Account/Signup">
                                            <i class="fas fa-user-plus me-1"></i>Register
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                    <!--end::User Menu Dropdown-->
                </ul>
                <!--end::End Navbar Links-->
            </div>
            <!--end::Container-->
