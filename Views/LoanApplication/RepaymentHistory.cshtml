@model List<SACCOBlockChainSystem.Models.DTOs.RepaymentHistoryDTO>
@{
    ViewData["Title"] = "Repayment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loanNo = ViewBag.LoanNo as string;
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">Repayment History - @loanNo</h4>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card text-center">
                    <div class="card-body">
                        <i class="fa fa-history" style="font-size: 64px; color: #ccc;"></i>
                        <h4 class="mt-3">No Payments Yet</h4>
                        <p class="text-muted">You haven't made any payments for this loan.</p>
                        <a href="@Url.Action("Repay", new { loanNo })" class="btn btn-primary">Make a Payment</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Receipt No</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Principal</th>
                                        <th>Interest</th>
                                        <th>Balance</th>
                                        <th>Method</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model)
                                    {
                                        <tr>
                                            <td><strong>@payment.ReceiptNo</strong></td>
                                            <td>@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@payment.Amount.ToString("N0")</td>
                                            <td>@payment.Principal.ToString("N0")</td>
                                            <td>@payment.Interest.ToString("N0")</td>
                                            <td>@payment.LoanBalance.ToString("N0")</td>
                                            <td>
                                                @if (payment.PaymentMethod == "MPESA")
                                                {
                                                    <span class="badge bg-success"><i class="fa fa-mobile-alt"></i> M-Pesa</span>
                                                }
                                                else if (payment.PaymentMethod == "CHEQUE")
                                                {
                                                    <span class="badge bg-info">Cheque</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Cash</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-success">Completed</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold bg-light">
                                        <td colspan="2" class="text-end">Totals:</td>
                                        <td>@Model.Sum(p => p.Amount).ToString("N0")</td>
                                        <td>@Model.Sum(p => p.Principal).ToString("N0")</td>
                                        <td>@Model.Sum(p => p.Interest).ToString("N0")</td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <a href="@Url.Action("Details", new { loanNo })" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left"></i> Back to Loan Details
                        </a>
                        <a href="@Url.Action("Repay", new { loanNo })" class="btn btn-primary">
                            <i class="fa fa-money-bill-wave"></i> Make Another Payment
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>