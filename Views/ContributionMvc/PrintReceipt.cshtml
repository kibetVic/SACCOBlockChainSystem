@using SACCOBlockChainSystem.Models.ViewModels
@model ReceiptViewModel

@{
    ViewData["Title"] = "Receipt";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt - @Model.ReceiptNo</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6f9;
            font-size: 13px;
        }

        /* SCREEN VIEW */
        .receipt-container {
            max-width: 650px;
            margin: 20px auto;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }

        .receipt-header {
            background: #28a745;
            color: #fff;
            text-align: center;
            padding: 15px;
        }

        .receipt-title {
            font-size: 22px;
            font-weight: bold;
        }

        .receipt-subtitle {
            font-size: 12px;
        }

        .company-details-header {
            background: #f8f9fa;
            text-align: center;
            padding: 10px;
            border-bottom: 2px solid #28a745;
        }

        .company-name {
            font-weight: bold;
            color: #28a745;
        }

        .receipt-body {
            padding: 15px;
        }

        .info-row {
            margin-bottom: 12px;
            border-bottom: 1px solid #eee;
            padding-bottom: 8px;
        }

        .info-label {
            font-weight: 600;
            color: #666;
            font-size: 11px;
        }

        .info-value {
            font-size: 13px;
        }

        .transaction-details {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 6px;
            margin: 10px 0;
        }

        .amount-value {
            font-size: 24px;
            font-weight: bold;
            color: #28a745;
        }

        .signature-section {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px dashed #dee2e6;
            display: flex;
            justify-content: space-between;
        }

        .signature-line {
            text-align: center;
        }

            .signature-line .line {
                width: 150px;
                border-top: 1px solid #000;
                margin-top: 25px;
                margin-bottom: 5px;
            }

        .receipt-footer {
            background: #f8f9fa;
            text-align: center;
            padding: 10px;
            font-size: 11px;
            border-top: 1px solid #ddd;
        }

        .btn-print {
            position: fixed;
            bottom: 20px;
            right: 20px;
        }

        .badge-blockchain {
            background: #6f42c1;
            color: white;
            font-size: 10px;
            padding: 3px 8px;
            border-radius: 12px;
            display: inline-block;
        }

        .qr-code {
            text-align: center;
            margin: 10px 0;
        }

        @@media print {

            @@page {
                size: 70mm auto;
                margin: 5mm;
            }

            html, body {
                width: 70mm !important;
                font-size: 12px !important;
                background: #fff !important;
            }

            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .receipt-container {
                width: 100% !important;
                padding: 5px !important;
            }
            /* FIX HEADER PRINT */
            .receipt-header {
                background: #000 !important;
                color: #fff !important;
                border: 1px solid #000 !important;
            }

            .receipt-title,
            .receipt-subtitle {
                color: #fff !important;
            }

            .receipt-no {
                font-size: 14px !important;
                font-weight: bold !important;
            }

            .info-row {
                margin-bottom: 12px !important;
            }

            .qr-code {
                display: block !important;
            }
        }
    </style>
</head>

<body>

    <!-- Buttons -->
    <div class="no-print text-center mb-3">
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fas fa-print"></i> Print / Save PDF
        </button>
        <button onclick="goBack()" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </button>
    </div>

    <div class="receipt-container">

        <!-- HEADER -->
        <div class="receipt-header">
            <div class="receipt-title">OFFICIAL RECEIPT</div>
            <div class="receipt-subtitle">Confirmation of Contribution</div>
        </div>

        <!-- COMPANY -->
        <div class="company-details-header">
            <div class="company-name">@Model.CompanyName</div>
            <div>@Model.CompanyAddress</div>
            <div>Tel: @Model.CompanyPhone | Email: @Model.CompanyEmail</div>
        </div>

        <!-- BODY -->
        <div class="receipt-body">

            <!-- Receipt No -->
            <div class="text-center mb-2">
                <span class="badge bg-success">Receipt No: @Model.ReceiptNo</span>
            </div>

            <!-- MEMBER -->
            <div class="info-row">
                <div class="info-label">Member Details</div>
                <div class="info-value">
                    Name: @Model.MemberName<br />
                    Member No: @Model.MemberNo
                    @if (!string.IsNullOrEmpty(Model.MemberIdNo))
                    {
                        <text><br />ID No: @Model.MemberIdNo</text>
                    }
                    @if (!string.IsNullOrEmpty(Model.MemberPhone))
                    {
                        <text><br />Phone: @Model.MemberPhone</text>
                    }
                </div>
            </div>

            <!-- TRANSACTION DETAILS -->
            <div class="transaction-details">
                <div class="info-label">Transaction Details</div>
                <div class="info-value">
                    Share Type: @Model.ShareTypeName<br />
                    Transaction Date: @Model.TransactionDate.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>

            <!-- PAYMENT METHOD -->
            <div class="method-details" style="background:#f8f9fa; padding:10px; border-radius:6px; margin:10px 0;">
                <strong>@Model.PaymentMethod</strong>
                @if (!string.IsNullOrEmpty(Model.ReferenceNo))
                {
                    <br />
                
                    <text>Reference: @Model.ReferenceNo</text>
                }
            </div>

            <!-- AMOUNT -->
            <div class="info-row">
                <div class="info-label">Amount Paid</div>
                <div class="amount-value">KES @Model.Amount.ToString("N2")</div>
            </div>

            <!-- SHARE BALANCE AFTER -->
            @if (Model.ShareBalanceAfter > 0)
            {
                <div class="info-row">
                    <div class="info-label">Updated Share Balance</div>
                    <div class="info-value">KES @Model.ShareBalanceAfter.ToString("N2")</div>
                </div>
            }

            <!-- REMARKS -->
            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="info-row">
                    <div class="info-label">Remarks</div>
                    <div class="info-value">@Model.Remarks</div>
                </div>
            }
        </div>

        <!-- FOOTER -->
        <div class="receipt-footer">
            <div>Processed by: @Model.CreatedBy</div>
            <div>Printed: @Model.PrintedAt.ToString("dd MMM yyyy HH:mm")</div>
            <div>This is a system generated receipt.</div>
            @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
            {
                <div class="mt-1">
                    <i class="fas fa-shield-alt"></i> Verified on Blockchain | Immutable & Tamper-Proof
                </div>
            }
        </div>

    </div>

    <!-- Floating button -->
    <div class="btn-print no-print">
        <button onclick="window.print()" class="btn btn-primary rounded-circle" style="width:60px;height:60px;">
            <i class="fas fa-print"></i>
        </button>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function goBack() {
            window.location.href = '@Url.Action("Index", "ContributionMvc")';
        }

        // Generate QR Code for verification (if needed)
        @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
        {
                <text>
                $(document).ready(function() {
                    var verificationData = {
                        receiptNo: '@Model.ReceiptNo',
                        memberNo: '@Model.MemberNo',
                        amount: '@Model.Amount',
                        blockchainTxId: '@Model.BlockchainTxId',
                        transactionDate: '@Model.TransactionDate.ToString("yyyy-MM-dd HH:mm:ss")',
                        companyCode: '@Model.CompanyCode'
                    };
                    var qrData = JSON.stringify(verificationData);
                    new QRCode(document.getElementById("qrcode"), {
                        text: qrData,
                        width: 100,
                        height: 100,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });
                });
                </text>
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

</body>
</html>