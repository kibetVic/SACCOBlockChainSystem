@model SACCOBlockChainSystem.Models.ViewModels.ReceiptViewModel
@{
    Layout = null;
    var companyName = Model.CompanyName ?? "SACCO BlockChain System";
    var companyAddress = Model.CompanyAddress ?? "P.O. Box 12345 - 00100, Nairobi, Kenya";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Contribution Receipt</title>
    <style>
        @@page {
            size: A5 portrait;
            margin: 0.5cm;
        }

        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 11px;
            margin: 0;
            padding: 10px;
            background: white;
            color: #333;
        }

        .receipt-container {
            max-width: 450px;
            margin: 0 auto;
            padding: 20px;
            border: 2px solid #333;
            border-radius: 8px;
            background: white;
        }

        .header {
            text-align: center;
            border-bottom: 3px double #333;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }

            .header .company-name {
                font-size: 18px;
                font-weight: bold;
                letter-spacing: 2px;
                color: #1a237e;
            }

            .header .company-details {
                font-size: 9px;
                color: #666;
                margin-top: 3px;
            }

            .header .receipt-title {
                font-size: 16px;
                font-weight: bold;
                margin-top: 8px;
                background: #1a237e;
                color: white;
                padding: 5px 20px;
                display: inline-block;
                border-radius: 3px;
            }

        .receipt-no {
            font-size: 14px;
            font-weight: bold;
            text-align: center;
            margin: 8px 0;
            padding: 8px;
            background: #e3f2fd;
            border-radius: 5px;
            border: 1px solid #90caf9;
        }

        .transaction-ref {
            font-size: 9px;
            text-align: center;
            color: #555;
            margin: 5px 0;
            padding: 5px;
            background: #f5f5f5;
            border-radius: 3px;
        }

        .date-time {
            text-align: center;
            font-size: 11px;
            color: #555;
            margin: 5px 0 10px 0;
            font-weight: bold;
        }

        .member-info {
            background: #f5f5f5;
            padding: 10px 12px;
            margin: 10px 0;
            border: 1px solid #e0e0e0;
            border-radius: 5px;
            font-size: 11px;
        }

            .member-info .row {
                display: flex;
                padding: 2px 0;
            }

            .member-info .label {
                font-weight: bold;
                color: #333;
                width: 100px;
                min-width: 100px;
            }

        .details {
            margin: 10px 0;
            padding: 10px 12px;
            background: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 5px;
            font-size: 11px;
        }

            .details .row {
                display: flex;
                justify-content: space-between;
                padding: 3px 0;
            }

            .details .label {
                font-weight: bold;
            }

        .blockchain-tx {
            font-size: 8px;
            word-break: break-all;
            background: #fafafa;
            padding: 8px;
            margin: 10px 0;
            border-radius: 5px;
            border: 1px solid #e0e0e0;
            font-family: monospace;
        }

        .footer {
            text-align: center;
            margin-top: 15px;
            padding-top: 10px;
            border-top: 3px double #333;
            font-size: 9px;
            color: #666;
        }

            .footer .thank-you {
                font-size: 12px;
                font-weight: bold;
                color: #1a237e;
                margin: 5px 0;
            }

        .print-button {
            text-align: center;
            margin-top: 20px;
        }

            .print-button button {
                padding: 10px 40px;
                background: #1a237e;
                color: white;
                border: none;
                border-radius: 5px;
                font-size: 14px;
                cursor: pointer;
                font-weight: bold;
            }

                .print-button button:hover {
                    background: #0d47a1;
                }

            .print-button .btn-close {
                padding: 10px 30px;
                background: #6c757d;
                color: white;
                border: none;
                border-radius: 5px;
                font-size: 14px;
                cursor: pointer;
                margin-left: 10px;
            }

                .print-button .btn-close:hover {
                    background: #5a6268;
                }

            .print-button .btn-home {
                padding: 10px 30px;
                background: #28a745;
                color: white;
                border: none;
                border-radius: 5px;
                font-size: 14px;
                cursor: pointer;
                margin-left: 10px;
            }

                .print-button .btn-home:hover {
                    background: #1e7e34;
                }

        @@media print {
            body {
                padding: 0;
                background: white;
            }

            .no-print {
                display: none !important;
            }

            .receipt-container {
                border: none;
                border-radius: 0;
                padding: 15px;
            }

            .header .receipt-title {
                background: #1a237e !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .receipt-no {
                background: #e3f2fd !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .member-info {
                background: #f5f5f5 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .details {
                background: #f9f9f9 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="receipt-container" id="receipt">
        <!-- Header -->
        <div class="header">
            <div class="company-name">@companyName</div>
            <div class="company-details">@companyAddress</div>
            <div class="company-details">Tel: @Model.CompanyPhone | Email: @Model.CompanyEmail</div>
            <div class="receipt-title">CONTRIBUTION RECEIPT</div>
        </div>

        <!-- Receipt Number -->
        <div class="receipt-no">
            <span class="label">Receipt No:</span> @Model.ReceiptNo
        </div>

        <!-- Transaction Reference -->
        <div class="transaction-ref">
            <strong>Transaction Receipt:</strong> @Model.TransactionReceiptNo
        </div>

        <!-- Date -->
        <div class="date-time">
            Date: @Model.TransactionDate.ToString("dd/MM/yyyy HH:mm")
        </div>

        <!-- Member Information -->
        <div class="member-info">
            <div class="row">
                <span class="label">Member No:</span>
                <span class="value">@Model.MemberNo</span>
            </div>
            <div class="row">
                <span class="label">Member Name:</span>
                <span class="value">@Model.MemberName</span>
            </div>
            <div class="row">
                <span class="label">ID Number:</span>
                <span class="value">@(Model.MemberIdNo ?? "N/A")</span>
            </div>
            <div class="row">
                <span class="label">Phone Number:</span>
                <span class="value">@(Model.MemberPhone ?? "N/A")</span>
            </div>
        </div>

        <!-- Contribution Details -->
        <div class="details">
            <div class="row">
                <span class="label">Share Type:</span>
                <span>@Model.ShareTypeName</span>
            </div>
            <div class="row">
                <span class="label">Amount:</span>
                <span><strong>KES @Model.Amount.ToString("N0")</strong></span>
            </div>
            <div class="row">
                <span class="label">Payment Method:</span>
                <span>@Model.PaymentMethod</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.ReferenceNo))
            {
                <div class="row">
                    <span class="label">Reference No:</span>
                    <span>@Model.ReferenceNo</span>
                </div>
            }
            <div class="row">
                <span class="label">Remarks:</span>
                <span>@Model.Remarks</span>
            </div>
            <div class="row">
                <span class="label">Processed By:</span>
                <span>@Model.CreatedBy</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="thank-you">Thank you for your contribution!</div>
            <div>Printed By: @Model.CreatedBy</div>
            <div>Printed At: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</div>
            <div style="margin-top:5px; font-size:8px; color:#999;">
                This is a system generated receipt. Blockchain verified.
            </div>
        </div>
    </div>

    <!-- Print Button -->
    <div class="print-button no-print">
        <button onclick="window.print()">
            <i class="fas fa-print"></i> Print Receipt
        </button>
        <button class="btn-close" onclick="window.close()">
            <i class="fas fa-times"></i> Close
        </button>
        <button class="btn-home" onclick="window.location.href='@Url.Action("Index", "ContributionMvc")'">
            <i class="fas fa-home"></i> Home
        </button>
    </div>

    <script>
        window.onload = function() {
            // Uncomment to auto-print
            // window.print();
        };
    </script>
</body>
</html>