@model SACCOBlockChainSystem.Models.DTOs.ContributionDeleteDTO
@{
    ViewData["Title"] = "Delete Transaction - Confirm";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-trash-alt me-2"></i>
                        Delete Transaction
                    </h3>
                    <div class="card-tools">
                        <span class="badge bg-danger">Super Admin Only</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning!</strong> This action is irreversible and will:
                        <ul class="mt-2 mb-0">
                            <li>Remove the contribution from all system tables</li>
                            <li>Reverse the share balance for the member</li>
                            <li>Create reversal entries in the General Ledger</li>
                            <li>Record this deletion on the blockchain for audit purposes</li>
                        </ul>
                    </div>

                    <!-- Transaction Details Card -->
                    <div class="card card-info mb-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                Transaction Details
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td style="width: 140px;"><strong>Receipt Number:</strong></td>
                                            <td><code>@Model.ReceiptNo</code></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Member No:</strong></td>
                                            <td><strong>@Model.MemberNo</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Member Name:</strong></td>
                                            <td>@Model.MemberName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Transaction Date:</strong></td>
                                            <td>@Model.TransactionDate?.ToString("dd MMM yyyy HH:mm:ss")</td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td style="width: 140px;"><strong>Share Type:</strong></td>
                                            <td>@Model.ShareTypeName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Amount:</strong></td>
                                            <td><strong class="text-danger h4">@Model.Amount?.ToString("C")</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Created By:</strong></td>
                                            <td>@Model.CreatedBy</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Blockchain Status:</strong></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-link"></i> On Chain
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="fas fa-unlink"></i> Not on Chain
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ContributionId" />
                        <input type="hidden" asp-for="ReceiptNo" />
                        <input type="hidden" asp-for="MemberNo" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="MemberName" />
                        <input type="hidden" asp-for="ShareTypeName" />
                        <input type="hidden" asp-for="TransactionDate" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="BlockchainTxId" />

                        <div class="form-group mb-3">
                            <label asp-for="DeleteReason" class="control-label required-field">
                                <i class="fas fa-comment me-1"></i> Reason for Deletion
                            </label>
                            <textarea asp-for="DeleteReason" class="form-control" rows="2"
                                      placeholder="Please provide a detailed reason for deleting this contribution..."
                                      required></textarea>
                            <span asp-validation-for="DeleteReason" class="text-danger"></span>
                            <small class="form-text text-muted">
                                This reason will be recorded on the blockchain and audit log.
                            </small>
                        </div>

                        <div class="form-group mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                <label class="form-check-label" for="confirmDelete">
                                    I understand that this action is irreversible and will delete the transaction from all system records.
                                </label>
                            </div>
                        </div>

                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-danger btn-lg" id="submitBtn" disabled>
                                <i class="fas fa-trash-alt me-2"></i> Permanently Delete Transaction
                            </button>
                            <a asp-action="DeleteSearch" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times me-2"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#confirmDelete').change(function() {
                $('#submitBtn').prop('disabled', !$(this).is(':checked'));
            });

            // Prevent accidental form submission
            $('#deleteForm').on('submit', function(e) {
                if (!$('#confirmDelete').is(':checked')) {
                    e.preventDefault();
                    alert('Please confirm that you understand the consequences of this action.');
                    return false;
                }

                if (!$('#DeleteReason').val().trim()) {
                    e.preventDefault();
                    alert('Please provide a reason for deletion.');
                    return false;
                }

                return confirm('WARNING: This will permanently delete this transaction. This action CANNOT be undone. Are you absolutely sure?');
            });
        });
    </script>
}