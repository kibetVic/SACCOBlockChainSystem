@model MemberViewModel
@{
    ViewData["Title"] = "My Wallet";
}

<style>
    /* ============================================
               RESPONSIVE WALLET STYLES
               ============================================ */

    :root {
        --primary-color: #2563EB;
        --primary-dark: #1D4ED8;
        --primary-light: #3B82F6;
        --success-color: #10B981;
        --success-dark: #059669;
        --danger-color: #EF4444;
        --warning-color: #F59E0B;
        --warning-dark: #D97706;
        --info-color: #8B5CF6;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-300: #D1D5DB;
        --gray-400: #9CA3AF;
        --gray-500: #6B7280;
        --gray-600: #4B5563;
        --gray-700: #374151;
        --gray-800: #1F2937;
        --gray-900: #111827;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: linear-gradient(135deg, var(--gray-50) 0%, var(--gray-100) 100%);
        min-height: 100vh;
    }

    /* Main Container */
    .wallet-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    /* Responsive Grid System */
    .wallet-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* Breadcrumb */
    .wallet-breadcrumb {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--gray-200);
    }

        .wallet-breadcrumb h2 {
            font-size: 1.75rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

            .wallet-breadcrumb h2 i {
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                font-size: 1.75rem;
            }

    /* Profile Card */
    .profile-card {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(37, 99, 235, 0.1);
    }

        .profile-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .profile-avatar {
        position: relative;
        margin-bottom: 1rem;
    }

        .profile-avatar img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--primary-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

    .avatar-edit {
        position: absolute;
        bottom: 0;
        right: 0;
        background: var(--primary-color);
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s ease;
        border: 2px solid white;
    }

        .avatar-edit:hover {
            background: var(--primary-dark);
            transform: scale(1.1);
        }

        .avatar-edit i {
            color: white;
            font-size: 0.875rem;
        }

    .profile-name {
        text-align: center;
    }

        .profile-name h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gray-800);
            margin-bottom: 0.25rem;
        }

        .profile-name p {
            font-size: 0.875rem;
            color: var(--gray-500);
        }

    /* Profile Info Grid */
    .profile-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .info-field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.5rem;
        background: var(--gray-50);
        border-radius: 0.75rem;
        transition: all 0.2s ease;
    }

        .info-field:hover {
            background: var(--gray-100);
            transform: translateX(2px);
        }

        .info-field label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--primary-color);
            letter-spacing: 0.5px;
        }

        .info-field .value {
            font-size: 0.9rem;
            color: var(--gray-800);
            font-weight: 500;
            word-break: break-word;
        }

    /* Wallet Card */
    .wallet-card {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border-radius: 1.5rem;
        padding: 1.5rem;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .wallet-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .wallet-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

    .wallet-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .wallet-icon {
        background: rgba(255, 255, 255, 0.2);
        width: 60px;
        height: 60px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .wallet-icon i {
            font-size: 2rem;
        }

    .wallet-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .wallet-balance-amount {
        margin-bottom: 1.5rem;
    }

        .wallet-balance-amount .label {
            font-size: 0.875rem;
            opacity: 0.8;
            margin-bottom: 0.5rem;
        }

        .wallet-balance-amount .amount {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1.2;
        }

    .wallet-address {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 0.75rem;
        padding: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        word-break: break-all;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .wallet-address:hover {
            background: rgba(0, 0, 0, 0.3);
        }

        .wallet-address span {
            flex: 1;
            font-family: 'Courier New', monospace;
        }

    /* Financial Summary Section */
    .financial-summary {
        margin-bottom: 2rem;
    }

    .section-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .section-header h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gray-800);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .section-header h3 i {
                color: var(--primary-color);
            }

    .financial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .financial-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .financial-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }

        .financial-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

    .contributions-card::before {
        background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
    }

    .share-card::before {
        background: linear-gradient(90deg, var(--success-color), var(--success-dark));
    }

    .deposits-card::before {
        background: linear-gradient(90deg, var(--warning-color), var(--warning-dark));
    }

    .card-icon {
        width: 60px;
        height: 60px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
    }

    .contributions-card .card-icon {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(59, 130, 246, 0.05));
        color: var(--primary-color);
    }

    .share-card .card-icon {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.05));
        color: var(--success-color);
    }

    .deposits-card .card-icon {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.05));
        color: var(--warning-color);
    }

    .card-content {
        flex: 1;
    }

        .card-content h4 {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--gray-500);
            margin-bottom: 0.5rem;
        }

        .card-content .amount {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--gray-800);
            margin-bottom: 0.25rem;
        }

    .card-footer {
        font-size: 0.75rem;
        color: var(--gray-400);
    }

    /* Balance Cards */
    .balance-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

        .balance-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

    .balance-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

        .balance-icon.wallet {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: white;
        }

        .balance-icon.available {
            background: linear-gradient(135deg, var(--success-color), var(--success-dark));
            color: white;
        }

        .balance-icon.deposit {
            background: linear-gradient(135deg, var(--info-color), #7C3AED);
            color: white;
        }

        .balance-icon.capital {
            background: linear-gradient(135deg, var(--warning-color), var(--warning-dark));
            color: white;
        }

    .balance-info {
        flex: 1;
    }

        .balance-info h4 {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--gray-500);
            margin-bottom: 0.25rem;
        }

        .balance-info .amount {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gray-800);
        }

    /* Loan Summary Styles */
    .loan-summary-section {
        margin-top: 1rem;
    }

    .loan-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .loan-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border-top: 4px solid;
    }

        .loan-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

    .active-loan {
        border-top-color: var(--success-color);
    }

    .no-loan {
        border-top-color: var(--gray-400);
    }

    .stats-card {
        border-top-color: var(--info-color);
    }

    .loan-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .loan-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
    }

        .loan-badge.active {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .loan-badge.inactive {
            background: rgba(107, 114, 128, 0.1);
            color: var(--gray-500);
        }

        .loan-badge.stats {
            background: rgba(139, 92, 246, 0.1);
            color: var(--info-color);
        }

    .loan-header i {
        font-size: 1.5rem;
        color: var(--gray-400);
    }

    .loan-details {
        margin-bottom: 1rem;
    }

    .loan-item {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--gray-100);
    }

        .loan-item label {
            font-size: 0.875rem;
            color: var(--gray-500);
        }

        .loan-item .value {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--gray-800);
        }

            .loan-item .value.highlight {
                color: var(--primary-color);
                font-size: 1rem;
            }

    .loan-progress {
        margin-top: 1rem;
    }

    .progress-bar {
        background: var(--gray-200);
        border-radius: 1rem;
        height: 8px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .progress-fill {
        background: linear-gradient(90deg, var(--success-color), var(--success-dark));
        height: 100%;
        border-radius: 1rem;
        transition: width 0.3s ease;
    }

    /* Transactions Section */
    .transactions-card {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }

    .transaction-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-height: 500px;
        overflow-y: auto;
    }

    .transaction-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        background: var(--gray-50);
        border-radius: 1rem;
        transition: all 0.2s ease;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .transaction-item:hover {
            background: var(--gray-100);
            transform: translateX(4px);
        }

    .transaction-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
    }

        .transaction-icon.deposit {
            color: var(--success-color);
        }

        .transaction-icon.withdrawal {
            color: var(--danger-color);
        }

        .transaction-icon.payment {
            color: var(--primary-color);
        }

    .transaction-details {
        flex: 2;
        min-width: 150px;
    }

        .transaction-details h4 {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.25rem;
        }

        .transaction-details .meta {
            font-size: 0.75rem;
            color: var(--gray-500);
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

    .transaction-amount {
        text-align: right;
        min-width: 120px;
    }

    .amount-positive {
        color: var(--success-color);
    }

    .amount-negative {
        color: var(--danger-color);
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
        text-decoration: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: white;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid var(--gray-300);
        color: var(--gray-700);
    }

        .btn-outline:hover {
            background: var(--gray-50);
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

    .btn-apply-loan {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: white;
        border: none;
        padding: 0.625rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        width: 100%;
        justify-content: center;
    }

        .btn-apply-loan:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
        }

    /* Stats Details */
    .stats-details {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        background: var(--gray-50);
        border-radius: 0.5rem;
        transition: all 0.2s ease;
    }

        .stat-item:hover {
            background: var(--gray-100);
            transform: translateX(4px);
        }

    .stat-label {
        font-size: 0.875rem;
        color: var(--gray-600);
    }

    .stat-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--gray-800);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .wallet-container

    {
        padding: 1rem;
    }

    .wallet-grid {
        grid-template-columns: 1fr;
    }

    .financial-grid {
        grid-template-columns: 1fr;
    }

    .loan-grid {
        grid-template-columns: 1fr;
    }

    .transaction-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .transaction-amount {
        text-align: left;
        width: 100%;
    }

    }

    .time-greeting-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 1rem;
        padding: 0.75rem 1.5rem;
        color: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: default;
    }

        .time-greeting-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

    .greeting-content {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .greeting-icon {
        font-size: 2rem;
        animation: wave 2s ease-in-out infinite;
        transform-origin: 70% 70%;
    }

    @@keyframes wave {
        0% {
            transform: rotate(0deg);
        }

        10% {
            transform: rotate(14deg);
        }

        20% {
            transform: rotate(-8deg);
        }

        30% {
            transform: rotate(14deg);
        }

        40% {
            transform: rotate(-4deg);
        }

        50% {
            transform: rotate(10deg);
        }

        60% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(0deg);
        }
    }

    .greeting-text {
        text-align: right;
    }

    .greeting-message {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .current-time {
        font-size: 0.875rem;
        opacity: 0.95;
        font-family: 'Courier New', monospace;
    }

    @@media (max-width: 768px) {
        .wallet-breadcrumb > div {
            flex-direction: column;
            align-items: flex-start;
        }

        .time-greeting-card {
            width: 100%;
        }

        .greeting-content {
            justify-content: space-between;
        }

        .greeting-text {
            text-align: left;
        }
    }
</style>

<div class="wallet-container">
    <!-- Breadcrumb -->
    <div class="wallet-breadcrumb">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <h2>
                <i class="fas fa-wallet"></i>
                My Wallet Dashboard
            </h2>

            <!-- Welcome Banner with Time Greeting -->
            <div class="time-greeting-card">
                <div class="greeting-content">
                    <div class="greeting-icon">
                        <i class="fas fa-smile-wink"></i>
                    </div>
                    <div class="greeting-text">
                        <div id="greetingMessage" class="greeting-message">Good day!</div>
                        <div id="currentTimeDisplay" class="current-time"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>  

    <!-- First Row: Profile and Wallet Information -->
    <div class="wallet-grid">
        <!-- Profile Card -->
        <div class="profile-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(Model.Member.Photo))
                    {
                        <img src="@Model.Member.Photo" alt="Profile">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?background=2563EB&color=fff&name=@Uri.EscapeDataString(Model.Member.Surname + "+" + Model.Member.OtherNames)" alt="Profile">
                    }
                    <div class="avatar-edit">
                        <i class="fas fa-camera"></i>
                    </div>
                </div>
                <div class="profile-name">
                    <h3>@Model.Member.Surname @Model.Member.OtherNames</h3>
                    <p>Member since @Model.Member.ApplicDate?.ToString("MMM yyyy")</p>
                </div>
            </div>

            <div class="profile-info-grid">
                <div class="info-field">
                    <label>Member Number</label>
                    <div class="value">@Model.Member.MemberNo</div>
                </div>
                <div class="info-field">
                    <label>ID Number</label>
                    <div class="value">@(string.IsNullOrEmpty(Model.Member.Idno) ? "Not provided" : Model.Member.Idno)</div>
                </div>
                <div class="info-field">
                    <label>Email Address</label>
                    <div class="value">@(string.IsNullOrEmpty(Model.Member.Email) ? "Not provided" : Model.Member.Email)</div>
                </div>
                <div class="info-field">
                    <label>Phone Number</label>
                    <div class="value">@(string.IsNullOrEmpty(Model.Member.PhoneNo) ? "Not provided" : Model.Member.PhoneNo)</div>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/MemberMvc/MyProfile" class="btn btn-primary">
                    <i class="fas fa-user-edit"></i> Edit Profile
                </a>
                <button class="btn btn-outline" onclick="refreshWallet()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
        </div>

        <!-- Wallet Card -->
        @foreach (var wallet in Model.Wallets)
        {
            <div class="wallet-card">
                <div class="wallet-header">
                    <div class="wallet-icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <div class="wallet-badge">
                        <i class="fas fa-check-circle"></i> Active
                    </div>
                </div>

                <div class="wallet-balance-amount">
                    <div class="label">Total Balance</div>
                    <div class="amount">KES @wallet.Balance.ToString("N2")</div>
                </div>

                <div class="wallet-address" onclick="copyToClipboard('@wallet.Address')">
                    <span>@Html.Raw(wallet.Address.Length > 35 ? wallet.Address.Substring(0, 35) + "..." : wallet.Address)</span>
                    <i class="far fa-copy"></i>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                    <button class="btn btn-outline" style="flex: 1; background: rgba(255,255,255,0.1); color: white;" onclick="copyToClipboard('@wallet.Address')">
                        <i class="far fa-copy"></i> Copy Address
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Second Row: Financial Summary -->
    <div class="financial-summary">
        <div class="section-header">
            <h3><i class="fas fa-chart-pie"></i> Financial Summary</h3>
            <span class="transaction-count" style="font-size: 0.875rem; color: var(--gray-500);">
                <i class="fas fa-calendar-alt"></i> Real-time updates
            </span>
        </div>

        <div class="financial-grid">
            <!-- Contributions Card -->
            <div class="financial-card contributions-card">
                <div class="card-icon">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <div class="card-content">
                    <h4>Total Contributions</h4>
                    <div class="amount">KES @Model.TotalContributions.ToString("N2")</div>
                    <div class="card-footer">
                        <span class="label"><i class="fas fa-users"></i> Member contributions</span>
                    </div>
                </div>
            </div>

            <!-- Share Capital Card -->
            <div class="financial-card share-card">
                <div class="card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="card-content">
                    <h4>Share Capital</h4>
                    <div class="amount">KES @Model.TotalShareCapital.ToString("N2")</div>
                    <div class="card-footer">
                        <span class="label"><i class="fas fa-percent"></i> Your ownership stake</span>
                    </div>
                </div>
            </div>

            <!-- Deposits Card -->
            <div class="financial-card deposits-card">
                <div class="card-icon">
                    <i class="fas fa-piggy-bank"></i>
                </div>
                <div class="card-content">
                    <h4>Total Deposits</h4>
                    <div class="amount">KES @Model.TotalDeposits.ToString("N2")</div>
                    <div class="card-footer">
                        <span class="label"><i class="fas fa-savings"></i> Savings deposits</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Balance Cards Row -->
        <div class="financial-grid">
            <div class="balance-card">
                <div class="balance-icon wallet">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="balance-info">
                    <h4>Wallet Balance</h4>
                    <div class="amount">KES @Model.Wallets.FirstOrDefault()?.Balance.ToString("N2")</div>
                </div>
            </div>
            <div class="balance-card">
                <div class="balance-icon available">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="balance-info">
                    <h4>Available Balance</h4>
                    @{
                        var walletBal = Model.Wallets.FirstOrDefault()?.Balance ?? 0;
                        var loanDeduction = Model.CurrentLoanBalance > 0 ? Model.CurrentLoanBalance * 0.1m : 0;
                        var availBalance = walletBal - loanDeduction;
                    }
                    <div class="amount">KES @availBalance.ToString("N2")</div>
                </div>
            </div>
            <div class="balance-card">
                <div class="balance-icon deposit">
                    <i class="fas fa-piggy-bank"></i>
                </div>
                <div class="balance-info">
                    <h4>Deposit Balance</h4>
                    <div class="amount">KES @Model.Wallets.FirstOrDefault()?.DepositBalance.ToString("N2")</div>
                </div>
            </div>
            <div class="balance-card">
                <div class="balance-icon capital">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="balance-info">
                    <h4>Capital Balance</h4>
                    <div class="amount">KES @Model.Wallets.FirstOrDefault()?.CapitalBalance.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Third Row: Loan Portfolio -->
    <div class="loan-summary-section">
        <div class="section-header">
            <h3><i class="fas fa-hand-holding-heart"></i> Loan Portfolio</h3>
        </div>
        <div class="loan-grid">
            @if (Model.HasActiveLoan)
            {
                <!-- Active Loan Card -->
                <div class="loan-card active-loan">
                    <div class="loan-header">
                        <span class="loan-badge active"><i class="fas fa-check-circle"></i> Active Loan</span>
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <div class="loan-details">
                        <div class="loan-item">
                            <label>Loan Amount</label>
                            <span class="value">KES @Model.CurrentLoanAmount.ToString("N2")</span>
                        </div>
                        <div class="loan-item">
                            <label>Balance</label>
                            <span class="value highlight">KES @Model.CurrentLoanBalance.ToString("N2")</span>
                        </div>
                        <div class="loan-item">
                            <label>Repaid</label>
                            <span class="value">KES @Model.TotalLoanRepaid.ToString("N2")</span>
                        </div>
                        <div class="loan-item">
                            <label>Interest Accrued</label>
                            <span class="value">KES @Model.TotalLoanInterest.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="loan-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @(Model.CurrentLoanAmount > 0 ? (Model.TotalLoanRepaid / Model.CurrentLoanAmount * 100) : 0)%"></div>
                        </div>
                        <span class="progress-text">@(Model.CurrentLoanAmount > 0 ? ((Model.TotalLoanRepaid / Model.CurrentLoanAmount) * 100).ToString("F0") : 0)% Repaid</span>
                    </div>
                </div>
            }
            else
            {
                <!-- No Active Loan Card -->
                <div class="loan-card no-loan">
                    <div class="loan-header">
                        <span class="loan-badge inactive"><i class="fas fa-minus-circle"></i> No Active Loan</span>
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="loan-details">
                        <p style="color: var(--gray-500); margin-bottom: 1rem;">
                            <i class="fas fa-info-circle"></i> You don't have any active loans at the moment.
                        </p>
                        <a class="btn btn-apply-loan" asp-controller="LoanApplication" asp-action="MobileLoan">
                            <i class="fas fa-plus-circle"></i> Apply for Loan
                        </a>
                        @* <button class="btn-apply-loan" onclick="location.href='/LoanApplication/MobileLoan">
                            <i class="fas fa-plus-circle"></i> Apply for Loan
                        </button> *@
                    </div>
                </div>
            }

            <!-- Loan Statistics Card -->
            <div class="loan-card stats-card">
                <div class="loan-header">
                    <span class="loan-badge stats"><i class="fas fa-chart-bar"></i> Loan History</span>
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stats-details">
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-money-bill-wave"></i> Total Loans Taken</span>
                        <span class="stat-value">KES @Model.TotalAllLoans.ToString("N2")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-play-circle"></i> Active Loans</span>
                        <span class="stat-value">@Model.ActiveLoansCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-check-double"></i> Completed Loans</span>
                        <span class="stat-value">@Model.CompletedLoansCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fourth Row: Recent Transactions -->
    <div class="transactions-card">
        <div class="section-header">
            <span><i class="fas fa-history"></i> Recent Transactions</span>
            <span class="transaction-count" style="font-size: 0.875rem; color: var(--gray-500);">
                Last @Model.MemberTransactions.Count() transactions
            </span>
        </div>

        @if (Model.MemberTransactions != null && Model.MemberTransactions.Any())
        {
            <div class="transaction-list">
                @foreach (var trans in Model.MemberTransactions.Take(20))
                {
                    <div class="transaction-item">
                        <div class="transaction-icon @(trans.TransactionType?.ToLower().Contains("deposit") == true ? "deposit" :
                                                                                    trans.TransactionType?.ToLower().Contains("withdrawal") == true ? "withdrawal" : "payment")">
                    @if (trans.TransactionType?.ToLower().Contains("deposit") == true)
                            {
                                <i class="fas fa-arrow-down"></i>
                            }
                            else if (trans.TransactionType?.ToLower().Contains("withdrawal") == true)
                            {
                                <i class="fas fa-arrow-up"></i>
                            }
                            else
                            {
                                <i class="fas fa-exchange-alt"></i>
                            }
                        </div>
                        <div class="transaction-details">
                            <h4>@trans.TransactionType</h4>
                            <div class="meta">
                                <span><i class="fas fa-hashtag"></i> @(trans.TransactionId?.Length > 20 ? trans.TransactionId.Substring(0, 20) + "..." : trans.TransactionId)</span>
                                <span><i class="fas fa-check-circle"></i> @trans.Status</span>
                            </div>
                        </div>
                        <div class="transaction-amount">
                            <div class="amount @(trans.Amount > 0 ? "amount-positive" : "amount-negative")">
                                @(trans.Amount > 0 ? "+" : "") KES @Math.Abs(trans.Amount).ToString("N2")
                            </div>
                            <div class="date" style="font-size: 0.75rem; color: var(--gray-500);">
                                <i class="far fa-calendar-alt"></i> @trans.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="text-align: center; padding: 3rem; color: var(--gray-400);">
                <i class="fas fa-receipt" style="font-size: 3rem; margin-bottom: 1rem;"></i>
                <p>No transactions found</p>
                <small>Your recent transactions will appear here</small>
            </div>
        }
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            showToast('Address copied to clipboard!');
        }, function(err) {
            console.error('Could not copy text: ', err);
        });
    }

    function showToast(message) {
        const existingToast = document.querySelector('.toast-notification');
        if (existingToast) existingToast.remove();

        const toast = document.createElement('div');
        toast.className = 'toast-notification';
        toast.innerHTML = `<i class="fas fa-check-circle"></i> ${message}`;
        toast.style.cssText = 'position: fixed; bottom: 20px; right: 20px; background: var(--gray-800); color: white; padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-size: 0.875rem; z-index: 1000; animation: slideIn 0.3s ease;';
        document.body.appendChild(toast);

        setTimeout(() => toast.remove(), 3000);
    }

    @* function refreshWallet() {
        showToast('Refreshing wallet data...');
        setTimeout(() => location.reload(), 500);
    }

    let autoRefreshInterval;
    function startAutoRefresh() {
        if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        autoRefreshInterval = setInterval(() => {
            if (!document.hidden) refreshWallet();
        }, 60000);
    }

    document.addEventListener('DOMContentLoaded', startAutoRefresh);
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        } else {
            startAutoRefresh();
        }
    }); *@

    // Update time and greeting dynamically
    function updateTimeAndGreeting() {
        const now = new Date();
        const hours = now.getHours();
        const minutes = now.getMinutes();

        // Format time
        const formattedTime = now.toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
        });

        // Format date
        const formattedDate = now.toLocaleDateString('en-US', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });

        // Determine greeting based on time of day
        let greeting = '';
        let emoji = '';

        if (hours >= 5 && hours < 12) {
            greeting = 'Good Morning';
            emoji = '🌅';
        } else if (hours >= 12 && hours < 17) {
            greeting = 'Good Afternoon';
            emoji = '☀️';
        } else if (hours >= 17 && hours < 21) {
            greeting = 'Good Evening';
            emoji = '🌆';
        } else {
            greeting = 'Good Night';
            emoji = '🌙';
        }

        // Update the DOM
        const greetingElement = document.getElementById('greetingMessage');
        const timeElement = document.getElementById('currentTimeDisplay');

        if (greetingElement) {
            greetingElement.innerHTML = `${greeting}, @Model.Member.Surname ! ${emoji}`;
        }

        if (timeElement) {
            timeElement.innerHTML = `<i class="far fa-calendar-alt"></i> ${formattedDate} &nbsp;|&nbsp; <i class="far fa-clock"></i> ${formattedTime}`;
        }
    }

    // Update immediately and then every second
    updateTimeAndGreeting();
    setInterval(updateTimeAndGreeting, 1000);
</script>