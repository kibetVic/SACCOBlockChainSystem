@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model MemberViewModel
@{
    ViewData["Title"] = "My Wallet";
}

<style>
    /* ============================================
           RESPONSIVE WALLET STYLES
           ============================================ */

    :root {
        --primary-color: #2563EB;
        --primary-dark: #1D4ED8;
        --success-color: #10B981;
        --danger-color: #EF4444;
        --warning-color: #F59E0B;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-300: #D1D5DB;
        --gray-400: #9CA3AF;
        --gray-500: #6B7280;
        --gray-600: #4B5563;
        --gray-700: #374151;
        --gray-800: #1F2937;
        --gray-900: #111827;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: var(--gray-50);
    }

    /* Main Container */
    .wallet-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem;
    }

    /* Responsive Grid System */
    .wallet-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* Breadcrumb */
    .wallet-breadcrumb {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--gray-200);
    }

        .wallet-breadcrumb h2 {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--gray-800);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

            .wallet-breadcrumb h2 i {
                color: var(--primary-color);
                font-size: 1.75rem;
            }

    /* Wallet Card */
    .wallet-card {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border-radius: 1.5rem;
        padding: 1.5rem;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .wallet-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .wallet-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

    .wallet-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .wallet-icon svg {
        width: 60px;
        height: 60px;
        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
    }

    .wallet-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .wallet-member-info {
        margin-bottom: 1.5rem;
    }

        .wallet-member-info h3 {
            font-size: 1rem;
            font-weight: 500;
            opacity: 0.9;
            margin-bottom: 0.25rem;
        }

        .wallet-member-info h4 {
            font-size: 1.25rem;
            font-weight: 600;
            word-break: break-all;
        }

    .wallet-balance-amount {
        margin-bottom: 1.5rem;
    }

        .wallet-balance-amount .label {
            font-size: 0.875rem;
            opacity: 0.8;
            margin-bottom: 0.5rem;
        }

        .wallet-balance-amount .amount {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1.2;
        }

    @@media (max-width: 640px) {
        .wallet-balance-amount .amount

    {
        font-size: 1.75rem;
    }

    }

    .wallet-address {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 0.75rem;
        padding: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        word-break: break-all;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .wallet-address:hover {
            background: rgba(0, 0, 0, 0.3);
        }

        .wallet-address span {
            flex: 1;
            font-family: 'Courier New', monospace;
        }

        .wallet-address i {
            cursor: pointer;
            font-size: 1rem;
            opacity: 0.8;
            transition: opacity 0.2s ease;
        }

            .wallet-address i:hover {
                opacity: 1;
            }

    /* Profile Card */
    .profile-card {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
    }

    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .profile-avatar {
        position: relative;
        margin-bottom: 1rem;
    }

        .profile-avatar img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--gray-200);
        }

    .avatar-edit {
        position: absolute;
        bottom: 0;
        right: 0;
        background: var(--primary-color);
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .avatar-edit:hover {
            background: var(--primary-dark);
        }

        .avatar-edit i {
            color: white;
            font-size: 0.875rem;
        }

    .profile-name {
        text-align: center;
    }

        .profile-name h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.25rem;
        }

        .profile-name p {
            font-size: 0.875rem;
            color: var(--gray-500);
        }

    /* Profile Info Grid */
    .profile-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .info-field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

        .info-field label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--gray-500);
            letter-spacing: 0.5px;
        }

        .info-field .value {
            font-size: 1rem;
            color: var(--gray-800);
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--gray-200);
            word-break: break-word;
        }

    /* Balance Cards */
    .balance-card {
        background: white;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
    }

        .balance-card:hover {
            transform: translateX(4px);
        }

    .balance-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

        .balance-icon.deposit {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .balance-icon.capital {
            background: rgba(37, 99, 235, 0.1);
            color: var(--primary-color);
        }

    .balance-info {
        flex: 1;
    }

        .balance-info h4 {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--gray-500);
            margin-bottom: 0.25rem;
        }

        .balance-info .amount {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gray-800);
        }

    /* Transactions Section */
    .transactions-card {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .transaction-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .transaction-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        background: var(--gray-50);
        border-radius: 1rem;
        transition: all 0.2s ease;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .transaction-item:hover {
            background: var(--gray-100);
            transform: translateX(4px);
        }

    .transaction-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
    }

        .transaction-icon i {
            font-size: 1.25rem;
        }

        .transaction-icon.deposit {
            color: var(--success-color);
        }

        .transaction-icon.withdrawal {
            color: var(--danger-color);
        }

        .transaction-icon.payment {
            color: var(--primary-color);
        }

    .transaction-details {
        flex: 2;
        min-width: 150px;
    }

        .transaction-details h4 {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.25rem;
        }

        .transaction-details .meta {
            font-size: 0.75rem;
            color: var(--gray-500);
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

    .transaction-amount {
        text-align: right;
        min-width: 120px;
    }

        .transaction-amount .amount {
            font-size: 1rem;
            font-weight: 600;
            color: var(--gray-800);
        }

        .transaction-amount .date {
            font-size: 0.75rem;
            color: var(--gray-500);
        }

    .amount-positive {
        color: var(--success-color);
    }

    .amount-negative {
        color: var(--danger-color);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-400);
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--primary-color);
        color: white;
    }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid var(--gray-300);
        color: var(--gray-700);
    }

        .btn-outline:hover {
            background: var(--gray-50);
            border-color: var(--gray-400);
        }

    /* Toast Notification */
    .toast-notification {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: var(--gray-800);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        z-index: 1000;
        animation: slideIn 0.3s ease;
    }

    @@keyframes slideIn {
        from

    {
        transform: translateX(100%);
        opacity: 0;
    }

    to {
        transform: translateX(0);
        opacity: 1;
    }

    }

    /* Responsive Adjustments */
    @@media (max-width: 768px) {
        .wallet-container

    {
        padding: 0.75rem;
    }

    .wallet-grid {
        gap: 1rem;
    }

    .wallet-card {
        padding: 1rem;
    }

    .profile-card {
        padding: 1rem;
    }

    .profile-info-grid {
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .transaction-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .transaction-amount {
        text-align: left;
        width: 100%;
    }

    .transaction-details {
        width: 100%;
    }

    .section-title {
        font-size: 1.125rem;
    }

    }

    @@media (max-width: 480px) {
        .wallet-balance-amount .amount

    {
        font-size: 1.5rem;
    }

    .balance-card {
        padding: 0.75rem;
    }

    .balance-icon {
        width: 40px;
        height: 40px;
        font-size: 1.25rem;
    }

    .balance-info .amount {
        font-size: 1rem;
    }

    .btn {
        width: 100%;
    }

    }

    /* Scrollbar Styling */
    .transaction-list::-webkit-scrollbar {
        width: 6px;
    }

    .transaction-list::-webkit-scrollbar-track {
        background: var(--gray-100);
        border-radius: 3px;
    }

    .transaction-list::-webkit-scrollbar-thumb {
        background: var(--gray-300);
        border-radius: 3px;
    }

        .transaction-list::-webkit-scrollbar-thumb:hover {
            background: var(--gray-400);
        }
</style>

<div class="wallet-container">
    <!-- Breadcrumb -->
    <div class="wallet-breadcrumb">
        <h2>
            <i class="fas fa-wallet"></i>
            My Wallet
        </h2>
    </div>

    <!-- Main Grid -->
    <div class="wallet-grid">
        <!-- Wallet Card Section -->
        <div class="profile-card wallet-info-card">
            @foreach (var wallet in Model.Wallets)
            {
                <div class="profile-header">
                    <div class="profile-avatar wallet-avatar">
                        <div class="wallet-icon-large">
                            <i class="fas fa-wallet"></i>
                        </div>
                    </div>
                    <div class="profile-name">
                        <h3>Wallet Information</h3>
                        <p>Active Wallet</p>
                    </div>
                </div>

                <div class="profile-info-grid">
                    <div class="info-field">
                        <label>Member Number</label>
                        <div class="value">@wallet.memberNo</div>
                    </div>
                    <div class="info-field">
                        <label>Total Balance</label>
                        <div class="value amount-highlight">KES @wallet.Balance.ToString("N2")</div>
                    </div>
                    <div class="info-field">
                        <label>Wallet Address</label>
                        <div class="value wallet-address-value" onclick="copyToClipboard('@wallet.Address')">
                            <span>@Html.Raw(wallet.Address.Length > 35 ? wallet.Address.Substring(0, 35) + "..." : wallet.Address)</span>
                            <i class="far fa-copy"></i>
                        </div>
                    </div>
                    <div class="info-field">
                        <label>Status</label>
                        <div class="value">
                            <span class="status-badge active">
                                <i class="fas fa-check-circle"></i> Active
                            </span>
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <button class="btn btn-outline" onclick="copyToClipboard('@wallet.Address')">
                        <i class="far fa-copy"></i> Copy Address
                    </button>
                    <button class="btn btn-outline" onclick="refreshWallet()">
                        <i class="fas fa-sync-alt"></i> Refresh Balance
                    </button>
                </div>
            }
        </div>

        <!-- Profile Card Section -->
        <div class="profile-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    <img src="https://ui-avatars.com/api/?background=2563EB&color=fff&name=@Uri.EscapeDataString(Model.Member.Surname + "+" + Model.Member.OtherNames)" alt="Profile">
                    <div class="avatar-edit">
                        <i class="fas fa-camera"></i>
                    </div>
                </div>
                <div class="profile-name">
                    <h3>@Model.Member.Surname @Model.Member.OtherNames</h3>
                    <p>Member since @Model.Member.ApplicDate?.ToString("MMM yyyy")</p>
                </div>
            </div>

            <div class="profile-info-grid">
                <div class="info-field">
                    <label>Email Address</label>
                    <div class="value">@(string.IsNullOrEmpty(Model.Member.Email) ? "Not provided" : Model.Member.Email)</div>
                </div>
                <div class="info-field">
                    <label>Phone Number</label>
                    <div class="value">@(string.IsNullOrEmpty(Model.Member.PhoneNo) ? "Not provided" : Model.Member.PhoneNo)</div>
                </div>
                <div class="info-field">
                    <label>ID Number</label>
                    <div class="value">@(string.IsNullOrEmpty(Model.Member.Idno) ? "Not provided" : Model.Member.Idno)</div>
                </div>
                <div class="info-field">
                    <label>Member Number</label>
                    <div class="value">@Model.Member.MemberNo</div>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/MemberMvc/MyProfile" class="btn btn-primary">
                    <i class="fas fa-user-edit"></i> Edit Profile
                </a>
                <button class="btn btn-outline" onclick="refreshWallet()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Balance Details Section -->
    <div class="wallet-grid" style="margin-top: 0;">
        <div class="balance-card">
            <div class="balance-icon deposit">
                <i class="fas fa-piggy-bank"></i>
            </div>
            <div class="balance-info">
                <h4>Deposit Balance</h4>
                <div class="amount">KES @Model.Wallets.FirstOrDefault()?.DepositBalance.ToString("N2")</div>
            </div>
        </div>
        <div class="balance-card">
            <div class="balance-icon capital">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="balance-info">
                <h4>Capital Balance</h4>
                <div class="amount">KES @Model.Wallets.FirstOrDefault()?.CapitalBalance.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Transactions Section -->
    <div class="transactions-card">
        <div class="section-title">
            <span><i class="fas fa-history"></i> Recent Transactions</span>
            <span class="transaction-count" style="font-size: 0.875rem; color: var(--gray-500);">
                Last @Model.MemberTransactions.Count() transactions
            </span>
        </div>

        @if (Model.MemberTransactions != null && Model.MemberTransactions.Any())
        {
            <div class="transaction-list">
                @foreach (var trans in Model.MemberTransactions.Take(20))
                {
                    <div class="transaction-item">
                        <div class="transaction-icon @(trans.TransactionType?.ToLower().Contains("deposit") == true ? "deposit" :
                                                                                   trans.TransactionType?.ToLower().Contains("withdrawal") == true ? "withdrawal" : "payment")">
                    @if (trans.TransactionType?.ToLower().Contains("deposit") == true)
                            {
                                <i class="fas fa-arrow-down"></i>
                            }
                            else if (trans.TransactionType?.ToLower().Contains("withdrawal") == true)
                            {
                                <i class="fas fa-arrow-up"></i>
                            }
                            else
                            {
                                <i class="fas fa-exchange-alt"></i>
                            }
                        </div>
                        <div class="transaction-details">
                            <h4>@trans.TransactionType</h4>
                            <div class="meta">
                                <span><i class="fas fa-hashtag"></i> @(trans.TransactionId?.Length > 20 ? trans.TransactionId.Substring(0, 20) + "..." : trans.TransactionId)</span>
                                <span><i class="fas fa-check-circle"></i> @trans.Status</span>
                            </div>
                        </div>
                        <div class="transaction-amount">
                            <div class="amount @(trans.Amount > 0 ? "amount-positive" : "amount-negative")">
                                @(trans.Amount > 0 ? "+" : "") KES @Math.Abs(trans.Amount).ToString("N2")
                            </div>
                            <div class="date">
                                <i class="far fa-calendar-alt"></i> @trans.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-receipt"></i>
                <p>No transactions found</p>
                <small>Your recent transactions will appear here</small>
            </div>
        }
    </div>
</div>

<script>
    // Copy to clipboard function
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            showToast('Address copied to clipboard!');
        }, function(err) {
            console.error('Could not copy text: ', err);
        });
    }

    // Show toast notification
    function showToast(message) {
        // Remove existing toast
        const existingToast = document.querySelector('.toast-notification');
        if (existingToast) {
            existingToast.remove();
        }

        // Create new toast
        const toast = document.createElement('div');
        toast.className = 'toast-notification';
        toast.innerHTML = `<i class="fas fa-check-circle"></i> ${message}`;
        document.body.appendChild(toast);

        // Remove after 3 seconds
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Refresh wallet data
    function refreshWallet() {
        showToast('Refreshing wallet data...');
        setTimeout(() => {
            location.reload();
        }, 500);
    }

    // Auto-refresh every 60 seconds (optional)
    let autoRefreshInterval;

    function startAutoRefresh() {
        if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        autoRefreshInterval = setInterval(() => {
            // Only refresh if page is visible
            if (!document.hidden) {
                refreshWallet();
            }
        }, 60000); // Refresh every 60 seconds
    }

    // Start auto-refresh when page loads
    document.addEventListener('DOMContentLoaded', function() {
        startAutoRefresh();
    });

    // Stop auto-refresh when page is hidden to save resources
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        } else {
            startAutoRefresh();
        }
    });
</script>