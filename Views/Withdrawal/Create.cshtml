@model SACCOBlockChainSystem.Models.DTOs.MemberWithdrawalDTO
@{
    ViewData["Title"] = "New Withdrawal Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var member = ViewBag.Member as SACCOBlockChainSystem.Models.Member;
    var calculation = ViewBag.Calculation as SACCOBlockChainSystem.Models.DTOs.WithdrawalCalculationDTO;
    var memberNo = ViewBag.MemberNo as string;
    var memberName = ViewBag.MemberName as string;
    var noticeDays = ViewBag.NoticeDays as int? ?? 30;
    var hasMember = member != null;
}

<style>
    .search-results-table tbody tr {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .search-results-table tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

    .selected-member-card {
        border-left: 4px solid #28a745;
    }

    .btn-select-member {
        min-width: 80px;
    }

    .calculation-summary {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 8px;
        padding: 15px;
    }

    .net-payable {
        font-size: 1.5rem;
        font-weight: bold;
        color: #28a745;
    }

    .withdrawal-warning {
        border-left: 4px solid #ffc107;
    }

    .file-upload-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .file-upload-wrapper input[type=file] {
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    .uploaded-file {
        background-color: #f8f9fa;
        border-radius: 4px;
        padding: 10px;
        border-left: 4px solid #28a745;
    }

    .file-preview {
        max-width: 100%;
        max-height: 200px;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 5px;
    }

    .file-name {
        font-weight: 500;
        word-break: break-all;
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
                <h2 class="page-title mb-0">
                    <i class="bi bi-person-x me-2"></i>New Withdrawal Request
                </h2>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Member Search Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-search me-2"></i>Step 1: Search & Select Member
            </h5>
        </div>
        <div class="card-body">
            <!-- Search Input -->
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="fw-bold">Search Member</label>
                        <div class="input-group">
                            <input type="text" id="searchInput" class="form-control form-control-lg"
                                   placeholder="Search by Member Number, Name, ID Number, or Phone Number..." />
                            <button type="button" class="btn btn-primary" onclick="searchMembers()">
                                <i class="bi bi-search"></i> Search
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="clearSearch()">
                                <i class="bi bi-x-lg"></i> Clear
                            </button>
                        </div>
                        <small class="text-muted">Enter at least 3 characters then click Search or press Enter</small>
                    </div>
                </div>
            </div>

            <!-- Search Results -->
            <div id="searchResults" style="display: none;">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover search-results-table">
                        <thead class="table-light">
                            <tr>
                                <th>Select</th>
                                <th>Member No</th>
                                <th>Full Name</th>
                                <th>ID Number</th>
                                <th>Phone Number</th>
                                <th>Email</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="searchResultsBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Loading Indicator -->
            <div id="searchLoading" style="display: none;" class="text-center p-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Searching for members...</p>
            </div>

            <!-- Selected Member Display -->
            <div id="selectedMemberCard" style="display: @(hasMember ? "block" : "none");" class="mt-3">
                <div class="alert alert-success selected-member-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            <strong>Selected Member:</strong>
                            <span id="selectedMemberName">@(hasMember? memberName : "")</span>
                            <br />
                            <small>
                                <span id="selectedMemberNoDisplay">@(hasMember? memberNo : "")</span> |
                                ID: <span id="selectedMemberIdNo">@(hasMember? member?.Idno : "N/A")</span> |
                                Phone: <span id="selectedMemberPhone">@(hasMember? member?.PhoneNo : "N/A")</span>
                            </small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearSelectedMember()">
                                <i class="bi bi-arrow-left"></i> Change
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="selectedMemberNo" name="memberNo" value="@(hasMember? memberNo : "")" />
        </div>
    </div>

    @if (hasMember)
    {
        <div class="row">
            <!-- Left Column - Member Summary -->
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-person-badge me-2"></i>Member Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted">Member Number:</label>
                            <p class="fw-bold mb-0">@memberNo</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Full Name:</label>
                            <p class="fw-bold mb-0">@memberName</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">ID Number:</label>
                            <p class="mb-0">@member?.Idno</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Phone:</label>
                            <p class="mb-0">@member?.PhoneNo</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Email:</label>
                            <p class="mb-0">@member?.Email</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Date Joined:</label>
                            <p class="mb-0">@(member?.ApplicDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Membership Type:</label>
                            <p class="mb-0">@(member?.MembershipType ?? "N/A")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Department:</label>
                            <p class="mb-0">@(member?.Dept ?? "N/A")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Station:</label>
                            <p class="mb-0">@(member?.Station ?? "N/A")</p>
                        </div>
                        @if (member?.ApplicDate.HasValue == true)
                        {
                            var membershipMonths = (DateTime.Now - member.ApplicDate.Value).TotalDays / 30;
                            var noticeDate = member.ApplicDate.Value.AddDays(noticeDays);
                            var isNoticeServed = DateTime.Now >= noticeDate;
                            <div class="alert @(isNoticeServed ? "alert-success" : "alert-warning") mt-2">
                                <i class="bi @(isNoticeServed ? "bi-check-circle" : "bi-clock-history") me-2"></i>
                                <small>
                                    <strong>Membership Duration:</strong> @Math.Floor(membershipMonths) months<br />
                                    <strong>Notice Period Ends:</strong> @noticeDate.ToString("dd/MM/yyyy")<br />
                                    <strong>Notice Status:</strong> @(isNoticeServed ? "Served ✓" : "Pending - " + (noticeDate - DateTime.Now).Days + " days remaining")
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-calculator me-2"></i>Withdrawal Calculation
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="calculation-summary">
                            <div class="mb-3">
                                <label class="text-muted">Total Shares Value:</label>
                                <p class="fw-bold mb-0 text-primary">KES @calculation?.TotalSharesValue.ToString("N2")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Total Deposits:</label>
                                <p class="fw-bold mb-0 text-primary">KES @calculation?.TotalDeposits.ToString("N2")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted text-danger">Outstanding Loans:</label>
                                <p class="fw-bold mb-0 text-danger">KES @calculation?.OutstandingLoans.ToString("N2")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Penalties/Deductions:</label>
                                <p class="fw-bold mb-0 text-danger">KES @calculation?.PenaltiesAndDeductions.ToString("N2")</p>
                            </div>
                            <hr />
                            <div class="mb-3">
                                <label class="fw-bold">Net Payable Amount:</label>
                                <p class="net-payable mb-0">KES @calculation?.NetPayableAmount.ToString("N2")</p>
                            </div>
                        </div>
                        @if (!calculation.IsEligibleForWithdrawal)
                        {
                            <div class="alert alert-warning withdrawal-warning mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @calculation.EligibilityMessage
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column - Withdrawal Form -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-pencil-square me-2"></i>Withdrawal Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" enctype="multipart/form-data" id="withdrawalForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="memberNo" id="memberNoField" value="@memberNo" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: none;"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="WithdrawalType" class="form-label fw-bold">Withdrawal Type *</label>
                                    <select asp-for="WithdrawalType" class="form-select" required>
                                        <option value="Voluntary">Voluntary</option>
                                        <option value="Retirement">Retirement</option>
                                        <option value="Transfer">Transfer to Another SACCO</option>
                                    </select>
                                    <span asp-validation-for="WithdrawalType" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="WithdrawalDate" class="form-label fw-bold">Withdrawal Date *</label>
                                    <input asp-for="WithdrawalDate" type="date" class="form-control" required
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="WithdrawalDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label asp-for="PaymentMethod" class="form-label fw-bold">Payment Method</label>
                                    <select asp-for="PaymentMethod" class="form-select" id="paymentMethod">
                                        <option value="">-- Select Payment Method --</option>
                                        <option value="Bank Transfer">Bank Transfer</option>
                                        <option value="Cheque">Cheque</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Mobile Money">Mobile Money</option>
                                    </select>
                                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Bank Transfer Details -->
                            <div id="bankDetails" style="display: none;">
                                <div class="card bg-light mb-3">
                                    <div class="card-header">
                                        <i class="bi bi-building me-2"></i>Bank Transfer Details
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="BankName" class="form-label">Bank Name</label>
                                                <input asp-for="BankName" class="form-control" />
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="BankAccountNo" class="form-label">Account Number</label>
                                                <input asp-for="BankAccountNo" class="form-control" />
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label asp-for="AccountName" class="form-label">Account Name</label>
                                                <input asp-for="AccountName" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cheque Details -->
                            <div id="chequeDetails" style="display: none;">
                                <div class="card bg-light mb-3">
                                    <div class="card-header">
                                        <i class="bi bi-journal me-2"></i>Cheque Details
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label asp-for="ChequeNo" class="form-label">Cheque Number</label>
                                                <input asp-for="ChequeNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Money Details -->
                            <div id="mobileDetails" style="display: none;">
                                <div class="card bg-light mb-3">
                                    <div class="card-header">
                                        <i class="bi bi-phone me-2"></i>Mobile Money Details
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label asp-for="MobileNo" class="form-label">Mobile Number</label>
                                                <input asp-for="MobileNo" class="form-control" placeholder="0712345678" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label asp-for="Remarks" class="form-label">Remarks</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Any additional information..."></textarea>
                                    <span asp-validation-for="Remarks" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Document Upload Section -->
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">Supporting Documents</label>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Application Letter</label>
                                                    <div class="file-upload-wrapper">
                                                        <input type="file" id="applicationLetterUpload" name="applicationLetterUpload" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                                                        <span class="text-muted small">PDF, DOC, DOCX, JPG, PNG (Max 5MB)</span>
                                                    </div>
                                                    <div id="applicationLetterPreview" class="mt-2" style="display: none;">
                                                        <div class="uploaded-file">
                                                            <i class="bi bi-file-pdf text-danger me-2"></i>
                                                            <span id="applicationLetterName" class="file-name"></span>
                                                            <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="clearFile('applicationLetter')">
                                                                <i class="bi bi-x-circle"></i> Remove
                                                            </button>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(Model.DocumentPath))
                                                    {
                                                        <div class="mt-2">
                                                            <small class="text-muted">Current file: <a href="#" target="_blank">@System.IO.Path.GetFileName(Model.DocumentPath)</a></small>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">ID Copy</label>
                                                    <div class="file-upload-wrapper">
                                                        <input type="file" id="idCopyUpload" name="idCopyUpload" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                                                        <span class="text-muted small">PDF, JPG, PNG (Max 5MB)</span>
                                                    </div>
                                                    <div id="idCopyPreview" class="mt-2" style="display: none;">
                                                        <div class="uploaded-file">
                                                            <i class="bi bi-file-image text-primary me-2"></i>
                                                            <span id="idCopyName" class="file-name"></span>
                                                            <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="clearFile('idCopy')">
                                                                <i class="bi bi-x-circle"></i> Remove
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 mb-3">
                                                    <label class="form-label">Other Supporting Documents</label>
                                                    <div class="file-upload-wrapper">
                                                        <input type="file" id="otherDocumentsUpload" name="otherDocumentsUpload" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" multiple />
                                                        <span class="text-muted small">PDF, DOC, DOCX, JPG, PNG (Max 5MB each, multiple files allowed)</span>
                                                    </div>
                                                    <div id="otherDocumentsPreview" class="mt-2" style="display: none;">
                                                        <div class="uploaded-file">
                                                            <i class="bi bi-files text-success me-2"></i>
                                                            <span id="otherDocumentsCount" class="file-name">0 file(s) selected</span>
                                                            <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="clearFile('otherDocuments')">
                                                                <i class="bi bi-x-circle"></i> Clear All
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <small class="text-muted">Upload all required supporting documents for the withdrawal request</small>
                                </div>
                            </div>

                            <div class="alert alert-warning mt-3">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                <strong>Important Information:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Withdrawal requires <strong>@noticeDays days notice</strong> from the date of joining</li>
                                    <li>All outstanding loans must be cleared before withdrawal</li>
                                    <li>Processing may take up to 30 days after approval</li>
                                    <li>Withdrawal amount is subject to verification and approval</li>
                                    <li>Once processed, membership will be terminated</li>
                                </ul>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary" @(!calculation.IsEligibleForWithdrawal ? "disabled" : "") id="submitBtn">
                                    <i class="bi bi-send me-2"></i>Submit Withdrawal Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">Search for a Member</h4>
                <p class="text-muted">Use the search above to find a member and start the withdrawal process</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let selectedMemberData = null;
        let isMemberSelected = @(hasMember ? "true" : "false");
        let isLoading = false;
        let isSelectionInProgress = false;
        let hasShownSuccess = false;

        // File upload handling
        const maxFileSize = 5 * 1024 * 1024; // 5MB
        const allowedExtensions = ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png'];

        function validateFile(file) {
            const extension = file.name.split('.').pop().toLowerCase();
            if (!allowedExtensions.includes(extension)) {
                alert(`File type ${extension} is not allowed. Allowed types: ${allowedExtensions.join(', ')}`);
                return false;
            }
            if (file.size > maxFileSize) {
                alert(`File size ${(file.size / 1024 / 1024).toFixed(2)}MB exceeds the maximum allowed size of 5MB.`);
                return false;
            }
            return true;
        }

        function handleFileUpload(inputId, previewId, nameId, fieldName) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            const nameDisplay = document.getElementById(nameId);

            if (!input || !preview || !nameDisplay) return;

            input.addEventListener('change', function(e) {
                const files = this.files;
                if (!files || files.length === 0) {
                    preview.style.display = 'none';
                    return;
                }

                // Validate each file
                let allValid = true;
                for (let i = 0; i < files.length; i++) {
                    if (!validateFile(files[i])) {
                        allValid = false;
                        break;
                    }
                }

                if (!allValid) {
                    this.value = '';
                    preview.style.display = 'none';
                    return;
                }

                // Handle multiple files
                if (fieldName === 'otherDocuments') {
                    nameDisplay.textContent = files.length + ' file(s) selected';
                    // Store file list for processing
                    if (window.otherDocumentsFiles === undefined) {
                        window.otherDocumentsFiles = [];
                    }
                    window.otherDocumentsFiles = Array.from(files);
                } else {
                    nameDisplay.textContent = files[0].name;
                }

                preview.style.display = 'block';
            });
        }

        function clearFile(fieldName) {
            if (fieldName === 'applicationLetter') {
                document.getElementById('applicationLetterUpload').value = '';
                document.getElementById('applicationLetterPreview').style.display = 'none';
                document.getElementById('applicationLetterName').textContent = '';
            } else if (fieldName === 'idCopy') {
                document.getElementById('idCopyUpload').value = '';
                document.getElementById('idCopyPreview').style.display = 'none';
                document.getElementById('idCopyName').textContent = '';
            } else if (fieldName === 'otherDocuments') {
                document.getElementById('otherDocumentsUpload').value = '';
                document.getElementById('otherDocumentsPreview').style.display = 'none';
                document.getElementById('otherDocumentsCount').textContent = '0 file(s) selected';
                window.otherDocumentsFiles = [];
            }
        }

        $(document).ready(function() {
            // Initialize file upload handlers
            handleFileUpload('applicationLetterUpload', 'applicationLetterPreview', 'applicationLetterName', 'applicationLetter');
            handleFileUpload('idCopyUpload', 'idCopyPreview', 'idCopyName', 'idCopy');
            handleFileUpload('otherDocumentsUpload', 'otherDocumentsPreview', 'otherDocumentsCount', 'otherDocuments');

            // Search input enter key - NO AUTO-SEARCH ON INPUT
            $('#searchInput').on('keypress', function(e) {
                if (e.key === 'Enter') {
                    searchMembers();
                }
            });

            // Payment method toggle
            $('#paymentMethod').on('change', function() {
                var method = $(this).val();
                $('#bankDetails, #chequeDetails, #mobileDetails').hide();

                if (method === 'Bank Transfer') {
                    $('#bankDetails').show();
                } else if (method === 'Cheque') {
                    $('#chequeDetails').show();
                } else if (method === 'Mobile Money') {
                    $('#mobileDetails').show();
                }
            });

            // Form submission with loading state
            $('#withdrawalForm').on('submit', function(e) {
                var submitBtn = $('#submitBtn');
                submitBtn.prop('disabled', true);
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...');

                // Validate that at least one file is uploaded (optional)
                // Uncomment if you want to require documents
                // var hasFiles = false;
                // if (document.getElementById('applicationLetterUpload').files.length > 0 ||
                //     document.getElementById('idCopyUpload').files.length > 0 ||
                //     document.getElementById('otherDocumentsUpload').files.length > 0) {
                //     hasFiles = true;
                // }
                // if (!hasFiles) {
                //     e.preventDefault();
                //     Swal.fire('Warning', 'Please upload at least one supporting document.', 'warning');
                //     submitBtn.prop('disabled', false);
                //     submitBtn.html('<i class="bi bi-send me-2"></i>Submit Withdrawal Request');
                //     return false;
                // }

                return true;
            });

            // Withdrawal date validation
            var today = new Date().toISOString().split('T')[0];
            $('#WithdrawalDate').attr('min', today);

            @if (!string.IsNullOrEmpty(Context.Request.Query["memberNo"]))
            {
                    <text>
                    const preSelectedMember = '@Context.Request.Query["memberNo"]';
                    if (preSelectedMember && !isMemberSelected) {
                        $('#selectedMemberNo').val(preSelectedMember);
                        loadMemberDetailsSilently(preSelectedMember);
                    }
                    </text>
            }
        });

        // Load member details silently (no popup)
        async function loadMemberDetailsSilently(memberNo) {
            try {
                const response = await fetch(`/api/Member/${memberNo}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        selectedMemberData = data.data;
                        isMemberSelected = true;
                        hasShownSuccess = true;

                        const fullName = (data.data.surname || '') + ' ' + (data.data.otherNames || '');
                        $('#selectedMemberName').html(`<strong>${escapeHtml(fullName.trim() || memberNo)}</strong>`);
                        $('#selectedMemberNoDisplay').html(memberNo);
                        $('#selectedMemberIdNo').html(data.data.idno || 'N/A');
                        $('#selectedMemberPhone').html(data.data.phoneNo || 'N/A');
                        $('#selectedMemberCard').show();
                    }
                }
            } catch (error) {
                console.error('Error loading member details:', error);
            }
        }

        // Search members function
        async function searchMembers() {
            if (isLoading) return;

            const searchTerm = $('#searchInput').val().trim();
            if (searchTerm.length < 3) {
                Swal.fire('Warning', 'Please enter at least 3 characters to search', 'warning');
                return;
            }

            isLoading = true;
            $('#searchLoading').show();
            $('#searchResults').hide();
            $('#searchResultsBody').html('');

            try {
                const response = await fetch(`/api/Member/search?searchTerm=${encodeURIComponent(searchTerm)}`);

                if (!response.ok) {
                    const errorData = await response.json();
                    $('#searchResultsBody').html(`<tr><td colspan="7" class="text-center text-danger">Error: ${errorData.message || 'Error searching members'}</td></tr>`);
                    $('#searchResults').show();
                    isLoading = false;
                    $('#searchLoading').hide();
                    return;
                }

                const data = await response.json();

                if (data.success && data.data && data.data.length > 0) {
                    displaySearchResults(data.data);
                } else {
                    $('#searchResultsBody').html('<tr><td colspan="7" class="text-center text-warning">No members found matching your search</td></tr>');
                    $('#searchResults').show();
                }
            } catch (error) {
                console.error('Error:', error);
                $('#searchResultsBody').html(`<tr><td colspan="7" class="text-center text-danger">Error searching members: ${error.message}</td></tr>`);
                $('#searchResults').show();
            } finally {
                isLoading = false;
                $('#searchLoading').hide();
            }
        }

        // Display search results
        function displaySearchResults(members) {
            const tbody = $('#searchResultsBody');
            tbody.empty();

            members.forEach(member => {
                const statusBadge = member.status == 1 ?
                    '<span class="badge bg-success">Active</span>' :
                    '<span class="badge bg-danger">Inactive</span>';

                const fullName = (member.surname || '') + ' ' + (member.otherNames || '');
                const phone = member.phoneNo || 'N/A';

                const row = `
                    <tr>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-success" onclick="selectMember('${member.memberNo}')">
                                <i class="bi bi-check-lg"></i> Select
                            </button>
                        </td>
                        <td><strong>${escapeHtml(member.memberNo)}</strong></td>
                        <td>${escapeHtml(fullName.trim() || member.memberNo)}</td>
                        <td>${escapeHtml(member.idno || 'N/A')}</td>
                        <td>${escapeHtml(phone)}</td>
                        <td>${escapeHtml(member.email || 'N/A')}</td>
                        <td>${statusBadge}</td>
                    </tr>
                `;
                tbody.append(row);
            });

            $('#searchResults').show();
        }

        // Select a member
        async function selectMember(memberNo) {
            if (isLoading || isSelectionInProgress) return;
            if (isMemberSelected && memberNo === selectedMemberData?.memberNo) return;

            isSelectionInProgress = true;
            isLoading = true;

            try {
                const response = await fetch(`/api/Member/${memberNo}`);

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('API Error:', response.status, errorText);
                    Swal.fire('Error', `Failed to fetch member details: ${response.status}`, 'error');
                    isSelectionInProgress = false;
                    isLoading = false;
                    return;
                }

                const data = await response.json();

                if (data.success && data.data) {
                    selectedMemberData = data.data;
                    isMemberSelected = true;
                    hasShownSuccess = true;

                    $('#selectedMemberNo').val(memberNo);

                    const fullName = (selectedMemberData.surname || '') + ' ' + (selectedMemberData.otherNames || '');
                    $('#selectedMemberName').html(`<strong>${escapeHtml(fullName.trim() || memberNo)}</strong>`);
                    $('#selectedMemberNoDisplay').html(memberNo);
                    $('#selectedMemberIdNo').html(selectedMemberData.idno || 'N/A');
                    $('#selectedMemberPhone').html(selectedMemberData.phoneNo || 'N/A');

                    $('#selectedMemberCard').show();
                    $('#searchResults').hide();
                    $('#searchInput').val('');

                    await Swal.fire({
                        icon: 'success',
                        title: 'Member Selected!',
                        text: `Member ${fullName.trim() || memberNo} selected successfully.`,
                        timer: 1500,
                        showConfirmButton: true,
                        confirmButtonText: 'OK'
                    });

                    window.location.href = `/Withdrawal/Create?memberNo=${encodeURIComponent(memberNo)}`;
                } else {
                    Swal.fire('Error', data.message || 'Failed to load member details', 'error');
                }
            } catch (error) {
                console.error('Error selecting member:', error);
                Swal.fire('Error', 'Error selecting member: ' + error.message, 'error');
            } finally {
                isSelectionInProgress = false;
                isLoading = false;
            }
        }

        // Clear selected member
        function clearSelectedMember() {
            selectedMemberData = null;
            isMemberSelected = false;
            hasShownSuccess = false;

            $('#selectedMemberNo').val('');
            $('#selectedMemberCard').hide();
            window.location.href = '/Withdrawal/Create';
        }

        // Clear search
        function clearSearch() {
            $('#searchInput').val('');
            $('#searchResults').hide();
            $('#searchResultsBody').empty();
            if (!isMemberSelected) {
                clearSelectedMember();
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}