@model SACCOBlockChainSystem.Models.DTOs.GuarantorResponseDTO
@{
    ViewData["Title"] = "Guarantor Response";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loanDetails = ViewBag.LoanDetails as dynamic;
    var eligibleAmount = ViewBag.EligibleAmount as decimal? ?? 0;
    var currentGuarantees = ViewBag.CurrentGuarantees as decimal? ?? 0;
    var maxGuarantee = ViewBag.MaxGuarantee as decimal? ?? 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0"><i class="fas fa-handshake"></i> Loan Guarantor Request</h4>
                </div>
                <div class="card-body">
                    <!-- Loan Details -->
                    <div class="alert alert-info">
                        <h6 class="mb-2">Loan Details</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <small>Loan Number:</small>
                                <strong>@loanDetails?.LoanNo</strong>
                            </div>
                            <div class="col-md-6">
                                <small>Applicant:</small>
                                <strong>@loanDetails?.ApplicantName</strong>
                            </div>
                            <div class="col-md-6">
                                <small>Loan Amount:</small>
                                <strong class="text-primary">KES @(loanDetails?.LoanAmount?.ToString("N0") ?? "0")</strong>
                            </div>
                            <div class="col-md-6">
                                <small>Application Date:</small>
                                <strong>@(loanDetails?.ApplicationDate?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Your Eligibility -->
                    <div class="alert alert-success">
                        <h6 class="mb-2">Your Eligibility</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <small>Your Available Deposits:</small>
                                <strong>KES @eligibleAmount.ToString("N0")</strong>
                            </div>
                            <div class="col-md-6">
                                <small>Current Guarantees:</small>
                                <strong>KES @currentGuarantees.ToString("N0")</strong>
                            </div>
                            <div class="col-md-6">
                                <small>Maximum You Can Guarantee:</small>
                                <strong class="text-success">KES @maxGuarantee.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Response Form -->
                    <form id="responseForm" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="loanNo" value="@Model.LoanNo" />
                        <input type="hidden" name="guarantorMemberNo" value="@Model.GuarantorMemberNo" />
                        <input type="hidden" name="invitationToken" value="@ViewBag.Token" />

                        <div class="mb-3">
                            <label class="form-label">Guarantee Amount (KES)</label>
                            <input type="number" id="guaranteeAmount" name="guaranteeAmount" class="form-control form-control-lg"
                                   min="1000" max="@maxGuarantee" step="1000" required />
                            <small class="text-muted">Enter the amount you wish to guarantee (Min: 1,000 | Max: @maxGuarantee.ToString("N0"))</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Remarks (Optional)</label>
                            <textarea name="remarks" class="form-control" rows="3" placeholder="Any additional comments..."></textarea>
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Important:</strong> By accepting this guarantee, you agree that your deposits/shares
                            will be locked for the duration of this loan. If the borrower defaults, you will be responsible
                            for repaying the guaranteed amount.
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" name="action" value="accept" class="btn btn-success btn-lg flex-grow-1">
                                <i class="fas fa-check-circle"></i> Accept & Guarantee
                            </button>
                            <button type="submit" name="action" value="reject" class="btn btn-danger btn-lg flex-grow-1">
                                <i class="fas fa-times-circle"></i> Reject
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $('#responseForm').on('submit', function(e) {
            const action = $('button[type=submit][clicked=true]').val();
            const amount = $('#guaranteeAmount').val();

            if (action === 'accept') {
                if (!amount || parseFloat(amount) < 1000) {
                    e.preventDefault();
                    Swal.fire('Error', 'Please enter a valid guarantee amount (minimum KES 1,000)', 'error');
                    return false;
                }

                Swal.fire({
                    title: 'Confirm Guarantee',
                    html: `You are about to guarantee <strong>KES ${parseFloat(amount).toLocaleString()}</strong> for this loan.<br><br>
                           This amount will be locked from your savings/deposits until the loan is fully repaid.<br><br>
                           <strong>Do you confirm?</strong>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    confirmButtonText: 'Yes, I Confirm',
                    cancelButtonText: 'No, Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#responseForm').submit();
                    }
                });
                return false;
            } else if (action === 'reject') {
                Swal.fire({
                    title: 'Reject Guarantee?',
                    text: 'Are you sure you want to reject this guarantee request?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    confirmButtonText: 'Yes, Reject',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#responseForm').submit();
                    }
                });
                return false;
            }
        });

        $('button[type=submit]').on('click', function() {
            $('button[type=submit]').removeAttr('clicked');
            $(this).attr('clicked', 'true');
        });
    </script>
}