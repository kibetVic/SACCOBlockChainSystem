@model SACCOBlockChainSystem.Models.Loan
@{
    ViewData["Title"] = "Loan Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var loanType = ViewBag.LoanType as SACCOBlockChainSystem.Models.Loantype;
    var loanBalance = ViewBag.LoanBalance as SACCOBlockChainSystem.Models.Loanbal;
    var schedule = ViewBag.Schedule as List<SACCOBlockChainSystem.Models.LoanSchedule> ?? new List<SACCOBlockChainSystem.Models.LoanSchedule>();
    var repayments = ViewBag.Repayments as List<SACCOBlockChainSystem.Models.Repay> ?? new List<SACCOBlockChainSystem.Models.Repay>();
    var guarantors = ViewBag.Guarantors as List<dynamic> ?? new List<dynamic>();
    var canRepay = ViewBag.CanRepay ?? false;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0"><i class="fas fa-file-invoice text-primary"></i> Loan Details</h2>
            <p class="text-muted">Loan Number: <strong>@Model.LoanNo</strong></p>
        </div>
        <div>
            <a asp-action="MyLoans" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to My Loans
            </a>
            @if (canRepay)
            {
                <a asp-controller="LoanMvc" asp-action="Repay" asp-route-loanNo="@Model.LoanNo" class="btn btn-success ms-2">
                    <i class="fas fa-money-bill-wave"></i> Make Payment
                </a>
            }
        </div>
    </div>

    <!-- Loan Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small>Principal Amount</small>
                            <h3 class="mb-0">KES @(Model.LoanAmt?.ToString("N0") ?? "0")</h3>
                        </div>
                        <i class="fas fa-money-bill fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small>Outstanding Balance</small>
                            <h3 class="mb-0">KES @(loanBalance?.Balance.ToString("N0") ?? "0")</h3>
                        </div>
                        <i class="fas fa-chart-line fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small>Monthly Payment</small>
                            <h3 class="mb-0">KES @(loanBalance?.RepayRate.ToString("N0") ?? "0")</h3>
                        </div>
                        <i class="fas fa-calendar-alt fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small>Next Due Date</small>
                            <h6 class="mb-0">@(loanBalance?.Nextduedate?.ToString("dd/MM/yyyy") ?? "N/A")</h6>
                        </div>
                        <i class="fas fa-clock fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Loan Information -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="fas fa-info-circle"></i> Loan Information</h6>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <th width="40%">Loan Type:</th>
                            <td>@(loanType?.LoanType1 ?? Model.LoanCode)</td>
                        </tr>
                        <tr>
                            <th>Interest Rate:</th>
                            <td>@Model.Interest%</td>
                        </tr>
                        <tr>
                            <th>Repayment Period:</th>
                            <td>@Model.RepayPeriod months</td>
                        </tr>
                        <tr>
                            <th>Repayment Method:</th>
                            <td>@(Model.RepayMethod == "AMT" ? "Equal Installments" : Model.RepayMethod == "STL" ? "Straight Line" : "Reducing Balance")</td>
                        </tr>
                        <tr>
                            <th>Application Date:</th>
                            <td>@Model.ApplicDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Disbursement Date:</th>
                            <td>@(Model.AuditDateTime?.ToString("dd/MM/yyyy") ?? "Not Disbursed")</td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td>
                                <span class="loan-status status-@Model.Status">@(((SACCOBlockChainSystem.Models.Status)(Model.Status ?? 0)).ToString())</span>
                            </td>
                        </tr>
                        <tr>
                            <th>Purpose:</th>
                            <td>@Model.Purpose</td>
                        </tr>
                        <tr>
                            <th>Remarks:</th>
                            <td>@(Model.AddSecurity ?? "None")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Guarantors -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-handshake"></i> Guarantors</h6>
                </div>
                <div class="card-body">
                    @if (!guarantors.Any())
                    {
                        <p class="text-muted mb-0">No guarantors assigned for this loan.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Member No</th>
                                        <th>Name</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var guarantor in guarantors)
                                    {
                                        <tr>
                                            <td>@guarantor.MemberNo</td>
                                            <td>@guarantor.FullName</td>
                                            <td>KES @(guarantor.Amount?.ToString("N0") ?? "0")</td>
                                            <td>
                                                @if (guarantor.Transfered == false)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Released</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Schedule -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="fas fa-calendar-alt"></i> Payment Schedule</h6>
                </div>
                <div class="card-body">
                    @if (!schedule.Any())
                    {
                        <p class="text-muted mb-0">Payment schedule will be generated after loan disbursement.</p>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Due Date</th>
                                        <th>Principal</th>
                                        <th>Interest</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inst in schedule.Take(12))
                                    {
                                        <tr class="@(inst.Status == "Overdue" ? "table-danger" : inst.Status == "Paid" ? "table-success" : "")">
                                            <td>@inst.InstallmentNo</td>
                                            <td>@inst.DueDate.ToString("dd/MM/yyyy")</td>
                                            <td>KES @inst.PrincipalAmount.ToString("N0")</td>
                                            <td>KES @inst.InterestAmount.ToString("N0")</td>
                                            <td>KES @inst.TotalInstallment.ToString("N0")</td>
                                            <td>
                                                @if (inst.Status == "Paid")
                                                {
                                                    <span class="badge bg-success">Paid</span>
                                                }
                                                else if (inst.Status == "Overdue")
                                                {
                                                    <span class="badge bg-danger">Overdue</span>
                                                }
                                                else if (inst.Status == "Partial")
                                                {
                                                    <span class="badge bg-warning">Partial</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (schedule.Count > 12)
                            {
                                <p class="text-muted small mt-2">Showing first 12 of @schedule.Count installments</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Repayment History -->
    @if (repayments.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fas fa-history"></i> Repayment History</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Receipt No</th>
                                <th>Amount</th>
                                <th>Principal</th>
                                <th>Interest</th>
                                <th>Penalty</th>
                                <th>Balance After</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var repayment in repayments)
                            {
                                <tr>
                                    <td>@repayment.DateReceived?.ToString("dd/MM/yyyy")</td>
                                    <td>@repayment.ReceiptNo</td>
                                    <td class="text-success">KES @(repayment.Amount?.ToString("N0") ?? "0")</td>
                                    <td>KES @(repayment.Principal?.ToString("N0") ?? "0")</td>
                                    <td>KES @(repayment.Interest?.ToString("N0") ?? "0")</td>
                                    <td>KES @(repayment.Penalty?.ToString("N0") ?? "0")</td>
                                    <td>KES @(repayment.LoanBalance?.ToString("N0") ?? "0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="2">Total:</td>
                                <td>KES @repayments.Sum(r => r.Amount ?? 0).ToString("N0")</td>
                                <td>KES @repayments.Sum(r => r.Principal ?? 0).ToString("N0")</td>
                                <td>KES @repayments.Sum(r => r.Interest ?? 0).ToString("N0")</td>
                                <td>KES @repayments.Sum(r => r.Penalty ?? 0).ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .loan-status {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-Draft {
        background: #fef3c7;
        color: #92400e;
    }

    .status-Submitted {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-UnderAppraisal {
        background: #fef3c7;
        color: #92400e;
    }

    .status-Approved {
        background: #d1fae5;
        color: #065f46;
    }

    .status-Endorsed {
        background: #d1fae5;
        color: #065f46;
    }

    .status-Disbursed {
        background: #d1fae5;
        color: #065f46;
    }

    .status-Closed {
        background: #e5e7eb;
        color: #374151;
    }

    .status-Rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .table-danger td {
        background-color: #fee2e2;
    }

    .table-success td {
        background-color: #d1fae5;
    }
</style>