@model IEnumerable<SACCOBlockChainSystem.Models.Contrib>

@{
    ViewData["Title"] = "Member Savings";
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h4>
                MEMBER SAVINGS
            </h4>

        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-6">

                    <h5>
                        Member No:
                        <strong>@ViewBag.MemberNo</strong>
                    </h5>

                </div>

                <div class="col-md-6 text-end">

                    <h5>
                        Total Savings:
                        <strong class="text-success">
                            KES @ViewBag.TotalSavings
                        </strong>
                    </h5>

                </div>

            </div>

            <table class="table table-bordered table-striped">

                <thead>

                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Blockchain</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @(item.ContrDate?.ToString("dd MMM yyyy"))
                            </td>

                            <td>
                                KES @(item.Amount ?? 0)
                            </td>

                            <td>
                                @item.Remarks
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(item.BlockchainTxId))
                                {
                                    <span class="badge bg-success">
                                        VERIFIED
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        PENDING
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>